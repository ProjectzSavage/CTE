<Item class="ServerScriptService" referent="RBX37">
<Properties>
	<string name="Name">ServerScriptService</string>
</Properties>
<Item class="ModuleScript" referent="RBX38">
<Properties>
	<string name="Name">AntiCheatService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	AntiCheatService (ServerScriptService.AntiCheatService)
	=======================================================
	Server-side cheat resistance. Two layers:

	1) ABILITY VALIDATION (already lives in CombatService, restated here):
	   every Request* remote handler ignores client arguments entirely and
	   re-checks context (egg possession), cooldown, stamina, stun and
	   server-computed ranges/targets. Client positions are NEVER trusted,
	   so impossible attack ranges cannot land: a punch only hits what the
	   SERVER sees inside Config.AttackRange of the SERVER's attacker
	   position. On top of that this service rate-limits remote spam.

	2) SPEED-HACK DETECTION:
	   Each player's position is sampled Config.AntiCheat.SampleRate times
	   per second. The maximum LEGITIMATE horizontal speed is
	     WalkSpeed + SprintSpeedBonus + DashSpeedBonus + SpeedTolerance.
	   (Knockback impulses top out far below that; jumps are vertical and
	   ignored; spawns/respawns get SpawnGraceSeconds of amnesty.)
	   If a player exceeds it for ConsecutiveSamples samples in a row they
	   are teleported back to their last valid position, the violation is
	   logged, and a strike is recorded. MaxStrikes -> kick.

	CombatService calls AllowAbilityRequest() at the top of every Request
	handler; everything else runs on its own sampler loop.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local AntiCheatService = {}

local trackers = {} -- { [Player] = tracker }
local initialized = false

local function now()
	return os.clock()
end

local function maxLegitimateSpeed()
	return Config.WalkSpeed + Config.SprintSpeedBonus + Config.DashSpeedBonus
		+ Config.AntiCheat.SpeedTolerance
end

local function log(player, message)
	if Config.AntiCheat.LogViolations then
		warn(("[AntiCheat] %s: %s"):format(player.Name, message))
	end
end

local function strike(player, reason)
	local tracker = trackers[player]
	if not tracker then
		return
	end
	tracker.strikes = tracker.strikes + 1
	log(player, ("STRIKE %d/%d (%s)"):format(
		tracker.strikes, Config.AntiCheat.MaxStrikes, reason))
	if tracker.strikes >= Config.AntiCheat.MaxStrikes then
		pcall(function()
			player:Kick("[AntiCheat] Too many movement/ability violations (" .. reason .. ")")
		end)
	end
end

local function newTracker()
	return {
		lastPosition = nil,
		lastValidPosition = nil,
		lastSampleTime = 0,
		fastStreak = 0,
		graceUntil = 0,
		strikes = 0,
		requestTimes = {}, -- sliding window for ability spam
	}
end

local function getTracker(player)
	local tracker = trackers[player]
	if not tracker then
		tracker = newTracker()
		trackers[player] = tracker
	end
	return tracker
end

---------------------------------------------------------------------------
-- Sampler
---------------------------------------------------------------------------

local function samplePlayer(player, tracker, currentTime)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return
	end
	if currentTime < tracker.graceUntil then
		-- Spawn/respawn amnesty: just re-anchor our notion of "valid".
		tracker.lastValidPosition = root.Position
		tracker.lastPosition = root.Position
		tracker.lastSampleTime = currentTime
		tracker.fastStreak = 0
		return
	end

	if tracker.lastPosition == nil or tracker.lastSampleTime == 0 then
		tracker.lastPosition = root.Position
		tracker.lastValidPosition = root.Position
		tracker.lastSampleTime = currentTime
		return
	end

	local dt = currentTime - tracker.lastSampleTime
	tracker.lastSampleTime = currentTime
	tracker.lastPosition = root.Position
	if dt <= 0 or dt > 0.5 then
		return -- server hitch or first tick: never judge these
	end

	-- Horizontal-only: jumps/knockback pops are vertical and legitimate.
	local delta = root.Position - tracker.lastValidPosition
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
	-- Measured against the LAST VALID position over the whole streak window,
	-- so brief legit bursts (dash momentum decay) self-clear.
	local window = currentTime - (tracker.validSince or currentTime)
	if window < dt then
		window = dt
	end
	local allowed = maxLegitimateSpeed() * window

	if horizontal > allowed then
		tracker.fastStreak = tracker.fastStreak + 1
		if tracker.fastStreak >= Config.AntiCheat.ConsecutiveSamples then
			local speed = horizontal / window
			log(player, ("speed violation: %.1f studs/s sustained (max legitimate %.1f) -> teleporting back")
				:format(speed, maxLegitimateSpeed()))
			-- Teleport back to the last valid position.
			root.AssemblyLinearVelocity = Vector3.zero
			root.CFrame = CFrame.new(tracker.lastValidPosition + Vector3.new(0, 1, 0))
			strike(player, "speed hack suspected")
			tracker.fastStreak = 0
			tracker.lastPosition = root.Position
			tracker.validSince = currentTime
		end
	else
		tracker.fastStreak = 0
		tracker.lastValidPosition = root.Position
		tracker.validSince = currentTime
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

-- CombatService calls this at the top of EVERY Request* handler.
-- Returns false when the player is spamming (request dropped + strike).
function AntiCheatService.AllowAbilityRequest(player)
	if not Config.AntiCheat.Enabled then
		return true
	end
	local tracker = getTracker(player)
	local currentTime = now()

	-- Sliding 1-second window.
	local window = tracker.requestTimes
	while #window > 0 and currentTime - window[1] > 1 do
		table.remove(window, 1)
	end
	table.insert(window, currentTime)
	if #window > Config.AntiCheat.MaxAbilityRequestsPerSecond then
		log(player, ("ability spam: %d requests in 1s (max %d)")
			:format(#window, Config.AntiCheat.MaxAbilityRequestsPerSecond))
		tracker.requestTimes = {}
		strike(player, "remote spam")
		return false
	end
	return true
end

-- Called by anything that legally teleports/impulses a player (spawns).
function AntiCheatService.GiveGrace(player, seconds)
	local tracker = getTracker(player)
	tracker.graceUntil = now() + (seconds or Config.AntiCheat.SpawnGraceSeconds)
	tracker.fastStreak = 0
end

function AntiCheatService.GetStrikes(player)
	local tracker = trackers[player]
	return tracker and tracker.strikes or 0
end

function AntiCheatService.Init()
	if initialized then
		return
	end
	initialized = true

	Players.PlayerAdded:Connect(function(player)
		trackers[player] = newTracker()
		player.CharacterAdded:Connect(function()
			AntiCheatService.GiveGrace(player, Config.AntiCheat.SpawnGraceSeconds)
		end)
		if player.Character then
			AntiCheatService.GiveGrace(player, Config.AntiCheat.SpawnGraceSeconds)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		trackers[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		trackers[player] = newTracker()
		player.CharacterAdded:Connect(function()
			AntiCheatService.GiveGrace(player, Config.AntiCheat.SpawnGraceSeconds)
		end)
		if player.Character then
			AntiCheatService.GiveGrace(player, Config.AntiCheat.SpawnGraceSeconds)
		end
	end

	if Config.AntiCheat.Enabled then
		task.spawn(function()
			local interval = 1 / Config.AntiCheat.SampleRate
			while initialized do
				local currentTime = now()
				for _, player in ipairs(Players:GetPlayers()) do
					local tracker = trackers[player]
					if tracker then
						samplePlayer(player, tracker, currentTime)
					end
				end
				task.wait(interval)
			end
		end)
	end

	print("[AntiCheatService] Initialized: " .. (Config.AntiCheat.Enabled
		and ("speed sampling %dHz, tolerance +%d, %d strikes -> kick")
			:format(Config.AntiCheat.SampleRate, Config.AntiCheat.SpeedTolerance,
				Config.AntiCheat.MaxStrikes)
		or "DISABLED"))
end

function AntiCheatService.DebugState()
	local parts = {}
	for player, tracker in pairs(trackers) do
		if player.Parent and tracker.strikes > 0 then
			table.insert(parts, ("%s[strikes=%d]"):format(player.Name, tracker.strikes))
		end
	end
	return ("enabled=%s maxSpeed=%.0f%s"):format(
		tostring(Config.AntiCheat.Enabled), maxLegitimateSpeed(),
		#parts > 0 and (" | " .. table.concat(parts, ", ")) or "")
end

return AntiCheatService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX39">
<Properties>
	<string name="Name">BotRegistry</string>
	<ProtectedString name="Source"><![CDATA[--[[
	BotRegistry (ServerScriptService.BotRegistry)
	=============================================
	Dependency-free shared roster of "participants": real Players + bot
	Models (built by BotService). Every gameplay service requires THIS
	module instead of BotService, which keeps the require graph acyclic
	(BotService needs Combat/Egg; Combat/Egg need only the registry).

	A bot is a plain Model (R6 rig) with a Humanoid, living in
	Workspace.Bots. Models support attributes, so bots carry the same
	replicated "HasEgg" attribute as players and can be sent through
	RemoteEvents (clients see them because Workspace replicates).

	Also holds two cross-service hooks so nobody has to require anybody:
	  * knockHandler  -- BotService installs the real bot-knockback logic
	  * allowedFilter -- MatchService limits a match to its chosen roster
	                     (relevant only when >6 humans are in the server)
]]

local Players = game:GetService("Players")

local BotRegistry = {}

local bots = {}          -- { [Model] = info }  info = { UserId = fake id }
local knockHandler = nil -- function(model, direction, force, upward, stunTime)
local allowedFilter = nil -- function(player) -> bool (nil = everyone allowed)

function BotRegistry.Register(model, fakeUserId)
	bots[model] = { UserId = fakeUserId }
end

function BotRegistry.Unregister(model)
	bots[model] = nil
end

function BotRegistry.IsBot(instance)
	return instance ~= nil and bots[instance] ~= nil
end

-- Character-equivalent for any participant: a player's Character, or the
-- bot Model itself.
function BotRegistry.GetCharacter(entity)
	if entity == nil then
		return nil
	end
	if entity:IsA("Player") then
		return entity.Character
	end
	if BotRegistry.IsBot(entity) then
		return entity
	end
	return nil
end

function BotRegistry.GetUserId(entity)
	if entity == nil then
		return nil
	end
	if entity:IsA("Player") then
		return entity.UserId
	end
	local info = bots[entity]
	return info and info.UserId or nil
end

-- True when a bot's Model is the given character (EggService touch events).
function BotRegistry.GetBotFromCharacter(character)
	for model in pairs(bots) do
		if model == character then
			return model
		end
	end
	return nil
end

-- Live bots (Parent check scrubs despawned models).
function BotRegistry.GetBots()
	local list = {}
	for model in pairs(bots) do
		if model.Parent then
			table.insert(list, model)
		else
			bots[model] = nil
		end
	end
	return list
end

function BotRegistry.CountBots()
	local count = 0
	for model in pairs(bots) do
		if model.Parent then
			count = count + 1
		else
			bots[model] = nil
		end
	end
	return count
end

-- Every participant allowed to touch the egg / be hit / be scored right now.
function BotRegistry.GetParticipants()
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if not allowedFilter or allowedFilter(player) then
			table.insert(list, player)
		end
	end
	for _, model in ipairs(BotRegistry.GetBots()) do
		table.insert(list, model)
	end
	return list
end

function BotRegistry.IsParticipant(entity)
	if entity == nil then
		return false
	end
	if entity:IsA("Player") then
		return (not allowedFilter or allowedFilter(entity)) and entity.Parent ~= nil
	end
	return bots[entity] ~= nil and entity.Parent ~= nil
end

-- MatchService sets this while a match runs (nil = no filtering).
function BotRegistry.SetAllowedFilter(fn)
	allowedFilter = (typeof(fn) == "function") and fn or nil
end

-- BotService installs the real knockback implementation here; CombatService
-- and EggService call through without requiring BotService.
function BotRegistry.SetKnockHandler(fn)
	knockHandler = (typeof(fn) == "function") and fn or nil
end

-- Returns "Hit" | "Invalid" (bots cannot block or i-frame).
function BotRegistry.KnockbackBot(model, direction, force, upward, stunTime)
	if not BotRegistry.IsBot(model) or not knockHandler then
		return "Invalid"
	end
	return knockHandler(model, direction, force, upward, stunTime)
end

return BotRegistry
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX40">
<Properties>
	<string name="Name">BotService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	BotService (ServerScriptService.BotService)
	===========================================
	Simple AI bots that fill empty slots so a match always has a full party
	(deliverable: a lone player starts a match and gets 5 bots).

	A bot is a code-built R6 rig (Model + Humanoid) registered in
	BotRegistry, so EggService/CombatService/ScoringService treat it as a
	normal participant: it touches the egg to pick it up, accrues hold time,
	can win rounds and even be MVP. Bots have NO data profile -> they earn
	no Clout/fragments.

	Behaviour (spec: walk toward the egg, pick it up, run to a random spot,
	punch nearby players, sometimes throw; beatable but not useless):
	  * egg loose/respawning -> walk to it (touch/proximity pickup is the
	    regular EggService path)
	  * carrying             -> roam to random spots, re-targeting every
	    RoamRetargetSeconds; if an enemy is close, sometimes THROW at them
	  * someone else carries -> hunt the carrier (Aggression chance per
	    decision, so hunting is not relentless); inside AttackRange and off
	    cooldown -> punch (softer + slower than a human: beatable)
	  * punched              -> stagger (StunTime), knockback applied

	Tunable entirely from Config.Bots; Enabled=false turns the whole system
	off (matches then need Config.MinPlayersToStart humans, as before).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local EggService = require(ServerScriptService:WaitForChild("EggService"))
local CombatService = require(ServerScriptService:WaitForChild("CombatService"))
local BotRegistry = require(ServerScriptService:WaitForChild("BotRegistry"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local BotService = {}

local botsFolder = nil
local aiBots = {}        -- { {model, humanoid, root, ...ai state} }
local botIdCounter = 0
local initialized = false

local function now()
	return os.clock()
end

local function broadcastFeedback(kind, data)
	FeedbackEvent:FireAllClients(kind, data or {})
end

---------------------------------------------------------------------------
-- R6 rig builder (pure code -- no Toolbox assets needed)
---------------------------------------------------------------------------

local function makePart(name, size, color, parent)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = true
	part.Parent = parent
	return part
end

local function makeMotor(name, part0, part1, c0, c1, parent)
	local motor = Instance.new("Motor6D")
	motor.Name = name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = c0
	motor.C1 = c1
	motor.Parent = parent
	return motor
end

local function buildRig(displayName, bodyColor, legColor)
	local model = Instance.new("Model")
	model.Name = "Bot_" .. displayName

	local root = makePart("HumanoidRootPart", Vector3.new(2, 2, 1), bodyColor, model)
	root.Transparency = 1
	root.CanCollide = false

	local torso = makePart("Torso", Vector3.new(2, 2, 1), bodyColor, model)
	local head = makePart("Head", Vector3.new(2, 1, 1), bodyColor, model)
	local leftArm = makePart("Left Arm", Vector3.new(1, 2, 1), bodyColor, model)
	local rightArm = makePart("Right Arm", Vector3.new(1, 2, 1), bodyColor, model)
	local leftLeg = makePart("Left Leg", Vector3.new(1, 2, 1), legColor, model)
	local rightLeg = makePart("Right Leg", Vector3.new(1, 2, 1), legColor, model)

	-- Canonical R6 layout around the root at origin.
	torso.CFrame = root.CFrame
	head.CFrame = root.CFrame * CFrame.new(0, 1.5, 0)
	leftArm.CFrame = root.CFrame * CFrame.new(-1.5, 0, 0)
	rightArm.CFrame = root.CFrame * CFrame.new(1.5, 0, 0)
	leftLeg.CFrame = root.CFrame * CFrame.new(-0.5, -2, 0)
	rightLeg.CFrame = root.CFrame * CFrame.new(0.5, -2, 0)

	-- Classic smiley face (built-in Roblox texture, no upload needed).
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Texture = "rbxasset://textures/face.png"
	face.Face = Enum.NormalId.Front
	face.Parent = head

	-- Standard R6 joints.
	makeMotor("RootJoint", root, torso,
		CFrame.new(0, 0, 0) * CFrame.Angles(-math.pi / 2, math.pi, 0),
		CFrame.new(0, 0, 0), torso)
	makeMotor("Neck", torso, head,
		CFrame.new(0, 1, 0) * CFrame.Angles(-math.pi / 2, math.pi, 0),
		CFrame.new(0, -0.5, 0), torso)
	makeMotor("Left Shoulder", torso, leftArm,
		CFrame.new(-1, 0.5, 0) * CFrame.Angles(0, -math.pi / 2, 0),
		CFrame.new(0.5, 0.5, 0), torso)
	makeMotor("Right Shoulder", torso, rightArm,
		CFrame.new(1, 0.5, 0) * CFrame.Angles(0, math.pi / 2, 0),
		CFrame.new(-0.5, 0.5, 0), torso)
	makeMotor("Left Hip", torso, leftLeg,
		CFrame.new(-1, -1, 0) * CFrame.Angles(0, -math.pi / 2, 0),
		CFrame.new(-0.5, 1, 0), torso)
	makeMotor("Right Hip", torso, rightLeg,
		CFrame.new(1, -1, 0) * CFrame.Angles(0, math.pi / 2, 0),
		CFrame.new(0.5, 1, 0), torso)

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.DisplayName = displayName
	humanoid.WalkSpeed = Config.Bots.WalkSpeed
	humanoid.JumpPower = 0 -- bots do not jump (keeps the AI simple + beatable)
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.Parent = model

	model.PrimaryPart = root
	return model, humanoid, root
end

---------------------------------------------------------------------------
-- Spawn / despawn
---------------------------------------------------------------------------

local function randomArenaPoint(radius)
	local angle = math.random() * math.pi * 2
	local distance = math.random() * (radius or 45)
	return Vector3.new(math.cos(angle) * distance, 4, math.sin(angle) * distance)
end

function BotService.SpawnBots(count)
	if not Config.Bots.Enabled or count <= 0 then
		return {}
	end
	count = math.min(count, Config.Bots.MaxBots)
	if not botsFolder then
		botsFolder = Workspace:FindFirstChild("Bots")
		if not botsFolder then
			botsFolder = Instance.new("Folder")
			botsFolder.Name = "Bots"
			botsFolder.Parent = Workspace
		end
	end

	-- Shuffle name/color pools so parties vary.
	local names = {}
	for _, name in ipairs(Config.Bots.Names) do
		table.insert(names, name)
	end
	for index = #names, 2, -1 do
		local swap = math.random(1, index)
		names[index], names[swap] = names[swap], names[index]
	end

	local spawned = {}
	for index = 1, count do
		botIdCounter = botIdCounter + 1
		local displayName = names[((index - 1) % #names) + 1]
		local colorName = Config.Bots.Colors[(botIdCounter % #Config.Bots.Colors) + 1]
		local bodyColor = BrickColor.new(colorName).Color
		local legColor = BrickColor.new("Dark stone grey").Color

		local model, humanoid, root = buildRig(displayName, bodyColor, legColor)
		model.Parent = botsFolder
		model:PivotTo(CFrame.new(randomArenaPoint(Config.ArenaSpawnRadius)))

		BotRegistry.Register(model, -(9000 + botIdCounter)) -- fake negative UserId
		table.insert(spawned, model)

		table.insert(aiBots, {
			model = model,
			humanoid = humanoid,
			root = root,
			nextDecisionAt = now() + math.random() * Config.Bots.ReactionTime,
			stunUntil = 0,
			lastAttackAt = -math.huge,
			roamTarget = nil,
			roamRetargetAt = 0,
		})

		-- Bots broadcast possession/feedback through the normal remotes:
		-- models replicate, so clients can render bot carriers and events.
		humanoid:SetAttribute("IsBot", true)
	end

	if Config.DebugVerboseLogging and count > 0 then
		print(("[BotService] spawned %d bot(s) -- arena now has %d participant(s)")
			:format(#spawned, #BotRegistry.GetParticipants()))
	end
	return spawned
end

function BotService.DespawnAll()
	for _, bot in ipairs(aiBots) do
		if EggService.GetCarrier() == bot.model then
			EggService.Fumble(bot.model, "BotDespawned")
		end
		BotRegistry.Unregister(bot.model)
		bot.model:Destroy()
	end
	aiBots = {}
	if Config.DebugVerboseLogging then
		print("[BotService] all bots despawned")
	end
end

---------------------------------------------------------------------------
-- Bot knockback (installed into BotRegistry; CombatService/EggService call)
---------------------------------------------------------------------------

local function knockBot(model, direction, force, upward, stunTime)
	for _, bot in ipairs(aiBots) do
		if bot.model == model then
			local flat = Vector3.new(direction.X, 0, direction.Z)
			if flat.Magnitude < 0.001 then
				flat = Vector3.new(0, 0, 1)
			end
			bot.root.AssemblyLinearVelocity =
				Vector3.new(flat.Unit.X * force, upward or 0, flat.Unit.Z * force)
			bot.stunUntil = now() + (stunTime or Config.Bots.StunTime)
			return "Hit"
		end
	end
	return "Invalid"
end

function BotService.IsStunned(model)
	for _, bot in ipairs(aiBots) do
		if bot.model == model then
			return now() < bot.stunUntil
		end
	end
	return false
end

---------------------------------------------------------------------------
-- AI
---------------------------------------------------------------------------

local function getRootOf(entity)
	local character = BotRegistry.GetCharacter(entity)
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- Bot punch: mirror of the player attack, softer + slower (Config.Bots).
local function botPunch(bot)
	bot.lastAttackAt = now()
	broadcastFeedback("PunchSwing", { Player = bot.model, Position = bot.root.Position })

	local look = bot.root.CFrame.LookVector
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	if lookFlat.Magnitude > 0.001 then
		lookFlat = lookFlat.Unit
	else
		lookFlat = nil
	end

	local carrier = EggService.GetCarrier()
	for _, victim in ipairs(BotRegistry.GetParticipants()) do
		if victim ~= bot.model then
			local victimRoot = getRootOf(victim)
			if victimRoot then
				local offset = victimRoot.Position - bot.root.Position
				if offset.Magnitude <= Config.Bots.AttackRange then
					local pushDir = Vector3.new(offset.X, 0, offset.Z)
					if pushDir.Magnitude < 0.001 then
						pushDir = lookFlat or Vector3.new(0, 0, 1)
					end
					pushDir = pushDir.Unit
					if (lookFlat == nil) or (lookFlat:Dot(pushDir) >= Config.AttackFacingDot) then
						local result
						if victim:IsA("Player") then
							result = CombatService.ApplyKnockback(
								victim, pushDir,
								Config.Bots.PunchKnockback, Config.Bots.PunchUpward,
								Config.AttackHitstun)
						else
							result = BotRegistry.KnockbackBot(
								victim, pushDir,
								Config.Bots.PunchKnockback, Config.Bots.PunchUpward,
								Config.Bots.StunTime)
						end
						broadcastFeedback("PunchHit", {
							Attacker = bot.model,
							Victim = victim,
							Position = victimRoot.Position,
							Result = result,
						})
						if victim == carrier and result == "Hit" then
							CombatService.AttemptSteal(bot.model, victim, pushDir)
						end
					end
				end
			end
		end
	end
end

local function nearestEnemy(bot)
	local best, bestDistance = nil, math.huge
	for _, entity in ipairs(BotRegistry.GetParticipants()) do
		if entity ~= bot.model then
			local root = getRootOf(entity)
			if root then
				local distance = (root.Position - bot.root.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = entity, distance
				end
			end
		end
	end
	return best, bestDistance
end

local function decide(bot)
	local carrier = EggService.GetCarrier()
	local egg = EggService.GetEgg()
	local eggState = EggService.GetState()

	if carrier == bot.model then
		-- CARRYING: run to random spots; sometimes throw when hunted.
		local enemy, enemyDistance = nearestEnemy(bot)
		if enemy and enemyDistance <= Config.Bots.ThrowRange
			and math.random() < Config.Bots.ThrowChance
		then
			local enemyRoot = getRootOf(enemy)
			if enemyRoot then
				local direction = enemyRoot.Position - bot.root.Position
				direction = Vector3.new(direction.X, 0, direction.Z)
				if direction.Magnitude > 0.001 then
					-- Slight spread: bots are not snipers.
					direction = direction.Unit * 1.0
					direction = direction + Vector3.new(
						(math.random() - 0.5) * 0.4, 0, (math.random() - 0.5) * 0.4)
					EggService.ReleaseThrow(bot.model, direction)
					bot.roamTarget = nil
					return
				end
			end
		end
		if not bot.roamTarget or now() >= bot.roamRetargetAt then
			bot.roamTarget = randomArenaPoint(45)
			bot.roamRetargetAt = now() + Config.Bots.RoamRetargetSeconds
		end
		bot.humanoid:MoveTo(bot.roamTarget)

	elseif carrier ~= nil then
		-- SOMEONE ELSE CARRIES: hunt them (not every tick -- beatable).
		local carrierRoot = getRootOf(carrier)
		if carrierRoot then
			if math.random() < Config.Bots.Aggression then
				bot.humanoid:MoveTo(carrierRoot.Position)
				local distance = (carrierRoot.Position - bot.root.Position).Magnitude
				if distance <= Config.Bots.AttackRange
					and now() >= bot.lastAttackAt + Config.Bots.AttackCooldown
				then
					botPunch(bot)
				end
			else
				-- Mill around near the carrier instead of beelining.
				if not bot.roamTarget or now() >= bot.roamRetargetAt then
					bot.roamTarget = carrierRoot.Position + randomArenaPoint(14)
					bot.roamRetargetAt = now() + Config.Bots.RoamRetargetSeconds
				end
				bot.humanoid:MoveTo(bot.roamTarget)
			end
		end

	else
		-- EGG LOOSE / RESPAWNING: go get it (or wait near center).
		bot.roamTarget = nil
		if egg and eggState == "Loose" then
			bot.humanoid:MoveTo(egg.Position)
		else
			bot.humanoid:MoveTo(Vector3.new(
				(math.random() - 0.5) * 16, 0, (math.random() - 0.5) * 16))
		end
	end
end

local function tickBots()
	local currentTime = now()
	for index = #aiBots, 1, -1 do
		local bot = aiBots[index]
		if not bot.model.Parent then
			table.remove(aiBots, index) -- despawned elsewhere
		elseif bot.root.Position.Y < Config.Bots.RespawnY then
			-- Knocked out of the arena: pop back onto the ring.
			bot.model:PivotTo(CFrame.new(randomArenaPoint(Config.ArenaSpawnRadius)))
			bot.root.AssemblyLinearVelocity = Vector3.zero
			bot.stunUntil = currentTime + Config.Bots.StunTime
		elseif currentTime < bot.stunUntil then
			bot.humanoid.WalkSpeed = 0 -- staggered
		else
			if bot.humanoid.WalkSpeed < 0.5 then
				bot.humanoid.WalkSpeed = (EggService.GetCarrier() == bot.model)
					and Config.Bots.CarrySpeed or Config.Bots.WalkSpeed
			end
			if currentTime >= bot.nextDecisionAt then
				bot.nextDecisionAt = currentTime + Config.Bots.ReactionTime
					+ math.random() * 0.15
				local ok, err = pcall(decide, bot)
				if not ok then
					warn("[BotService] AI error: " .. tostring(err))
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------

function BotService.Init()
	if initialized then
		return
	end
	initialized = true

	BotRegistry.SetKnockHandler(knockBot)

	task.spawn(function()
		while initialized do
			tickBots()
			task.wait(1 / Config.Bots.TickRate)
		end
	end)

	print("[BotService] Initialized: " .. (Config.Bots.Enabled
		and ("bots ENABLED (fill to %d, grace %ds)")
			:format(Config.MaxPlayers, Config.Bots.LobbyGraceSeconds)
		or "bots DISABLED"))
end

function BotService.GetBots()
	return BotRegistry.GetBots()
end

function BotService.DebugState()
	local parts = {}
	for _, bot in ipairs(aiBots) do
		if bot.model.Parent then
			local flags = {}
			if EggService.GetCarrier() == bot.model then
				table.insert(flags, "CARRYING")
			end
			if now() < bot.stunUntil then
				table.insert(flags, "stunned")
			end
			table.insert(parts, bot.model.Name
				.. (#flags > 0 and ("[" .. table.concat(flags, "+") .. "]") or ""))
		end
	end
	return ("bots=%d%s"):format(#parts, #parts > 0 and (" (" .. table.concat(parts, ", ") .. ")") or "")
end

return BotService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX41">
<Properties>
	<string name="Name">CombatService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	CombatService (ServerScriptService.CombatService)
	=================================================
	Server-authoritative abilities: Attack, Throw, Block, Dash, Sprint + the
	shared stamina pool. Clients only fire Request* RemoteEvents; EVERY rule
	is checked here (context, cooldown, stamina, alive/stun state). Cheaters
	get rejected and nothing happens.

	Ability rules (from the game spec)
	----------------------------------
	Attack : ONLY when NOT holding the egg ("HandsFull" feedback otherwise).
	         Short-range punch (Config.AttackRange + forward hemisphere).
	         On hit: knockback (Config.AttackKnockback) + brief hitstun.
	         If the victim is the carrier: EggService.Fumble with a knock-loose
	         pop -> "EggStolen" feedback. Cooldown Config.AttackCooldown.
	Throw  : ONLY when holding the egg. Launches it via EggService.ReleaseThrow
	         at Config.ThrowSpeed with an upward lob. While "hot", the thrown
	         egg knocks players back and bounces loose (HandleEggImpact).
	Block  : ALWAYS usable (hold). Incoming knockback reduced by
	         Config.BlockKnockbackReduction, move speed multiplied by
	         Config.BlockSpeedMultiplier, drains Config.BlockStaminaDrain/s.
	         A blocking carrier STILL accrues hold time (EggService does not
	         care about blocking). Block breaks automatically at 0 stamina.
	Dash   : ALWAYS usable (default key E). Speed burst for
	         Config.DashDuration. NOT carrying: brief i-frames
	         (Config.DashIFrames). Carrying: shorter dash, NO i-frames, and
	         colliding with a player within Config.DashCollisionRadius
	         fumbles the egg ("DashFumble" + small knockback to the victim).
	Sprint : ALWAYS usable (hold, default key Shift) -- the main stamina
	         sink. +Config.SprintSpeedBonus speed (works while carrying too),
	         drains Config.SprintStaminaDrain/s. Blocking, stun and dash
	         suppress sprinting; at 0 stamina the sprinter is "exhausted"
	         until stamina recovers to Config.SprintResumeStamina.

	Stamina: max Config.StaminaMax, regenerates Config.StaminaRegenPerSecond
	         after Config.StaminaRegenDelay without spending. Dash and Attack
	         cost stamina up front; Block and Sprint drain while active.
	         Published to clients as the rounded "Stamina" Player attribute
	         (HUD-ready).

	Speed ownership: this module is the ONLY writer of Humanoid.WalkSpeed.
	         Base = carrier ? CarrySpeed : WalkSpeed, + SprintSpeedBonus while
	         sprinting, x BlockSpeedMultiplier while blocking, 0 while
	         stunned, dash override during bursts. Recalculated every tick
	         (writes only on change) plus on HasEgg attribute changes.

	FeedbackEvent kinds fired here
	------------------------------
	FireAllClients : PunchSwing, PunchHit, BlockedHit, IFrameDodge, EggStolen,
	                 DashStart, DashFumble, BlockStart, BlockEnd, BlockBroken,
	                 SprintStart, SprintEnd
	FireClient     : HandsFull, NotCarrying, NoStamina, OnCooldown, Stunned,
	                 PunchWhiff, Exhausted
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
-- One-directional dependency: CombatService may use EggService, never the
-- reverse (EggService calls back through the injected impact handler).
local EggService = require(ServerScriptService:WaitForChild("EggService"))
local BotRegistry = require(ServerScriptService:WaitForChild("BotRegistry"))
local AntiCheatService = require(ServerScriptService:WaitForChild("AntiCheatService"))
local HatcheryService = require(ServerScriptService:WaitForChild("HatcheryService"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RequestAttack = Remotes:WaitForChild("RequestAttack")
local RequestThrow = Remotes:WaitForChild("RequestThrow")
local RequestDash = Remotes:WaitForChild("RequestDash")
local RequestBlockStart = Remotes:WaitForChild("RequestBlockStart")
local RequestBlockEnd = Remotes:WaitForChild("RequestBlockEnd")
local RequestSprintStart = Remotes:WaitForChild("RequestSprintStart")
local RequestSprintEnd = Remotes:WaitForChild("RequestSprintEnd")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local CombatService = {}

local COMBAT_TICK = 0.05 -- 20 Hz: stamina, dash windows, collisions, speed recalc

---------------------------------------------------------------------------
-- Per-player combat state (server only)
---------------------------------------------------------------------------

local statuses = {} -- { [Player] = status }
local lastTickTime = 0
local initialized = false

local function now()
	return os.clock()
end

local function newStatus()
	return {
		stamina = Config.StaminaMax,
		publishedStamina = -1, -- forces the first attribute publish
		lastSpendTime = -math.huge,
		blocking = false,
		sprinting = false,       -- client is HOLDING the sprint input
		sprintEffective = false, -- sprint is actually active (not suppressed)
		sprintLocked = false,    -- exhausted: locked until SprintResumeStamina
		attackReadyAt = 0,
		dashReadyAt = 0,
		dashUntil = 0,
		dashSpeed = Config.WalkSpeed,
		dashCollisionDone = false,
		iFramesUntil = 0,
		stunUntil = 0,
	}
end

local function getStatus(player)
	local status = statuses[player]
	if not status then
		status = newStatus()
		statuses[player] = status
	end
	return status
end

---------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------

local function getAliveCharacter(entity)
	-- Entity-aware: Players use their Character; bot Models ARE the character.
	local character = BotRegistry.GetCharacter(entity)
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character
end

local function getRoot(entity)
	local character = BotRegistry.GetCharacter(entity)
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- Server-side mirror of every feedback event (EconomyService listens).
local serverFeedback = nil

local function broadcastFeedback(kind, data)
	if serverFeedback == nil then
		serverFeedback = ServerScriptService:FindFirstChild("ServerFeedback") or false
	end
	if serverFeedback then
		serverFeedback:Fire(kind, data or {})
	end
	FeedbackEvent:FireAllClients(kind, data or {})
end

local function rejectClient(player, kind, data)
	data = data or {}
	FeedbackEvent:FireClient(player, kind, data)
end

local function spendStamina(status, amount)
	if status.stamina < amount then
		return false
	end
	status.stamina = status.stamina - amount
	status.lastSpendTime = now()
	return true
end

-- Sprint is suppressed by blocking, stun, dash and exhaustion.
local function computeSprintEffective(status, nowv)
	return status.sprinting
		and not status.blocking
		and not status.sprintLocked
		and status.stamina > 0
		and nowv >= status.stunUntil
		and nowv >= status.dashUntil
end

-- The single authority for movement speed. Called every tick and on state
-- flips; only writes when the value actually changes (no property churn).
local function recalcSpeed(player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local status = getStatus(player)
	local nowv = now()
	local speed

	if nowv < status.stunUntil then
		speed = 0 -- hitstun: rooted in place
	elseif nowv < status.dashUntil then
		speed = status.dashSpeed -- dash burst overrides everything
	else
		local isCarrier = (EggService.GetCarrier() == player)
		speed = isCarrier and Config.CarrySpeed or Config.WalkSpeed
		if computeSprintEffective(status, nowv) then
			speed = speed + Config.SprintSpeedBonus
		end
		if status.blocking then
			speed = speed * Config.BlockSpeedMultiplier
		end
	end

	if math.abs(humanoid.WalkSpeed - speed) > 0.01 then
		humanoid.WalkSpeed = speed
	end
end

---------------------------------------------------------------------------
-- Knockback (shared by punches, thrown-egg impacts and dash collisions)
---------------------------------------------------------------------------

--[[
	CombatService.ApplyKnockback(player, direction, force, upwardForce, stunTime)
	  direction   : Vector3 push direction (flattened to horizontal internally)
	  force       : horizontal speed applied (studs/s)
	  upwardForce : vertical pop (studs/s), optional
	  stunTime    : seconds of rooted hitstun, optional (blocked victims skip it)

	Returns "Hit" | "Blocked" | "IFramed" | "Invalid".
]]
function CombatService.ApplyKnockback(player, direction, force, upwardForce, stunTime)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return "Invalid"
	end
	if typeof(direction) ~= "Vector3" then
		return "Invalid"
	end

	local status = getStatus(player)
	local nowv = now()
	if nowv < status.iFramesUntil then
		return "IFramed"
	end

	local root = getRoot(player)
	if not root then
		return "Invalid"
	end

	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.001 then
		flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if flat.Magnitude < 0.001 then
			flat = Vector3.new(0, 0, 1)
		end
	end
	flat = flat.Unit

	local appliedForce = force
	local appliedUp = upwardForce or 0
	local blocked = status.blocking
	if blocked then
		appliedForce = appliedForce * (1 - Config.BlockKnockbackReduction)
		appliedUp = appliedUp * (1 - Config.BlockKnockbackReduction)
	end

	root.AssemblyLinearVelocity = Vector3.new(flat.X * appliedForce, appliedUp, flat.Z * appliedForce)

	if stunTime and stunTime > 0 and not blocked then
		status.stunUntil = nowv + stunTime
	end
	recalcSpeed(player)

	return blocked and "Blocked" or "Hit"
end

---------------------------------------------------------------------------
-- Steal attempt (shared by player punches AND bot punches)
---------------------------------------------------------------------------

--[[
	CombatService.AttemptSteal(attacker, victim, pushDir)
	  attacker/victim : Player or bot Model (victim must be the carrier)
	  pushDir         : horizontal push direction for the knock-loose pop

	Pets get their moment here: the victim's EQUIPPED pet grants a tiny
	capped grip chance (Config.Pets.GripByRarity, max MaxGripBonus %) to
	HOLD ON through the punch. Save = "GripSave" feedback (big flex), no
	fumble. Otherwise the egg pops loose and "EggStolen" fires.
	Returns true when the egg came loose.
]]
function CombatService.AttemptSteal(attacker, victim, pushDir)
	if EggService.GetCarrier() ~= victim then
		return false
	end

	local grip = HatcheryService.GetGripBonus(victim)
	if grip > 0 and math.random() * 100 < grip then
		broadcastFeedback("GripSave", { Player = victim, Attacker = attacker })
		if victim:IsA("Player") then
			rejectClient(victim, "GripSave", { Ability = "Grip", ByPet = true })
		end
		if Config.DebugVerboseLogging then
			print(("[CombatService] %s's pet GRIPPED the egg (%.1f%% save)"):format(
				victim.Name, grip))
		end
		return false
	end

	local pop = Vector3.new(
		pushDir.X * Config.EggKnockLooseSpeed,
		Config.EggKnockLooseUpward,
		pushDir.Z * Config.EggKnockLooseSpeed
	)
	EggService.Fumble(victim, "Attacked", pop)

	local victimRoot = getRoot(victim)
	broadcastFeedback("EggStolen", {
		Attacker = attacker,
		Victim = victim,
		Position = victimRoot and victimRoot.Position or nil,
	})
	return true
end

---------------------------------------------------------------------------
-- Attack
---------------------------------------------------------------------------

local function handleAttack(player)
	if not AntiCheatService.AllowAbilityRequest(player) then
		return -- remote spam: dropped + strike (see AntiCheatService)
	end
	local character = getAliveCharacter(player)
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local status = getStatus(player)
	local nowv = now()

	-- Contextual rule: HANDS FULL -- no punching while carrying the egg.
	if EggService.GetCarrier() == player then
		rejectClient(player, "HandsFull", { Ability = "Attack" })
		return
	end
	if nowv < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Attack" })
		return
	end
	if nowv < status.attackReadyAt then
		rejectClient(player, "OnCooldown", { Ability = "Attack" })
		return
	end
	if not spendStamina(status, Config.AttackStaminaCost) then
		rejectClient(player, "NoStamina", { Ability = "Attack" })
		return
	end

	status.attackReadyAt = nowv + Config.AttackCooldown
	broadcastFeedback("PunchSwing", { Player = player, Position = root.Position })

	-- Hit detection: everyone inside range AND in the forward hemisphere.
	local look = root.CFrame.LookVector
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	if lookFlat.Magnitude > 0.001 then
		lookFlat = lookFlat.Unit
	else
		lookFlat = nil -- looking straight up/down: accept any direction
	end

	local hits = 0
	for _, victim in ipairs(BotRegistry.GetParticipants()) do
		if victim ~= player then
			local victimRoot = getRoot(victim)
			local victimCharacter = getAliveCharacter(victim)
			if victimRoot and victimCharacter then
				local offset = victimRoot.Position - root.Position
				local distance = offset.Magnitude
				-- +1 stud accounts for the victim's body radius. NOTE: this
				-- distance is computed from SERVER positions only -- the
				-- client never sends coordinates, so impossible attack
				-- ranges simply whiff (anti-cheat by construction).
				if distance <= Config.AttackRange + 1 then
					local pushDir = Vector3.new(offset.X, 0, offset.Z)
					if pushDir.Magnitude < 0.001 then
						-- Point-blank (dead center): push wherever we face.
						pushDir = lookFlat or Vector3.new(0, 0, 1)
					end
					pushDir = pushDir.Unit

					local inCone = (lookFlat == nil)
						or (lookFlat:Dot(pushDir) >= Config.AttackFacingDot)
					if inCone then
						hits = hits + 1

						local victimWasCarrier = (EggService.GetCarrier() == victim)
						local victimIsPlayer = victim:IsA("Player")
						local victimIFramed = victimIsPlayer
							and (nowv < getStatus(victim).iFramesUntil) or false

						local result
						if victimIsPlayer then
							result = CombatService.ApplyKnockback(
								victim, pushDir,
								Config.AttackKnockback, Config.AttackUpwardKnockback,
								Config.AttackHitstun
							)
						else
							-- Bot victim: registry knockback + stagger (bots
							-- cannot block or i-frame).
							result = BotRegistry.KnockbackBot(
								victim, pushDir,
								Config.AttackKnockback, Config.AttackUpwardKnockback,
								Config.Bots.StunTime
							)
						end

						broadcastFeedback("PunchHit", {
							Attacker = player,
							Victim = victim,
							Position = victimRoot.Position,
							Result = result,
						})
						if result == "Blocked" then
							broadcastFeedback("BlockedHit", {
								Attacker = player,
								Victim = victim,
								Position = victimRoot.Position,
							})
						elseif result == "IFramed" then
							broadcastFeedback("IFrameDodge", {
								Attacker = player,
								Victim = victim,
								Position = victimRoot.Position,
							})
						end

						-- Steal: punching the carrier knocks the egg loose
						-- (i-framed carriers keep it; pets get a tiny capped
						-- grip chance inside AttemptSteal).
						if victimWasCarrier and not victimIFramed then
							CombatService.AttemptSteal(player, victim, pushDir)
						end
					end
				end
			end
		end
	end

	if hits == 0 then
		rejectClient(player, "PunchWhiff", {})
	end

	if Config.DebugVerboseLogging and hits > 0 then
		print("[CombatService] " .. player.Name .. " punched " .. hits .. " target(s)")
	end
end

---------------------------------------------------------------------------
-- Throw
---------------------------------------------------------------------------

local function handleThrow(player)
	if not AntiCheatService.AllowAbilityRequest(player) then
		return
	end
	local character = getAliveCharacter(player)
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local status = getStatus(player)

	-- Contextual rule: can only throw WHILE carrying.
	if EggService.GetCarrier() ~= player then
		rejectClient(player, "NotCarrying", { Ability = "Throw" })
		return
	end
	if now() < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Throw" })
		return
	end

	-- Throw where the character faces; EggService adds the lob + "hot" window
	-- and fires the "EggThrown" feedback. Hold time stops the instant it
	-- leaves the hands (possession ends inside ReleaseThrow).
	EggService.ReleaseThrow(player, root.CFrame.LookVector)
end

---------------------------------------------------------------------------
-- Dash
---------------------------------------------------------------------------

local function handleDash(player)
	if not AntiCheatService.AllowAbilityRequest(player) then
		return
	end
	local character = getAliveCharacter(player)
	if not character then
		return
	end

	local status = getStatus(player)
	local nowv = now()
	if nowv < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Dash" })
		return
	end

	local isCarrier = (EggService.GetCarrier() == player)
	local cooldown = isCarrier and Config.DashCooldownCarrying or Config.DashCooldown
	if nowv < status.dashReadyAt then
		rejectClient(player, "OnCooldown", { Ability = "Dash" })
		return
	end

	local cost = isCarrier and Config.DashStaminaCostCarrying or Config.DashStaminaCost
	if not spendStamina(status, cost) then
		rejectClient(player, "NoStamina", { Ability = "Dash" })
		return
	end

	local duration = isCarrier and Config.DashDurationCarrying or Config.DashDuration
	local bonus = isCarrier and Config.DashSpeedBonusCarrying or Config.DashSpeedBonus

	status.dashReadyAt = nowv + cooldown
	status.dashUntil = nowv + duration
	status.dashSpeed = (isCarrier and Config.CarrySpeed or Config.WalkSpeed) + bonus
	status.dashCollisionDone = false

	-- I-frames ONLY when not carrying the egg.
	if not isCarrier and Config.DashIFrames > 0 then
		status.iFramesUntil = nowv + Config.DashIFrames
	end

	broadcastFeedback("DashStart", { Player = player, Carrying = isCarrier })
	recalcSpeed(player)
end

-- Carrier dash collision check (runs in the ticker while dashing): bumping
-- into another participant fumbles the egg and nudges the victim.
local function checkDashCollision(player, status)
	local root = getRoot(player)
	if not root then
		return
	end
	for _, other in ipairs(BotRegistry.GetParticipants()) do
		if other ~= player then
			local otherRoot = getRoot(other)
			if otherRoot and getAliveCharacter(other) then
				local offset = otherRoot.Position - root.Position
				if offset.Magnitude <= Config.DashCollisionRadius then
					status.dashCollisionDone = true

					local pushDir = Vector3.new(offset.X, 0, offset.Z)
					if pushDir.Magnitude < 0.001 then
						pushDir = root.CFrame.LookVector
					end

					EggService.Fumble(player, "DashCollision")
					broadcastFeedback("DashFumble", {
						Player = player,
						Victim = other,
						Position = root.Position,
					})
					if other:IsA("Player") then
						CombatService.ApplyKnockback(
							other, pushDir,
							Config.DashCollisionKnockback, Config.DashCollisionUpward,
							nil
						)
					else
						BotRegistry.KnockbackBot(
							other, pushDir,
							Config.DashCollisionKnockback, Config.DashCollisionUpward,
							Config.Bots.StunTime
						)
					end
					return
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Block
---------------------------------------------------------------------------

local function handleBlockStart(player)
	if not AntiCheatService.AllowAbilityRequest(player) then
		return
	end
	if not getAliveCharacter(player) then
		return
	end
	local status = getStatus(player)
	if now() < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Block" })
		return
	end
	if not status.blocking then
		status.blocking = true
		broadcastFeedback("BlockStart", { Player = player })
		recalcSpeed(player) -- blocking also suppresses sprint (recalc handles it)
	end
end

local function handleBlockEnd(player)
	local status = getStatus(player)
	if status.blocking then
		status.blocking = false
		broadcastFeedback("BlockEnd", { Player = player })
		recalcSpeed(player)
	end
end

---------------------------------------------------------------------------
-- Sprint (hold Shift: the main stamina drain)
---------------------------------------------------------------------------

local function handleSprintStart(player)
	if not AntiCheatService.AllowAbilityRequest(player) then
		return
	end
	if not getAliveCharacter(player) then
		return
	end
	-- No stamina gate here: the tick decides effectiveness (exhaustion
	-- hysteresis lives there so SprintStart/SprintEnd feedback is truthful).
	getStatus(player).sprinting = true
end

-- NOTE: BlockEnd / SprintEnd are deliberately NOT rate-limited -- dropping a
-- release request could lock a player in a blocking/sprinting state.

local function handleSprintEnd(player)
	getStatus(player).sprinting = false
end

---------------------------------------------------------------------------
-- Thrown-egg impacts (injected into EggService by Main)
---------------------------------------------------------------------------

function CombatService.HandleEggImpact(player, eggVelocity)
	local direction = Vector3.new(eggVelocity.X, 0, eggVelocity.Z)
	if direction.Magnitude < 0.001 then
		direction = Vector3.new(0, 0, 1)
	end
	local result
	if player:IsA("Player") then
		result = CombatService.ApplyKnockback(
			player, direction,
			Config.EggThrowImpactKnockback, Config.EggThrowImpactUpward,
			Config.EggThrowImpactStun
		)
	else
		-- Bot got beaned by a thrown egg.
		result = BotRegistry.KnockbackBot(
			player, direction,
			Config.EggThrowImpactKnockback, Config.EggThrowImpactUpward,
			Config.Bots.StunTime
		)
	end
	if Config.DebugVerboseLogging then
		print("[CombatService] Thrown egg hit " .. player.Name .. " (" .. result .. ")")
	end
end

---------------------------------------------------------------------------
-- Player lifecycle
---------------------------------------------------------------------------

local function bindPlayer(player)
	statuses[player] = newStatus()

	player.CharacterAdded:Connect(function()
		-- Fresh life: clear transient states, refill stamina, re-apply speed.
		local status = getStatus(player)
		if status.sprintEffective then
			broadcastFeedback("SprintEnd", { Player = player })
		end
		status.blocking = false
		status.sprinting = false
		status.sprintEffective = false
		status.sprintLocked = false
		status.dashUntil = 0
		status.dashCollisionDone = false
		status.iFramesUntil = 0
		status.stunUntil = 0
		status.stamina = Config.StaminaMax
		status.lastSpendTime = -math.huge
		recalcSpeed(player)
	end)

	-- Possession flips (pickup / fumble / throw) change base speed instantly.
	player:GetAttributeChangedSignal("HasEgg"):Connect(function()
		recalcSpeed(player)
	end)

	if player.Character then
		recalcSpeed(player)
	end
end

---------------------------------------------------------------------------
-- Ticker (20 Hz): stamina, sprint/block drains, dash windows, collisions
---------------------------------------------------------------------------

local function tickOnce()
	local nowv = now()
	local dt = nowv - lastTickTime
	lastTickTime = nowv
	if dt > COMBAT_TICK * 3 then
		dt = COMBAT_TICK * 3 -- clamp: server hitches must not drain/regen in bulk
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local status = getStatus(player)
		local drained = false

		-- Block drain (breaks the block at 0 stamina).
		if status.blocking then
			status.stamina = status.stamina - Config.BlockStaminaDrain * dt
			drained = true
			if status.stamina <= 0 then
				status.stamina = 0
				status.blocking = false
				broadcastFeedback("BlockBroken", { Player = player })
				if Config.DebugVerboseLogging then
					print("[CombatService] " .. player.Name .. "'s block broke (out of stamina)")
				end
			end
		end

		-- Sprint: effectiveness (blocking/stun/dash/exhaustion suppress it),
		-- drain while effective, exhaustion hysteresis, edge feedback.
		local sprintEffective = computeSprintEffective(status, nowv)
		if sprintEffective then
			status.stamina = status.stamina - Config.SprintStaminaDrain * dt
			drained = true
			if status.stamina <= 0 then
				status.stamina = 0
				status.sprintLocked = true -- exhausted until SprintResumeStamina
				sprintEffective = false
				rejectClient(player, "Exhausted", { Ability = "Sprint" })
			end
		elseif status.sprintLocked and status.stamina >= Config.SprintResumeStamina then
			status.sprintLocked = false
		end
		if sprintEffective ~= status.sprintEffective then
			status.sprintEffective = sprintEffective
			broadcastFeedback(sprintEffective and "SprintStart" or "SprintEnd", { Player = player })
		end

		-- Regen only when nothing drained this tick, after a short delay.
		if drained then
			status.lastSpendTime = nowv
		elseif nowv - status.lastSpendTime >= Config.StaminaRegenDelay then
			status.stamina = math.min(Config.StaminaMax,
				status.stamina + Config.StaminaRegenPerSecond * dt)
		end

		-- Publish rounded stamina as a replicated attribute for the future HUD
		-- (only writes when the rounded value actually changes).
		local rounded = math.floor(status.stamina + 0.5)
		if rounded ~= status.publishedStamina then
			status.publishedStamina = rounded
			player:SetAttribute("Stamina", rounded)
		end

		-- Carrier dash collision -> fumble (spec: EggDropOnDashCollision).
		if not status.dashCollisionDone
			and nowv < status.dashUntil
			and Config.EggDropOnDashCollision
			and EggService.GetCarrier() == player
		then
			checkDashCollision(player, status)
		end

		-- Single speed authority (handles dash/stun expiry, block, sprint, carry).
		recalcSpeed(player)
	end
end

local function startTicker()
	task.spawn(function()
		lastTickTime = now()
		while initialized do
			tickOnce()
			task.wait(COMBAT_TICK)
		end
	end)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function CombatService.Init()
	if initialized then
		return
	end
	initialized = true

	-- Remote handlers: ignore ALL client-sent arguments (server computes
	-- targets/directions itself; nothing from the client is trusted).
	RequestAttack.OnServerEvent:Connect(function(player)
		handleAttack(player)
	end)
	RequestThrow.OnServerEvent:Connect(function(player)
		handleThrow(player)
	end)
	RequestDash.OnServerEvent:Connect(function(player)
		handleDash(player)
	end)
	RequestBlockStart.OnServerEvent:Connect(function(player)
		handleBlockStart(player)
	end)
	RequestBlockEnd.OnServerEvent:Connect(function(player)
		handleBlockEnd(player)
	end)
	RequestSprintStart.OnServerEvent:Connect(function(player)
		handleSprintStart(player)
	end)
	RequestSprintEnd.OnServerEvent:Connect(function(player)
		handleSprintEnd(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		bindPlayer(player)
	end
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		statuses[player] = nil
	end)

	startTicker()
	print("[CombatService] Initialized: attack/throw/block/dash/sprint + stamina live")
end

-- Read-only snapshots for other systems / the future GUI.
function CombatService.GetStamina(player)
	return getStatus(player).stamina
end

function CombatService.IsBlocking(player)
	return getStatus(player).blocking
end

function CombatService.IsSprinting(player)
	return getStatus(player).sprintEffective
end

function CombatService.IsDashing(player)
	return now() < getStatus(player).dashUntil
end

function CombatService.HasIFrames(player)
	return now() < getStatus(player).iFramesUntil
end

function CombatService.IsStunned(player)
	return now() < getStatus(player).stunUntil
end

-- One-line snapshot for the DebugCommand "state".
function CombatService.DebugState()
	local parts = {}
	for player, status in pairs(statuses) do
		if player.Parent then
			local flags = {}
			if status.blocking then table.insert(flags, "blocking") end
			if status.sprintEffective then table.insert(flags, "sprinting") end
			if now() < status.dashUntil then table.insert(flags, "dashing") end
			if now() < status.iFramesUntil then table.insert(flags, "iframes") end
			if now() < status.stunUntil then table.insert(flags, "stunned") end
			table.insert(parts, ("%s[sta=%d %s]"):format(
				player.Name, math.floor(status.stamina + 0.5), table.concat(flags, "+")))
		end
	end
	table.sort(parts)
	return #parts > 0 and table.concat(parts, ", ") or "(no players)"
end

return CombatService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX42">
<Properties>
	<string name="Name">DataService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	DataService (ServerScriptService.DataService)
	=============================================
	pcall-wrapped persistence for the whole meta layer:

	  Clout, Egg Fragments, ELO, pets, eggs (with hatch timers), the pity
	  counter (matches since last round win), lifetime hold time, match
	  stats (wins / MVPs / matches played).

	Design (per spec: SIMPLE, graceful):
	  * One key per player: "Player_<UserId>" in Config.Data.StoreName.
	  * Load on join with retries; if it still fails the player gets a
	    TEMPORARY in-memory profile (marked `Temporary = true`) so they can
	    play, and we NEVER save over real data from a failed load.
	  * Auto-save every Config.Data.AutoSaveSeconds, on PlayerRemoving and
	    in BindToClose (all pcall-wrapped with retries).
	  * Studio: Config.Data.UseRealStoreInStudio = false keeps profiles in a
	    memory table -- they still persist across rejoins inside the same
	    Studio session, so the full flow is testable without publishing.
	  * leaderstats (Clout / Frags / Pet) are created immediately and kept
	    in sync, so the stock Roblox leaderboard shows the economy.

	API:
	  DataService.Init()
	  DataService.OnProfileReady(callback)        -- callback(player, profile)
	  DataService.GetProfile(player) -> profile?  (nil until loaded)
	  DataService.IsLoaded(player) -> bool
	  DataService.Get(player, key, default)
	  DataService.Set(player, key, value)
	  DataService.AddNumeric(player, key, amount) -> newValue?
	  DataService.AddClout(player, amount) -> newClout?
	  DataService.AddFragments(player, amount) -> newFragments?
	  DataService.GetElo(player) / SetElo(player, elo)
	  DataService.AddLifetimeHold(player, seconds)
	  DataService.GetSnapshot(player) -> plain table for remotes
	  DataService.Save(player) / SaveAll()
	  DataService.DebugState()
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local DataService = {}

local store = nil -- DataStoreService:GetDataStore(Config.Data.StoreName)
local useRealStore = false
local memoryStore = {}   -- Studio/testing fallback: { [key] = deepCopy }
local profiles = {}      -- { [Player] = profile }
local initialized = false
local profileReadyCallbacks = {}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------

local function deepCopy(original)
	local copy = {}
	for key, value in pairs(original) do
		if type(value) == "table" then
			copy[key] = deepCopy(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function defaultProfile()
	return {
		Clout = Config.Economy.StartingClout,
		Fragments = 0,
		Elo = Config.Matchmaking.DefaultElo,
		LifetimeHoldTime = 0,
		MatchesPlayed = 0,
		RoundWins = 0,
		MVPs = 0,
		MatchesSinceRoundWin = 0,  -- pity counter
		Eggs = {},                 -- { {Id, Source, GuaranteedRare, UnlocksAt} }
		Pets = {},                 -- { {Id, Name, Species, Rarity, Size, Mutation?, GripBonus, CreatedAt} }
		EquippedPetId = nil,
	}
end

-- Merges a stored table into fresh defaults so schema additions never crash
-- on old profiles.
local function migrate(stored)
	local profile = defaultProfile()
	if type(stored) ~= "table" then
		return profile
	end
	for key, value in pairs(stored) do
		if key == "Eggs" or key == "Pets" then
			if type(value) == "table" then
				profile[key] = value
			end
		else
			profile[key] = value
		end
	end
	return profile
end

local function storeKey(player)
	return "Player_" .. player.UserId
end

local function rawGet(key)
	if not useRealStore then
		local existing = memoryStore[key]
		return existing and deepCopy(existing) or nil
	end
	return store:GetAsync(key) -- may throw; callers pcall
end

local function rawSet(key, value)
	if not useRealStore then
		memoryStore[key] = deepCopy(value)
		return
	end
	store:SetAsync(key, value) -- may throw; callers pcall
end

local function stripTransient(profile)
	local copy = deepCopy(profile)
	copy.Temporary = nil
	copy.LoadedAt = nil
	return copy
end

---------------------------------------------------------------------------
-- leaderstats (stock Roblox leaderboard: Clout, Frags, Pet)
---------------------------------------------------------------------------

local function getStat(player, name, className)
	local folder = player:FindFirstChild("leaderstats")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		folder.Parent = player
	end
	local stat = folder:FindFirstChild(name)
	if not stat then
		stat = Instance.new(className)
		stat.Name = name
		stat.Parent = folder
	end
	return stat
end

local function refreshLeaderstats(player)
	local profile = profiles[player]
	local clout = getStat(player, "Clout", "IntValue")
	clout.Value = profile and math.floor(profile.Clout or 0) or 0
	local frags = getStat(player, "Frags", "IntValue")
	frags.Value = profile and math.floor(profile.Fragments or 0) or 0

	local petStat = getStat(player, "Pet", "StringValue")
	local petName = "none"
	if profile and profile.EquippedPetId then
		for _, pet in ipairs(profile.Pets) do
			if pet.Id == profile.EquippedPetId then
				petName = pet.Rarity .. " " .. pet.Name
				break
			end
		end
	end
	petStat.Value = petName
end

---------------------------------------------------------------------------
-- Load / save
---------------------------------------------------------------------------

local function loadProfile(player)
	local key = storeKey(player)
	local stored = nil
	local ok = false

	for attempt = 1, Config.Data.LoadRetries do
		ok, stored = pcall(rawGet, key)
		if ok then
			break
		end
		warn(("[DataService] load attempt %d/%d failed for %s: %s"):format(
			attempt, Config.Data.LoadRetries, player.Name, tostring(stored)))
		if attempt < Config.Data.LoadRetries then
			task.wait(Config.Data.RetryDelaySeconds * attempt)
		end
	end

	local profile
	if ok then
		profile = migrate(stored)
	else
		-- Load failed: play on defaults but NEVER save (protects real data).
		profile = defaultProfile()
		profile.Temporary = true
		warn(("[DataService] %s is playing on a TEMPORARY profile (load failed)")
			:format(player.Name))
	end

	profile.LoadedAt = os.time()
	profiles[player] = profile
	refreshLeaderstats(player)

	for _, callback in ipairs(profileReadyCallbacks) do
		task.spawn(callback, player, profile)
	end
	if Config.DebugVerboseLogging then
		print(("[DataService] loaded %s (Clout=%d Frags=%d Pets=%d%s)"):format(
			player.Name, profile.Clout, profile.Fragments, #profile.Pets,
			profile.Temporary and " TEMPORARY" or ""))
	end
end

function DataService.Save(player)
	local profile = profiles[player]
	if not profile or profile.Temporary then
		return false -- nothing loaded or protecting real data
	end
	local payload = stripTransient(profile)
	for attempt = 1, Config.Data.SaveRetries do
		local ok, err = pcall(rawSet, storeKey(player), payload)
		if ok then
			return true
		end
		warn(("[DataService] save attempt %d/%d failed for %s: %s"):format(
			attempt, Config.Data.SaveRetries, player.Name, tostring(err)))
		if attempt < Config.Data.SaveRetries then
			task.wait(Config.Data.RetryDelaySeconds)
		end
	end
	return false
end

function DataService.SaveAll()
	for _, player in ipairs(Players:GetPlayers()) do
		DataService.Save(player)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function DataService.Init()
	if initialized then
		return
	end
	initialized = true

	useRealStore = (not RunService:IsStudio()) or Config.Data.UseRealStoreInStudio
	if useRealStore then
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.Data.StoreName)
		end)
		if ok then
			store = result
		else
			warn("[DataService] GetDataStore failed (" .. tostring(result)
				.. ") -- falling back to memory profiles")
			useRealStore = false
		end
	else
		print("[DataService] Studio mode: memory profiles (persist across rejoins this session)")
	end

	for _, player in ipairs(Players:GetPlayers()) do
		refreshLeaderstats(player)
		task.spawn(loadProfile, player)
	end
	Players.PlayerAdded:Connect(function(player)
		refreshLeaderstats(player) -- show zeros instantly, load fills them in
		task.spawn(loadProfile, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		DataService.Save(player)
		profiles[player] = nil
	end)

	-- Auto-save loop.
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutoSaveSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = profiles[player]
				if profile and not profile.Temporary then
					task.spawn(DataService.Save, player)
				end
			end
		end
	end)

	game:BindToClose(function()
		-- Best-effort final save; pcall-wrapped so shutdown never errors out.
		pcall(function()
			DataService.SaveAll()
		end)
		task.wait(1)
	end)

	print("[DataService] Initialized: persistence + leaderstats live ("
		.. (useRealStore and "DataStore" or "memory") .. ")")
end

function DataService.OnProfileReady(callback)
	table.insert(profileReadyCallbacks, callback)
end

function DataService.GetProfile(player)
	return profiles[player]
end

function DataService.IsLoaded(player)
	return profiles[player] ~= nil
end

function DataService.Get(player, key, default)
	local profile = profiles[player]
	if not profile or profile[key] == nil then
		return default
	end
	return profile[key]
end

function DataService.Set(player, key, value)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	profile[key] = value
	if key == "Clout" or key == "Fragments" or key == "EquippedPetId" then
		refreshLeaderstats(player)
	end
	return value
end

function DataService.AddNumeric(player, key, amount)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	profile[key] = (tonumber(profile[key]) or 0) + amount
	if key == "Clout" or key == "Fragments" then
		refreshLeaderstats(player)
	end
	return profile[key]
end

function DataService.AddClout(player, amount)
	return DataService.AddNumeric(player, "Clout", amount)
end

function DataService.AddFragments(player, amount)
	return DataService.AddNumeric(player, "Fragments", amount)
end

function DataService.GetElo(player)
	return DataService.Get(player, "Elo", Config.Matchmaking.DefaultElo)
end

function DataService.SetElo(player, elo)
	elo = math.clamp(math.floor(elo), Config.Matchmaking.MinElo, Config.Matchmaking.MaxElo)
	return DataService.Set(player, "Elo", elo)
end

function DataService.AddLifetimeHold(player, seconds)
	return DataService.AddNumeric(player, "LifetimeHoldTime", seconds)
end

-- Plain-table snapshot safe to send over remotes (HatcheryUpdated).
function DataService.GetSnapshot(player)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return {
		Clout = math.floor(profile.Clout or 0),
		Fragments = math.floor(profile.Fragments or 0),
		Elo = profile.Elo or Config.Matchmaking.DefaultElo,
		LifetimeHoldTime = math.floor(profile.LifetimeHoldTime or 0),
		MatchesPlayed = profile.MatchesPlayed or 0,
		RoundWins = profile.RoundWins or 0,
		MVPs = profile.MVPs or 0,
		PityProgress = {
			SinceRoundWin = profile.MatchesSinceRoundWin or 0,
			Needed = Config.Economy.PityMatchesWithoutRoundWin,
		},
		Eggs = deepCopy(profile.Eggs or {}),
		Pets = deepCopy(profile.Pets or {}),
		EquippedPetId = profile.EquippedPetId,
		StoreOK = not profile.Temporary,
		Now = os.time(), -- clients compute hatch countdowns from this
	}
end

function DataService.DebugState()
	local loaded, temporary = 0, 0
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = profiles[player]
		if profile then
			loaded = loaded + 1
			if profile.Temporary then
				temporary = temporary + 1
			end
		end
	end
	return ("mode=%s loaded=%d/%d temporary=%d"):format(
		useRealStore and "DataStore" or "memory", loaded, #Players:GetPlayers(), temporary)
end

return DataService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX43">
<Properties>
	<string name="Name">EconomyService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	EconomyService (ServerScriptService.EconomyService)
	===================================================
	Awards the meta currency once per completed match.

	Clout (soft currency), per real player in the final standings:
	  participation + hold seconds + knockdowns + steals
	  + round wins + MVP bonus                       (all Config.Economy)

	Egg Fragments, ranked by TOTAL match hold time:
	  rank 1..6 -> Config.Economy.FragmentsByRank (top 3 earn more,
	  ranks 4-6 still earn some -- never zero).

	Pity: every match WITHOUT a round win bumps MatchesSinceRoundWin;
	after Config.Economy.PityMatchesWithoutRoundWin (10) winless matches
	the player's NEXT round win instantly grants a GUARANTEED-RARE egg
	and resets the counter (tracked in data, survives rejoins).

	Knockdown/steal counting listens to the server-side ServerFeedback
	BindableEvent (Main creates it; CombatService/EggService mirror every
	FeedbackEvent into it) -- so no gameplay module has to know the economy
	exists. Bots earn nothing (they have no profiles).

	Fired: MatchRewards (per client) with the full breakdown; lifetime
	hold time / MatchesPlayed / RoundWins / MVPs update in data.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local DataService = require(ServerScriptService:WaitForChild("DataService"))
local HatcheryService = require(ServerScriptService:WaitForChild("HatcheryService"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local MatchRewards = Remotes:WaitForChild("MatchRewards")

local EconomyService = {}

local matchStats = {}   -- { [Player] = { Knockdowns = n, Steals = n } }
local serverFeedback = nil
local initialized = false

local function getStats(player)
	local stats = matchStats[player]
	if not stats then
		stats = { Knockdowns = 0, Steals = 0 }
		matchStats[player] = stats
	end
	return stats
end

-- Called by MatchService (injected by Main) at the start of every match.
function EconomyService.ResetMatchStats()
	matchStats = {}
	for _, player in ipairs(Players:GetPlayers()) do
		matchStats[player] = { Knockdowns = 0, Steals = 0 }
	end
end

---------------------------------------------------------------------------
-- Match settlement
---------------------------------------------------------------------------

local function awardPlayer(player, entry, rank)
	local profile = DataService.GetProfile(player)
	if not profile then
		return -- data never loaded: skip silently (they keep playing)
	end
	local stats = getStats(player)

	-- 1) Clout breakdown.
	local knockdowns = math.min(stats.Knockdowns, Config.Economy.MaxKnockdownsCredited)
	local steals = math.min(stats.Steals, Config.Economy.MaxStealsCredited)
	local holdSeconds = math.floor(entry.TotalHoldTime or 0)

	local clout = Config.Economy.CloutParticipation
		+ holdSeconds * Config.Economy.CloutPerHoldSecond
		+ knockdowns * Config.Economy.CloutPerKnockdown
		+ steals * Config.Economy.CloutPerSteal
		+ (entry.RoundsWon or 0) * Config.Economy.CloutPerRoundWin
		+ (entry.IsMVP and Config.Economy.CloutMVPBonus or 0)

	-- 2) Fragments by final rank (never zero).
	local fragments = Config.Economy.FragmentsByRank[rank]
		or Config.Economy.FragmentsByRank[#Config.Economy.FragmentsByRank]

	-- 3) Pity: winless-match counter, guaranteed-rare egg on the next win.
	local roundsWon = entry.RoundsWon or 0
	local pityEgg = false
	if roundsWon > 0 then
		if (profile.MatchesSinceRoundWin or 0) >= Config.Economy.PityMatchesWithoutRoundWin then
			pityEgg = true
		end
		DataService.Set(player, "MatchesSinceRoundWin", 0)
	else
		DataService.Set(player, "MatchesSinceRoundWin",
			(profile.MatchesSinceRoundWin or 0) + 1)
	end

	-- 4) Apply.
	local newClout = DataService.AddClout(player, clout)
	local newFragments = DataService.AddFragments(player, fragments)
	DataService.AddLifetimeHold(player, entry.TotalHoldTime or 0)
	DataService.Set(player, "MatchesPlayed", (profile.MatchesPlayed or 0) + 1)
	DataService.Set(player, "RoundWins", (profile.RoundWins or 0) + roundsWon)
	if entry.IsMVP then
		DataService.Set(player, "MVPs", (profile.MVPs or 0) + 1)
	end
	local grantedEgg = nil
	if pityEgg then
		grantedEgg = HatcheryService.GrantEgg(player, "Pity", true)
	end

	-- 5) Tell the client (GUI toast + panel refresh).
	MatchRewards:FireClient(player, {
		Rank = rank,
		Clout = clout,
		Fragments = fragments,
		NewClout = math.floor(newClout or 0),
		NewFragments = math.floor(newFragments or 0),
		Knockdowns = knockdowns,
		Steals = steals,
		HoldSeconds = holdSeconds,
		RoundsWon = roundsWon,
		IsMVP = entry.IsMVP and true or false,
		PityEgg = pityEgg,
		EggGranted = grantedEgg ~= nil,
		PityProgress = {
			SinceRoundWin = DataService.Get(player, "MatchesSinceRoundWin", 0),
			Needed = Config.Economy.PityMatchesWithoutRoundWin,
		},
	})

	if Config.DebugVerboseLogging then
		print(("[Economy] %s: rank %d -> +%d Clout (total %d), +%d Frags (total %d)%s"):format(
			player.Name, rank, clout, math.floor(newClout or 0),
			fragments, math.floor(newFragments or 0),
			pityEgg and "  [PITY: guaranteed-rare egg granted!]" or ""))
	end
end

-- Called by MatchService (injected by Main) right after MatchEnded fires.
function EconomyService.SettleMatch(final)
	if type(final) ~= "table" or type(final.Standings) ~= "table" then
		return
	end
	for rank, entry in ipairs(final.Standings) do
		local player = entry.Player
		if player and player:IsA("Player") and player.Parent and not entry.Left then
			awardPlayer(player, entry, rank)
		end
		-- Bots and leavers earn nothing.
	end
	-- Hatchery snapshots refresh so egg/pity changes show immediately.
	for _, player in ipairs(Players:GetPlayers()) do
		HatcheryService.SendSnapshot(player)
	end
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------

function EconomyService.Init()
	if initialized then
		return
	end
	initialized = true

	-- Mirror of every FeedbackEvent, server-side (Main creates the bindable).
	serverFeedback = ServerScriptService:FindFirstChild("ServerFeedback")
	if serverFeedback and serverFeedback:IsA("BindableEvent") then
		serverFeedback.Event:Connect(function(kind, data)
			if type(data) ~= "table" then
				return
			end
			if kind == "PunchHit" and data.Result == "Hit" and data.Attacker then
				local attacker = data.Attacker
				if attacker:IsA("Player") then
					getStats(attacker).Knockdowns = getStats(attacker).Knockdowns + 1
				end
			elseif kind == "EggStolen" and data.Attacker then
				local attacker = data.Attacker
				if attacker:IsA("Player") then
					getStats(attacker).Steals = getStats(attacker).Steals + 1
				end
			elseif kind == "DashFumble" and data.Player then
				-- Dash-fumbling the carrier counts as a steal for the dasher.
				local dasher = data.Player
				if dasher:IsA("Player") then
					getStats(dasher).Steals = getStats(dasher).Steals + 1
				end
			end
		end)
	else
		warn("[EconomyService] ServerScriptService.ServerFeedback missing -- knockdown/steal stats disabled")
	end

	Players.PlayerRemoving:Connect(function(player)
		matchStats[player] = nil
	end)

	print("[EconomyService] Initialized: match rewards (Clout + fragments + pity) live")
end

function EconomyService.DebugState()
	local parts = {}
	for player, stats in pairs(matchStats) do
		if player.Parent then
			table.insert(parts, ("%s[kd=%d steals=%d]"):format(
				player.Name, stats.Knockdowns, stats.Steals))
		end
	end
	table.sort(parts)
	return #parts > 0 and table.concat(parts, ", ") or "(no stats yet)"
end

return EconomyService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX44">
<Properties>
	<string name="Name">EggService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	EggService (ServerScriptService.EggService)
	===========================================
	Server-authoritative egg system: spawn, auto-pickup, carry, hold time,
	fumble, and out-of-arena respawn. Visuals are intentionally simple (a
	glowing sphere); every cosmetic moment fires FeedbackEvent so polish can
	hook in later without touching this module.

	Behaviour summary
	-----------------
	Spawn     : A ball Part is created once at Init() and respawned at
	            Workspace.Arena.EggSpawnPoint on StartRound() / after being
	            lost. (Later, MatchService calls StartRound()/EndRound().)
	Pickup    : Loose egg + character touch (or proximity scan backup) ->
	            that player becomes the carrier. No button. The egg is welded
	            in front of the torso, CanCollide/CanTouch turn off and the
	            Player gets attribute HasEgg = true. NOTE: the carry speed
	            penalty (Config.CarrySpeed) is applied by CombatService, which
	            owns all WalkSpeed math (carry/block/dash/stun modifiers).
	Hold time : The current carrier accrues seconds on the service ticker.
	            HoldTimeUpdated broadcasts every Config.HoldTimeSyncInterval
	            (only while carried, plus one final push after changes).
	Fumble    : EggService.Fumble(target, reason [, popVelocity]) detaches
	            the egg, drops it loose at the carrier's position, clears
	            HasEgg. Also fires automatically on death, respawn and
	            leaving the game.
	Throw     : EggService.ReleaseThrow(player, direction) launches the egg
	            (CombatService validates the request first). For a short
	            window the thrown egg is "hot": it knocks players back and
	            bounces loose instead of being caught; once it slows down it
	            is a normal loose egg again (loose-pickup only for now).
	Loose egg : Unclaimed for Config.EggRespawnDelay while away from the
	            center pad, OR out of bounds (below Config.EggOutOfBoundsY /
	            past Config.EggOutOfBoundsHorizontal) -> respawns at center.
	            Hold time is paused whenever the egg is loose (nobody carries).

	Remote payloads (server -> all clients)
	---------------------------------------
	EggPossessionChanged(newCarrier: Player?, previousCarrier: Player?)
	HoldTimeUpdated(entries)  -- array of {Player = Player, HoldTime = number},
	                          -- sorted by HoldTime descending (leaderboard order)
	FeedbackEvent(kind, data) -- kinds fired here: "EggPickup", "EggFumble",
	                          -- "EggOutOfBounds", "EggRespawn", "EggThrown",
	                          -- "EggImpact"

	Debugging from the Studio command bar while playing (the command bar runs
	in CLIENT context, so use the DebugCommand remote in ReplicatedStorage):
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble")
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble", "PlayerName")
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("respawn_egg")
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("state")
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
-- Shared participant roster: real Players + bot Models (BotService builds
-- them; BotRegistry is dependency-free so requiring it is always safe).
local BotRegistry = require(ServerScriptService:WaitForChild("BotRegistry"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local EggPossessionChanged = Remotes:WaitForChild("EggPossessionChanged")
local HoldTimeUpdated = Remotes:WaitForChild("HoldTimeUpdated")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local EggService = {}

---------------------------------------------------------------------------
-- Runtime state (server only)
---------------------------------------------------------------------------

-- Egg state machine.
local STATE_MISSING = "Missing"         -- egg part not created yet
local STATE_LOOSE = "Loose"             -- free in the world, pickable
local STATE_CARRIED = "Carried"         -- welded to the carrier
local STATE_RESPAWNING = "Respawning"   -- lost/out of bounds, hidden, counting down

local TICK_INTERVAL = math.max(0.05, Config.HoldTimeSyncInterval)

local egg = nil                  -- BasePart
local state = STATE_MISSING
local carrier = nil              -- Player?
local carryWeld = nil            -- WeldConstraint?

local holdTimes = {}             -- { [Player] = seconds }
local pickupLockout = {}         -- { [Player] = os.clock() earliest re-grab }
local looseSince = nil           -- os.clock() when the egg became loose
local respawnAt = nil            -- os.clock() when STATE_RESPAWNING completes
local thrower = nil              -- Player? who last threw the egg (self-pickup lockout)
local thrownHotUntil = 0         -- os.clock() deadline for the thrown egg's impact window
local impactHandler = nil        -- function(player, eggVelocity) injected by Main (CombatService)
local pickupsEnabled = true      -- MatchService gates this: pickups only during RoundPlaying
local broadcastNeeded = false    -- push one more HoldTimeUpdated after a change
local lastTickTime = 0
local initialized = false

---------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------

local function now()
	return os.clock()
end

local function getSpawnPointPosition()
	local arena = Workspace:FindFirstChild("Arena")
	local point = arena and arena:FindFirstChild("EggSpawnPoint")
	if point and point:IsA("BasePart") then
		return point.Position
	end
	warn("[EggService] Workspace.Arena.EggSpawnPoint missing; falling back to world origin")
	return Vector3.new(0, Config.ArenaEggSpawnHeight, 0)
end

local function getTorso(character)
	if not character then
		return nil
	end
	return character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
end

local function getAliveHumanoid(character)
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

-- Server-side mirror of every feedback event (Main creates the bindable;
-- EconomyService listens for knockdown/steal counting). Cached lazily;
-- `false` means "looked, not there" so we never re-search every tick.
local serverFeedback = nil

local function broadcastFeedback(kind, data)
	if serverFeedback == nil then
		serverFeedback = ServerScriptService:FindFirstChild("ServerFeedback") or false
	end
	if serverFeedback then
		serverFeedback:Fire(kind, data or {})
	end
	FeedbackEvent:FireAllClients(kind, data or {})
end

local function broadcastPossession(newCarrier, previousCarrier)
	broadcastNeeded = true
	EggPossessionChanged:FireAllClients(newCarrier, previousCarrier)
end

-- A thrown egg stays "hot" for a short window (and while still fast): it
-- knocks players back instead of being picked up.
local function isEggHot()
	return state == STATE_LOOSE
		and egg ~= nil
		and thrownHotUntil > now()
		and egg.AssemblyLinearVelocity.Magnitude >= Config.EggThrowImpactMinSpeed
end

local function createEgg()
	local part = Instance.new("Part")
	part.Name = "Egg"
	part.Shape = Enum.PartType.Ball
	-- Slightly egg-shaped sphere (taller than wide), sized from Config.
	local diameter = Config.EggRadius * 2
	part.Size = Vector3.new(diameter * 0.9, diameter * 1.15, diameter * 0.9)
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 214, 90)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	-- Light, slippery and a little bouncy: rolls around the arena nicely.
	part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
	part.Anchored = true -- released by applyLooseVisual()/spawnAtCenter()
	part.CanCollide = false
	part.CanTouch = false

	-- "Slightly glowing": a soft point light so the egg reads from anywhere.
	local light = Instance.new("PointLight")
	light.Brightness = 0.8
	light.Range = 10
	light.Color = part.Color
	light.Parent = part

	part.Parent = Workspace
	return part
end

local function applyLooseVisual()
	egg.Transparency = 0
	egg.Anchored = false
	egg.CanCollide = true
	egg.CanTouch = true
end

local function applyHiddenVisual()
	egg.Transparency = 1
	egg.Anchored = true
	egg.CanCollide = false
	egg.CanTouch = false
end

local function applyCarriedVisual()
	egg.Transparency = 0
	egg.CanCollide = false -- never fight the weld or snag on walls
	egg.CanTouch = false   -- only LOOSE eggs are pickable
end

---------------------------------------------------------------------------
-- State transitions
---------------------------------------------------------------------------

-- Forward declaration so spawnAtCenter/scheduleRespawn can reference it.
local scheduleRespawn

local function spawnAtCenter()
	if not egg then
		return
	end
	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end

	local spawnPosition = getSpawnPointPosition()
	applyLooseVisual()
	egg.CFrame = CFrame.new(spawnPosition)
	egg.AssemblyLinearVelocity = Vector3.zero
	egg.AssemblyAngularVelocity = Vector3.zero

	state = STATE_LOOSE
	looseSince = now()
	respawnAt = nil
	thrower = nil
	thrownHotUntil = 0
	pickupLockout = {} -- fresh center drop: everyone may contest it
	broadcastNeeded = true

	broadcastFeedback("EggRespawn", { Position = spawnPosition })
	if Config.DebugVerboseLogging then
		print("[EggService] Egg respawned at center")
	end
end

-- Egg is lost (out of bounds): hide it and respawn at center after
-- Config.EggRespawnDelay seconds.
scheduleRespawn = function()
	if not egg or state == STATE_RESPAWNING then
		return
	end
	state = STATE_RESPAWNING
	respawnAt = now() + Config.EggRespawnDelay
	applyHiddenVisual()
	looseSince = nil
	broadcastNeeded = true

	broadcastFeedback("EggOutOfBounds", { Position = egg.Position })
	if Config.DebugVerboseLogging then
		print("[EggService] Egg out of bounds; respawning in " .. Config.EggRespawnDelay .. "s")
	end
end

---------------------------------------------------------------------------
-- Pickup
---------------------------------------------------------------------------

local function tryPickup(player)
	-- All guards first: no yields inside this function, so two touches in the
	-- same frame can never produce two carriers.
	if not pickupsEnabled then
		return false -- match is not in RoundPlaying
	end
	if state ~= STATE_LOOSE or not egg then
		return false
	end
	if not BotRegistry.IsParticipant(player) then
		return false -- spectators (>MaxPlayers servers) and junk cannot grab
	end

	local lockUntil = pickupLockout[player]
	if lockUntil and now() < lockUntil then
		return false -- just fumbled/threw it or just got beaned: cannot instantly re-grab
	end

	-- A hot thrown egg is not catchable (yet) -- it impacts instead.
	if isEggHot() and player ~= thrower then
		return false
	end

	-- Works for Players (their Character) and bots (the Model itself).
	local character = BotRegistry.GetCharacter(player)
	local humanoid = getAliveHumanoid(character)
	local torso = getTorso(character)
	if not humanoid or not torso then
		return false
	end

	-- Become the carrier.
	carrier = player
	state = STATE_CARRIED
	looseSince = nil

	applyCarriedVisual()
	egg.AssemblyLinearVelocity = Vector3.zero
	egg.AssemblyAngularVelocity = Vector3.zero
	-- Held out in front of the chest, clearly visible to everyone.
	egg.CFrame = torso.CFrame * CFrame.new(0, Config.EggCarryOffsetUp, -Config.EggCarryOffsetForward)

	carryWeld = Instance.new("WeldConstraint")
	carryWeld.Part0 = torso
	carryWeld.Part1 = egg
	carryWeld.Parent = egg

	-- Carry penalty (Config.CarrySpeed) is applied by CombatService, which
	-- watches the HasEgg attribute and owns all WalkSpeed math.
	player:SetAttribute("HasEgg", true)
	if holdTimes[player] == nil then
		holdTimes[player] = 0
	end

	broadcastPossession(player, nil)
	broadcastFeedback("EggPickup", { Player = player, Position = egg.Position })

	if Config.DebugVerboseLogging then
		print("[EggService] " .. player.Name .. " picked up the egg")
	end
	return true
end

local function onEggTouched(hit)
	if state ~= STATE_LOOSE or not egg then
		return
	end
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and (Players:GetPlayerFromCharacter(character)
		or BotRegistry.GetBotFromCharacter(character))
	if not player or not BotRegistry.IsParticipant(player) then
		return
	end

	-- Hot thrown egg: knock the struck player back (via the injected
	-- CombatService handler), defuse the egg and bounce it loose.
	if isEggHot() and player ~= thrower then
		local impactVelocity = egg.AssemblyLinearVelocity
		thrownHotUntil = 0 -- defuse: it is a normal loose egg again
		pickupLockout[player] = now() + Config.EggImpactPickupDelay
		egg.AssemblyLinearVelocity = impactVelocity * -0.2 + Vector3.new(0, 5, 0)
		broadcastFeedback("EggImpact", { Player = player, Position = egg.Position })
		if impactHandler then
			impactHandler(player, impactVelocity)
		end
		return
	end

	tryPickup(player)
end

---------------------------------------------------------------------------
-- Fumble / drop
---------------------------------------------------------------------------

local function doFumble(player, reason, popVelocity)
	if carrier ~= player or not egg then
		return false -- idempotent: Died + CharacterRemoving can both fire
	end
	local previousCarrier = carrier
	carrier = nil

	previousCarrier:SetAttribute("HasEgg", false)
	-- WalkSpeed restoration happens in CombatService (HasEgg attribute watch).

	-- Detach from the torso.
	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end
	thrower = nil
	thrownHotUntil = 0

	-- Place the egg loose at the carrier's position (slightly forward+up so
	-- it does not spawn inside the character), clamped inside the arena so a
	-- fumble against a wall cannot push it out of bounds.
	local carrierCharacter = BotRegistry.GetCharacter(previousCarrier)
	local root = carrierCharacter and carrierCharacter:FindFirstChild("HumanoidRootPart")
	local dropPosition
	if root then
		dropPosition = root.CFrame:PointToWorldSpace(Vector3.new(0, 1, -2))
	else
		dropPosition = egg.Position + Vector3.new(0, 1, 0)
	end
	local halfBounds = Config.ArenaPlaySize / 2 - Config.EggRadius - 0.5
	dropPosition = Vector3.new(
		math.clamp(dropPosition.X, -halfBounds, halfBounds),
		dropPosition.Y,
		math.clamp(dropPosition.Z, -halfBounds, halfBounds)
	)

	applyLooseVisual()
	egg.CFrame = CFrame.new(dropPosition)
	egg.AssemblyLinearVelocity = popVelocity or Vector3.new(0, Config.EggFumblePop, 0)
	egg.AssemblyAngularVelocity = Vector3.zero

	state = STATE_LOOSE
	looseSince = now()

	-- The dropper cannot instantly re-grab their own fumble.
	pickupLockout[previousCarrier] = now() + Config.ThrowSelfPickupDelay

	broadcastPossession(nil, previousCarrier)
	broadcastFeedback("EggFumble", {
		Player = previousCarrier,
		Reason = reason or "Unknown",
		Position = egg.Position,
	})

	if Config.DebugVerboseLogging then
		print("[EggService] " .. previousCarrier.Name .. " fumbled the egg (" .. tostring(reason) .. ")")
	end
	return true
end

---------------------------------------------------------------------------
-- Player lifecycle (death / respawn / leaving drops the egg)
---------------------------------------------------------------------------

local function bindCharacter(player, character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	if humanoid then
		-- Base WalkSpeed on (re)spawn is applied by CombatService, which owns
		-- all speed modifiers (carry / block / dash / stun).
		humanoid.Died:Connect(function()
			doFumble(player, "Died")
		end)
	end
end

local function bindPlayer(player)
	player:SetAttribute("HasEgg", false)
	broadcastNeeded = true -- late joiner: push the current hold-time table once

	player.CharacterAdded:Connect(function(character)
		bindCharacter(player, character)
	end)

	-- Covers deaths, manual respawns and teleports.
	player.CharacterRemoving:Connect(function()
		doFumble(player, "CharacterRemoved")
	end)
end

local function onPlayerRemoving(player)
	doFumble(player, "Left")
	holdTimes[player] = nil
	pickupLockout[player] = nil
end

---------------------------------------------------------------------------
-- Ticker: hold time, world checks, proximity pickup, broadcasts (10 Hz)
---------------------------------------------------------------------------

local function tickOnce()
	local currentTime = now()
	local dt = currentTime - lastTickTime
	lastTickTime = currentTime
	-- Clamp so a server hitch cannot award a burst of hold time.
	if dt > TICK_INTERVAL * 3 then
		dt = TICK_INTERVAL * 3
	end

	-- 1) Hold time accrues for the carrier only (pauses automatically while
	--    the egg is loose/respawning -- there is no carrier then).
	if carrier and state == STATE_CARRIED then
		holdTimes[carrier] = (holdTimes[carrier] or 0) + dt
	end

	if egg then
		if state == STATE_LOOSE then
			local position = egg.Position

			-- 2a) Fell out of the arena?
			if position.Y < Config.EggOutOfBoundsY
				or math.abs(position.X) > Config.EggOutOfBoundsHorizontal
				or math.abs(position.Z) > Config.EggOutOfBoundsHorizontal
			then
				scheduleRespawn()
			elseif looseSince and (currentTime - looseSince) >= Config.EggRespawnDelay then
				-- 2b) Unclaimed timeout: reset to center, unless it is already
				-- resting on the center pad (no annoying idle pop-loop there).
				local centerOffset = Vector3.new(position.X, 0, position.Z).Magnitude
				if centerOffset > Config.EggLooseResetRadius then
					spawnAtCenter()
				else
					looseSince = currentTime -- parked at center: restart the clock
				end
			end
		elseif state == STATE_RESPAWNING then
			-- 2c) Respawn countdown finished?
			if respawnAt and currentTime >= respawnAt then
				spawnAtCenter()
			end
		end

		-- 3) Proximity pickup scan: cheap backup to Touched so grabs also
		--    register reliably at low framerates / on mobile.
		--    TODO(polish): add line-of-sight check so it cannot grab through walls.
		if state == STATE_LOOSE then
			for _, entity in ipairs(BotRegistry.GetParticipants()) do
				local character = BotRegistry.GetCharacter(entity)
				local humanoid = getAliveHumanoid(character)
				if humanoid then
					local root = character:FindFirstChild("HumanoidRootPart")
					if root
						and (root.Position - egg.Position).Magnitude <= Config.EggProximityPickupRadius
					then
						if tryPickup(entity) then
							break -- one pickup per tick maximum
						end
					end
				end
			end
		end
	end

	-- 4) Broadcast hold times: continuously while carried (live leaderboard),
	--    plus one final push after any possession change.
	if state == STATE_CARRIED or broadcastNeeded then
		local entries = {}
		for player, time in pairs(holdTimes) do
			if player.Parent then
				table.insert(entries, { Player = player, HoldTime = time })
			else
				holdTimes[player] = nil -- scrub players who slipped out
			end
		end
		table.sort(entries, function(a, b)
			return a.HoldTime > b.HoldTime
		end)
		HoldTimeUpdated:FireAllClients(entries)
		broadcastNeeded = false
	end
end

local function startTicker()
	task.spawn(function()
		lastTickTime = now()
		while initialized do
			tickOnce()
			task.wait(TICK_INTERVAL)
		end
	end)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function EggService.Init()
	if initialized then
		return
	end
	initialized = true

	egg = createEgg()
	egg.Touched:Connect(onEggTouched)

	for _, player in ipairs(Players:GetPlayers()) do
		bindPlayer(player)
		if player.Character then
			bindCharacter(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- No MatchService yet: spawn the egg immediately so the arena is live.
	-- Once MatchService exists it will call StartRound()/EndRound() instead.
	spawnAtCenter()
	startTicker()

	print("[EggService] Initialized: egg spawned at center (auto-pickup live)")
end

-- Called by MatchService (later) at the start of every round.
function EggService.StartRound()
	if carrier then
		doFumble(carrier, "RoundStart")
	end
	spawnAtCenter()
end

-- Called by MatchService (later) at the end of every round: fumble any
-- carrier and park the egg at center for the results pause.
function EggService.EndRound()
	if carrier then
		doFumble(carrier, "RoundEnd")
	end
	spawnAtCenter()
end

-- MatchService gate: pickups are only allowed while a round is playing.
-- The egg stays visible at center between rounds but cannot be grabbed.
function EggService.SetEnabled(enabled)
	pickupsEnabled = (enabled == true)
end

function EggService.IsEnabled()
	return pickupsEnabled
end

-- Current carrier (Player?) -- the hook ScoringService/GUI read.
function EggService.GetCarrier()
	return carrier
end

-- The egg Part itself (may be hidden while respawning).
function EggService.GetEgg()
	return egg
end

-- Internal state string: "Loose" | "Carried" | "Respawning" | "Missing".
function EggService.GetState()
	return state
end

-- Accumulated hold seconds for one player this match.
function EggService.GetHoldTime(player)
	return holdTimes[player] or 0
end

-- Shallow copy of { [Player] = seconds } for ScoringService snapshots.
function EggService.GetHoldTimes()
	local copy = {}
	for player, time in pairs(holdTimes) do
		if player.Parent then
			copy[player] = time
		end
	end
	return copy
end

-- Full-match reset (new match, not new round -- per-round bookkeeping is
-- ScoringService's job).
function EggService.ResetHoldTimes()
	holdTimes = {}
	broadcastNeeded = true
end

--[[
	Drop the egg.

	EggService.Fumble(target?, reason?, popVelocity?)
	  target       : Player | player name | nil (nil = whoever carries it now)
	  reason       : string for logs/feedback ("Attacked", "DashCollision", ...)
	  popVelocity  : optional Vector3 launch velocity (CombatService will pass
	                 the knock-loose pop when attacks land)

	Also callable as EggService:Fumble(target, reason) -- an accidental `self`
	first argument is detected and shifted out.
]]
function EggService.Fumble(target, reason, popVelocity)
	if target == EggService then -- colon-call: shift the implicit self away
		target, reason, popVelocity = reason, popVelocity, nil
	end

	if target == nil then
		target = carrier
	end
	if typeof(target) == "string" then
		local resolved = Players:FindFirstChild(target)
		if not resolved then
			for _, model in ipairs(BotRegistry.GetBots()) do
				if model.Name == target then
					resolved = model
					break
				end
			end
		end
		target = resolved
	end
	if not BotRegistry.IsParticipant(target) then
		warn("[EggService] Fumble: could not resolve target (" .. tostring(target) .. ")")
		return false
	end
	if not carrier then
		warn("[EggService] Fumble: nobody is carrying the egg")
		return false
	end
	if target ~= carrier then
		warn("[EggService] Fumble: " .. target.Name .. " is not the carrier ("
			.. carrier.Name .. " is)")
		return false
	end
	if popVelocity ~= nil and typeof(popVelocity) ~= "Vector3" then
		warn("[EggService] Fumble: popVelocity must be a Vector3; ignoring it")
		popVelocity = nil
	end

	return doFumble(carrier, reason or "Manual", popVelocity)
end

-- Force the egg back to center immediately (debug / round flow).
function EggService.RespawnEggNow()
	if not egg then
		return
	end
	if carrier then
		doFumble(carrier, "ForcedRespawn")
	end
	spawnAtCenter()
end

--[[
	Throw the egg. Called by CombatService AFTER it has validated the request
	(caller must be the carrier, alive, not stunned).

	EggService.ReleaseThrow(player, direction)
	  player    : the current carrier
	  direction : Vector3 launch direction (unit-ized internally); the lob comes
	              from Config.ThrowUpwardBias added on top of Config.ThrowSpeed

	Possession ends immediately (hold time stops). The egg is "hot" for
	Config.EggThrowDangerTime / until it slows below Config.EggThrowImpactMinSpeed:
	hitting a player knocks them back and bounces the egg loose instead of being
	caught. The thrower is locked out of re-grabbing (ThrowSelfPickupDelay).
]]
function EggService.ReleaseThrow(player, direction)
	if carrier ~= player or not egg then
		return false
	end
	if typeof(direction) ~= "Vector3" or direction.Magnitude < 0.001 then
		direction = Vector3.new(0, 0, -1)
	end
	direction = direction.Unit

	local previousCarrier = carrier
	carrier = nil
	previousCarrier:SetAttribute("HasEgg", false)

	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end

	-- The egg is already welded in front of the chest; launch from there.
	applyLooseVisual()
	egg.AssemblyAngularVelocity = Vector3.zero
	egg.AssemblyLinearVelocity = direction * Config.ThrowSpeed
		+ Vector3.new(0, Config.ThrowUpwardBias, 0)

	state = STATE_LOOSE
	looseSince = now()
	thrower = previousCarrier
	thrownHotUntil = now() + Config.EggThrowDangerTime
	pickupLockout[previousCarrier] = now() + Config.ThrowSelfPickupDelay
	broadcastNeeded = true

	broadcastPossession(nil, previousCarrier)
	broadcastFeedback("EggThrown", {
		Player = previousCarrier,
		Direction = direction,
		Position = egg.Position,
	})

	if Config.DebugVerboseLogging then
		print("[EggService] " .. previousCarrier.Name .. " threw the egg")
	end
	return true
end

-- True while a thrown egg would knock players back instead of being caught.
function EggService.IsEggHot()
	return isEggHot()
end

-- Who last threw the egg (Player?) -- used for throw-impact exemptions.
function EggService.GetThrower()
	return thrower
end

-- Main injects CombatService.HandleEggImpact here. Dependency injection keeps
-- the require graph one-directional (CombatService -> EggService only).
function EggService.SetImpactHandler(handler)
	impactHandler = (typeof(handler) == "function") and handler or nil
end

-- One-line snapshot for the console / DebugCommands "state".
function EggService.DebugState()
	local parts = {}
	for player, time in pairs(holdTimes) do
		if player.Parent then
			table.insert(parts, player.Name .. "=" .. string.format("%.1f", time) .. "s")
		end
	end
	table.sort(parts)
	local carrierName = carrier and carrier.Name or "nobody"
	local timesText = #parts > 0 and table.concat(parts, ", ") or "(none)"
	return "state=" .. state .. " | carrier=" .. carrierName .. " | holdTimes: " .. timesText
end

return EggService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX45">
<Properties>
	<string name="Name">HatcheryService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	HatcheryService (ServerScriptService.HatcheryService)
	=====================================================
	The egg/pet economy on the server:

	  * BUY an egg with Clout (Config.Economy.EggCloutCost)
	  * CONVERT 10 Egg Fragments into an egg (Config.Economy.EggFragmentCost)
	  * Every egg carries a hatch timer (Config.Economy.HatchTimeSeconds);
	    opening a READY egg rolls a pet: rarity (weighted), size, optional
	    mutation, and a tiny capped grip bonus (Config.Pets.GripByRarity).
	  * Pity eggs (granted by EconomyService after 10 winless matches + a
	    round win) roll from RareGuaranteedWeights instead.
	  * Pets live in the player's data profile (DataService) -- persisted.
	  * Equipped pet's grip = % chance to survive a punch that would knock
	    the egg loose (CombatService calls GetGripBonus). Cosmetic flex:
	    the equipped pet shows in leaderstats.

	Remotes:
	  HatcheryRequest  (client -> server): action [, id]
	    actions: "BuyEgg" | "ConvertFragments" | "OpenEgg" <eggId>
	           | "EquipPet" <petId> | "Refresh"
	  HatcheryUpdated  (server -> client): full profile snapshot
	  FeedbackEvent    (server -> one client): "PetHatched" {Pet}
	                                     ... "EggGranted" {Egg}

	ALL validation is server-side; clients only ask.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local DataService = require(ServerScriptService:WaitForChild("DataService"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local HatcheryRequest = Remotes:WaitForChild("HatcheryRequest")
local HatcheryUpdated = Remotes:WaitForChild("HatcheryUpdated")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local HatcheryService = {}

local idCounter = 0
local initialized = false

local function nextId(prefix)
	idCounter = idCounter + 1
	return ("%s_%d_%d"):format(prefix, os.time(), idCounter)
end

local function personalFeedback(player, kind, data)
	if player:IsA("Player") then
		FeedbackEvent:FireClient(player, kind, data or {})
	end
end

function HatcheryService.SendSnapshot(player)
	local snapshot = DataService.GetSnapshot(player)
	if snapshot then
		HatcheryUpdated:FireClient(player, snapshot)
	end
end

---------------------------------------------------------------------------
-- Egg creation
---------------------------------------------------------------------------

local function addEgg(player, source, guaranteedRare)
	local profile = DataService.GetProfile(player)
	if not profile then
		return nil
	end
	local egg = {
		Id = nextId("egg"),
		Source = source or "Bought",          -- Bought | Converted | Pity | Debug
		GuaranteedRare = guaranteedRare and true or false,
		UnlocksAt = os.time() + Config.Economy.HatchTimeSeconds,
	}
	table.insert(profile.Eggs, egg)
	personalFeedback(player, "EggGranted", { Egg = egg })
	HatcheryService.SendSnapshot(player)
	if Config.DebugVerboseLogging then
		print(("[Hatchery] %s got a %s egg (ready in %ds)"):format(
			player.Name, egg.GuaranteedRare and "guaranteed-rare" or "mystery",
			Config.Economy.HatchTimeSeconds))
	end
	return egg
end

-- EconomyService (pity wins) and debug commands call this.
function HatcheryService.GrantEgg(player, source, guaranteedRare)
	return addEgg(player, source, guaranteedRare)
end

---------------------------------------------------------------------------
-- Pet rolling
---------------------------------------------------------------------------

local function pickWeighted(weights)
	local total = 0
	for _, weight in pairs(weights) do
		total = total + weight
	end
	if total <= 0 then
		return nil
	end
	local roll = math.random() * total
	for name, weight in pairs(weights) do
		roll = roll - weight
		if roll <= 0 then
			return name
		end
	end
	return nil
end

local function pickFrom(list)
	return list[math.random(1, #list)]
end

local function rollPet(guaranteedRare)
	local rarity = pickWeighted(guaranteedRare
		and Config.Pets.RareGuaranteedWeights
		or Config.Pets.RarityWeights) or "Common"
	local species = pickFrom(Config.Pets.Species)
	local mutation = nil
	if math.random() < Config.Pets.MutationChance then
		mutation = pickFrom(Config.Pets.Mutations)
	end
	local grip = math.min(
		Config.Pets.GripByRarity[rarity] or 0,
		Config.Pets.MaxGripBonus
	)
	local name = (mutation and (mutation .. " ") or "") .. species
	return {
		Id = nextId("pet"),
		Name = name,
		Species = species,
		Rarity = rarity,
		Size = pickFrom(Config.Pets.Sizes),
		Mutation = mutation,
		GripBonus = grip,
		CreatedAt = os.time(),
	}
end

---------------------------------------------------------------------------
-- Actions (all server-validated)
---------------------------------------------------------------------------

local function buyEgg(player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.Clout < Config.Economy.EggCloutCost then
		personalFeedback(player, "NotEnoughClout", {
			Need = Config.Economy.EggCloutCost, Have = math.floor(profile.Clout) })
		return
	end
	DataService.AddClout(player, -Config.Economy.EggCloutCost)
	addEgg(player, "Bought", false)
end

local function convertFragments(player)
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	if profile.Fragments < Config.Economy.EggFragmentCost then
		personalFeedback(player, "NotEnoughFragments", {
			Need = Config.Economy.EggFragmentCost, Have = math.floor(profile.Fragments) })
		return
	end
	DataService.AddFragments(player, -Config.Economy.EggFragmentCost)
	addEgg(player, "Converted", false)
end

local function openEgg(player, eggId)
	local profile = DataService.GetProfile(player)
	if not profile or type(eggId) ~= "string" then
		return
	end
	local eggIndex = nil
	for index, egg in ipairs(profile.Eggs) do
		if egg.Id == eggId then
			eggIndex = index
			break
		end
	end
	if not eggIndex then
		return
	end
	local egg = profile.Eggs[eggIndex]
	if os.time() < (egg.UnlocksAt or 0) then
		personalFeedback(player, "EggNotReady", { ReadyAt = egg.UnlocksAt })
		return
	end

	table.remove(profile.Eggs, eggIndex)
	local pet = rollPet(egg.GuaranteedRare == true)
	table.insert(profile.Pets, pet)

	-- First pet auto-equips.
	if not profile.EquippedPetId then
		DataService.Set(player, "EquippedPetId", pet.Id)
	end

	personalFeedback(player, "PetHatched", { Pet = pet })
	HatcheryService.SendSnapshot(player)
	if Config.DebugVerboseLogging then
		print(("[Hatchery] %s hatched %s (%s, %s, grip +%.1f%%)"):format(
			player.Name, pet.Name, pet.Rarity, pet.Size, pet.GripBonus))
	end
end

local function equipPet(player, petId)
	local profile = DataService.GetProfile(player)
	if not profile or type(petId) ~= "string" then
		return
	end
	for _, pet in ipairs(profile.Pets) do
		if pet.Id == petId then
			DataService.Set(player, "EquippedPetId", petId)
			HatcheryService.SendSnapshot(player)
			return
		end
	end
end

---------------------------------------------------------------------------
-- Grip bonus (CombatService consults this on would-be steals)
---------------------------------------------------------------------------

function HatcheryService.GetGripBonus(entity)
	if entity == nil or not entity:IsA("Player") then
		return 0 -- bots have no pets
	end
	local profile = DataService.GetProfile(entity)
	if not profile or not profile.EquippedPetId then
		return 0
	end
	for _, pet in ipairs(profile.Pets) do
		if pet.Id == profile.EquippedPetId then
			return math.min(pet.GripBonus or 0, Config.Pets.MaxGripBonus)
		end
	end
	return 0
end

function HatcheryService.GetEquippedPet(player)
	local profile = DataService.GetProfile(player)
	if not profile or not profile.EquippedPetId then
		return nil
	end
	for _, pet in ipairs(profile.Pets) do
		if pet.Id == profile.EquippedPetId then
			return pet
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Init
---------------------------------------------------------------------------

function HatcheryService.Init()
	if initialized then
		return
	end
	initialized = true

	HatcheryRequest.OnServerEvent:Connect(function(player, action, id)
		if type(action) ~= "string" then
			return
		end
		if not DataService.IsLoaded(player) then
			personalFeedback(player, "DataNotReady", {})
			return
		end
		if action == "BuyEgg" then
			buyEgg(player)
		elseif action == "ConvertFragments" then
			convertFragments(player)
		elseif action == "OpenEgg" then
			openEgg(player, id)
		elseif action == "EquipPet" then
			equipPet(player, id)
		elseif action == "Refresh" then
			HatcheryService.SendSnapshot(player)
		end
	end)

	-- Send a snapshot as soon as each profile finishes loading.
	DataService.OnProfileReady(function(player)
		HatcheryService.SendSnapshot(player)
	end)

	print("[HatcheryService] Initialized: buy/convert/hatch/equip live")
end

function HatcheryService.DebugState()
	local eggs, pets = 0, 0
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = DataService.GetProfile(player)
		if profile then
			eggs = eggs + #profile.Eggs
			pets = pets + #profile.Pets
		end
	end
	return ("eggs-hatching=%d pets-owned=%d"):format(eggs, pets)
end

return HatcheryService
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX46">
<Properties>
	<bool name="Disabled">false</bool>
	<string name="Name">Main</string>
	<ProtectedString name="Source"><![CDATA[--[[
	Main (ServerScriptService.Main)
	===============================
	Server bootstrap. Runs once when the server starts.

	  1. Creates ServerScriptService.ServerFeedback (BindableEvent) -- the
	     server-side mirror of every FeedbackEvent (EconomyService counts
	     knockdowns/steals through it). MUST exist before services init.
	  2. Verifies the static Remotes tree exists (ReplicatedStorage.Remotes).
	  3. Initializes the service modules IN ORDER:
	       Data -> Egg -> Combat -> Scoring -> Hatchery -> Economy
	       -> Bots -> Matchmaking -> AntiCheat -> Match (last: its loop
	          starts immediately and orchestrates everything).
	  4. Cross-service wiring (dependency injection, one-directional graph):
	       * EggService  -> CombatService.HandleEggImpact (thrown-egg hits)
	       * MatchService-> EconomyService.ResetMatchStats / SettleMatch
	       * HatcheryService <- DataService.OnProfileReady (snapshot push)
	  5. Debug bridges (STUDIO ONLY, gated by Config.DebugAllowCommandBar):

	     a) ReplicatedStorage.Remotes.DebugCommand (RemoteEvent) -- from the
	        Studio command bar while PLAYING (client context):

	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble")
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("respawn_egg")
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("state")
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("grantegg")        -- mystery egg
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("grantegg", "rare")-- guaranteed rare
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("clout", "1000")   -- add clout
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("frags", "10")     -- add fragments
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("hatchnow")        -- finish hatch timers

	     b) ServerScriptService.DebugCommands (BindableEvent) -- same from
	        server-side code / "Run" mode.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

-- 1) Server-side feedback mirror (created BEFORE any service initializes).
local debugCommands = Instance.new("BindableEvent")
debugCommands.Name = "DebugCommands"
debugCommands.Parent = ServerScriptService

local serverFeedback = Instance.new("BindableEvent")
serverFeedback.Name = "ServerFeedback"
serverFeedback.Parent = ServerScriptService

-- 2) Verify remotes (static instances declared in default.project.json)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local EXPECTED_REMOTES = {
	-- client -> server (input requests; server validates everything)
	"RequestAttack",
	"RequestThrow",
	"RequestDash",
	"RequestBlockStart",
	"RequestBlockEnd",
	"RequestSprintStart",
	"RequestSprintEnd",
	-- server -> client (replicated state + polish hooks)
	"EggPossessionChanged",
	"HoldTimeUpdated",
	"MatchStateChanged",
	"RoundEnded",
	"MatchEnded",
	"FeedbackEvent",
	-- meta layer (economy / hatchery)
	"MatchRewards",
	"HatcheryRequest",
	"HatcheryUpdated",
	-- studio-only debug bridge (see below)
	"DebugCommand",
}

for _, name in EXPECTED_REMOTES do
	if not Remotes:WaitForChild(name, 10) then
		warn("[Main] Missing remote: " .. name)
	end
end

-- 3) Require + initialize services
local DataService = require(ServerScriptService:WaitForChild("DataService"))
local EggService = require(ServerScriptService:WaitForChild("EggService"))
local CombatService = require(ServerScriptService:WaitForChild("CombatService"))
local ScoringService = require(ServerScriptService:WaitForChild("ScoringService"))
local HatcheryService = require(ServerScriptService:WaitForChild("HatcheryService"))
local EconomyService = require(ServerScriptService:WaitForChild("EconomyService"))
local BotService = require(ServerScriptService:WaitForChild("BotService"))
local MatchmakingService = require(ServerScriptService:WaitForChild("MatchmakingService"))
local AntiCheatService = require(ServerScriptService:WaitForChild("AntiCheatService"))
local MatchService = require(ServerScriptService:WaitForChild("MatchService"))

-- Init order matters: Data first (profiles feed everything meta), Match LAST
-- (its state machine starts immediately and drives the other services).
for _, service in ipairs({
	DataService, EggService, CombatService, ScoringService,
	HatcheryService, EconomyService, BotService, MatchmakingService,
	AntiCheatService, MatchService,
}) do
	if type(service.Init) == "function" then
		service.Init()
	end
end

-- 4) Cross-service wiring (dependency injection keeps requires acyclic).
EggService.SetImpactHandler(function(player, eggVelocity)
	CombatService.HandleEggImpact(player, eggVelocity)
end)
MatchService.SetMatchStartHandler(function()
	EconomyService.ResetMatchStats()
end)
MatchService.SetMatchEndHandler(function(final)
	EconomyService.SettleMatch(final)
end)

-- 5) Debug bridges (Studio only)
local function runDebugCommand(command, argument, player)
	if typeof(command) ~= "string" then
		warn('[Debug] usage: "fumble" | "respawn_egg" | "state" | "grantegg" '
			.. '| "clout" | "frags" | "hatchnow" [, argument]')
		return
	end
	command = command:lower()
	if command == "fumble" then
		EggService.Fumble(argument, "DebugCommand")
	elseif command == "respawn_egg" then
		EggService.RespawnEggNow()
	elseif command == "state" then
		print("[Debug] match : " .. MatchService.DebugState())
		print("[Debug] egg   : " .. EggService.DebugState())
		print("[Debug] combat: " .. CombatService.DebugState())
		print("[Debug] score : " .. ScoringService.DebugState())
		print("[Debug] bots  : " .. BotService.DebugState())
		print("[Debug] data  : " .. DataService.DebugState())
		print("[Debug] econ  : " .. EconomyService.DebugState())
		print("[Debug] hatch : " .. HatcheryService.DebugState())
		print("[Debug] queue : " .. MatchmakingService.DebugState())
		print("[Debug] cheat : " .. AntiCheatService.DebugState())
	elseif command == "grantegg" then
		if player then
			HatcheryService.GrantEgg(player, "Debug", argument == "rare")
		end
	elseif command == "clout" then
		if player then
			DataService.AddClout(player, tonumber(argument) or 1000)
			HatcheryService.SendSnapshot(player)
		end
	elseif command == "frags" then
		if player then
			DataService.AddFragments(player, tonumber(argument) or 10)
			HatcheryService.SendSnapshot(player)
		end
	elseif command == "hatchnow" then
		if player then
			local profile = DataService.GetProfile(player)
			if profile then
				for _, egg in ipairs(profile.Eggs) do
					egg.UnlocksAt = os.time()
				end
				HatcheryService.SendSnapshot(player)
			end
		end
	else
		warn('[Debug] unknown command "' .. command .. '"')
	end
end

-- a) RemoteEvent path -- reachable from the command bar during Play because
--    ReplicatedStorage replicates to the client. Hard-gated to Studio.
local debugRemote = Remotes:FindFirstChild("DebugCommand")
if debugRemote and debugRemote:IsA("RemoteEvent") then
	debugRemote.OnServerEvent:Connect(function(player, command, argument)
		if not (RunService:IsStudio() and Config.DebugAllowCommandBar) then
			return -- never trust debug commands outside Studio
		end
		runDebugCommand(command, argument, player)
	end)
else
	warn("[Main] Remotes.DebugCommand missing -- command-bar debugging unavailable")
end

-- b) BindableEvent path -- for server-side automation and "Run" mode.
debugCommands.Event:Connect(function(command, argument)
	runDebugCommand(command, argument, nil)
end)

print("[Clutch the Egg] Server bootstrap complete -- match + bots + economy + "
	.. "hatchery + matchmaking + anti-cheat live (Tasks 6-7)")
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX47">
<Properties>
	<string name="Name">MatchmakingService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	MatchmakingService (ServerScriptService.MatchmakingService)
	===========================================================
	Simple in-server ELO queue. The server gathers up to
	Config.MaxPlayers (6) players for the next match and prefers similar
	skill:

	  * Each waiting player has an ELO from DataService
	    (Config.Matchmaking.DefaultElo for fresh profiles).
	  * The queue SEED is the longest-waiting player. Everyone within
	    BaseRange + WidenPerSecond * secondsWaited (capped at MaxRange) of
	    the seed's ELO is eligible.
	  * Once 6 are eligible (or the seed has waited MaxWaitSeconds, or the
	    caller forces readiness -- bots fill the rest either way) the 6
	    closest-to-seed players are selected; the others wait for the next
	    match. With <= 6 players in the server (the normal case) everyone is
	    always selected and BotService tops the match up to 6.

	  * After each match, SettleMatch(final) applies EloByRank deltas to the
	    real players (bots excluded) and saves via DataService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local DataService = require(ServerScriptService:WaitForChild("DataService"))

local MatchmakingService = {}

local queueJoinedAt = {} -- { [Player] = os.clock() } arrival order for seeds
local initialized = false

local function now()
	return os.clock()
end

local function getElo(player)
	return DataService.GetElo(player) or Config.Matchmaking.DefaultElo
end

local function joinedAt(player)
	local time = queueJoinedAt[player]
	if not time then
		time = now()
		queueJoinedAt[player] = time
	end
	return time
end

--[[
	MatchmakingService.SelectParticipants(candidates, forceReady)
	  candidates : array of Players waiting in the lobby
	  forceReady : true = the lobby grace has elapsed, pick NOW even if the
	               skill window has not gathered 6 yet
	Returns an array of up to Config.MaxPlayers Players (possibly everyone),
]]
function MatchmakingService.SelectParticipants(candidates, forceReady)
	if #candidates <= Config.MaxPlayers then
		return candidates -- normal case: everybody plays, bots fill the rest
	end

	-- Seed = longest waiting player.
	local seed = candidates[1]
	for _, player in ipairs(candidates) do
		if joinedAt(player) < joinedAt(seed) then
			seed = player
		end
	end
	local seedElo = getElo(seed)
	local waited = now() - joinedAt(seed)

	-- Widen the acceptable ELO window the longer the queue waits.
	local range = math.min(
		Config.Matchmaking.MaxRange,
		Config.Matchmaking.BaseRange + Config.Matchmaking.WidenPerSecond * waited)

	local eligible = {}
	for _, player in ipairs(candidates) do
		if player == seed or math.abs(getElo(player) - seedElo) <= range then
			table.insert(eligible, player)
		end
	end

	if #eligible < Config.MaxPlayers and not forceReady
		and waited < Config.Matchmaking.MaxWaitSeconds then
		return nil -- keep queueing: window still widening
	end

	-- Take the seed + the closest ELOs (ties -> whoever arrived first).
	table.sort(eligible, function(a, b)
		local da, db = math.abs(getElo(a) - seedElo), math.abs(getElo(b) - seedElo)
		if da ~= db then
			return da < db
		end
		return joinedAt(a) < joinedAt(b)
	end)
	-- Keep the seed first regardless (it sorts to distance 0 anyway).
	local selected = {}
	for index = 1, math.min(Config.MaxPlayers, #eligible) do
		table.insert(selected, eligible[index])
	end
	return selected
end

-- Applies ELO deltas from the final standings (bots/ghosts excluded).
function MatchmakingService.SettleMatch(final)
	if type(final) ~= "table" or type(final.Standings) ~= "table" then
		return
	end
	for rank, entry in ipairs(final.Standings) do
		local player = entry.Player
		if player and player:IsA("Player") and player.Parent and not entry.Left then
			local delta = Config.Matchmaking.EloByRank[rank] or 0
			local old = getElo(player)
			DataService.SetElo(player, old + delta)
			if Config.DebugVerboseLogging then
				print(("[Matchmaking] %s: ELO %d -> %d (rank %d, %+d)")
					:format(player.Name, old, DataService.GetElo(player), rank, delta))
			end
		end
	end
end

function MatchmakingService.Init()
	if initialized then
		return
	end
	initialized = true

	Players.PlayerAdded:Connect(function(player)
		queueJoinedAt[player] = now()
	end)
	Players.PlayerRemoving:Connect(function(player)
		queueJoinedAt[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		queueJoinedAt[player] = now()
	end

	print("[MatchmakingService] Initialized: ELO queue live (default "
		.. Config.Matchmaking.DefaultElo .. ", widening window)")
end

function MatchmakingService.GetQueueInfo()
	local parts = {}
	for _, player in ipairs(Players:GetPlayers()) do
		table.insert(parts, ("%s[%d]"):format(player.Name, getElo(player)))
	end
	table.sort(parts)
	return #parts > 0 and table.concat(parts, ", ") or "(queue empty)"
end

function MatchmakingService.DebugState()
	return "queue: " .. MatchmakingService.GetQueueInfo()
end

return MatchmakingService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX48">
<Properties>
	<string name="Name">MatchService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	MatchService (ServerScriptService.MatchService)
	===============================================
	The match state machine:

	  Lobby -> Countdown -> RoundPlaying -> RoundEnd -+-> (next round)
	                                                  +-> MatchEnd -> Lobby

	Lobby        : waits until at least Config.MinPlayersToStart (2) are in
	               (up to Config.MaxPlayers = 6; slot capping is Roblox's job).
	               Egg pickups are disabled; the egg sits at center.
	Countdown    : Config.RoundStartCountdown seconds, re-checked every tick --
	               if players drop below the minimum it aborts back to Lobby.
	RoundPlaying : Config.RoundLength seconds (75). EggService spawns a fresh
	               egg at center, pickups enabled; ScoringService accumulates
	               hold time for whoever carries (pauses while the egg is
	               loose/respawning -- there is no carrier then). A 1 Hz
	               MatchStateChanged clock keeps GUIs in sync.
	RoundEnd     : scoring settles FIRST (a carrier at the exact expiry keeps
	               their partial-second time), then the egg is fumbled and
	               parked at center. RoundEnded fires with ranked results and
	               the round winner is printed to output. Round hold times are
	               cleared; MATCH totals persist.
	MatchEnd     : after Config.RoundsPerMatch (3) rounds -- MVP = highest
	               total hold time across all rounds (present players only,
	               ties shared). MatchEnded fires with final standings
	               (total hold time + rounds won per player) and everything
	               is printed to output. After Config.IntermissionLength it
	               resets and returns to Lobby.

	Leavers      : a player leaving mid-round fumbles (EggService) and their
	               match totals become "ghost" standings (ScoringService);
	               the round/match simply continues with whoever is left.

	Remote payloads
	---------------
	MatchStateChanged(stateName, data)
	  Lobby        : { Players, MinPlayersToStart, MaxPlayers }
	  Countdown    : { StartsIn }                  (StartsIn = 0 means GO)
	  RoundPlaying : { Round, RoundsPerMatch, RoundLength?, TimeLeft }  (~1 Hz)
	  RoundEnd     : { Round, WinnerName?, NextRoundIn }
	  MatchEnd     : { MVPNames, BestTotalHoldTime, NextLobbyIn }
	RoundEnded(roundNumber, results)   -- results = ScoringService.EndRound()
	MatchEnded(finalStandings)         -- ScoringService.GetFinalStandings()

	Testing: set Config.DebugQuickMatch = true for 15-second rounds.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local EggService = require(ServerScriptService:WaitForChild("EggService"))
local ScoringService = require(ServerScriptService:WaitForChild("ScoringService"))
local BotService = require(ServerScriptService:WaitForChild("BotService"))
local BotRegistry = require(ServerScriptService:WaitForChild("BotRegistry"))
local MatchmakingService = require(ServerScriptService:WaitForChild("MatchmakingService"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local MatchStateChanged = Remotes:WaitForChild("MatchStateChanged")
local RoundEnded = Remotes:WaitForChild("RoundEnded")
local MatchEnded = Remotes:WaitForChild("MatchEnded")

local MatchService = {}

local currentState = "Boot"
local currentRound = 0
local loopStarted = false
local lastStateData = nil -- last payload sent with setState (for late-joiner resync)
local roundDeadline = nil -- os.clock() deadline of the running round (for resync TimeLeft)
local matchStartHandler = nil -- injected by Main (EconomyService.ResetMatchStats)
local matchEndHandler = nil   -- injected by Main (EconomyService.SettleMatch)

local function now()
	return os.clock()
end

local function countPlayers()
	return #Players:GetPlayers()
end

---------------------------------------------------------------------------
-- Start conditions (bots + private servers)
---------------------------------------------------------------------------

local function isPrivateServer()
	return Config.PrivateServers.Enabled
		and game.PrivateServerId ~= nil and game.PrivateServerId ~= ""
end

-- How many REAL players are needed before a match may begin.
local function requiredRealPlayers()
	if isPrivateServer() then
		return Config.PrivateServers.MinPlayersToStart -- friends server: solo ok
	end
	if Config.Bots.Enabled then
		return 1 -- a lone player starts a match and gets bots
	end
	return Config.MinPlayersToStart -- legacy: 2+ humans, no bots
end

-- How long the lobby waits for more humans before bots fill the slots.
local function lobbyGrace()
	if isPrivateServer() then
		return Config.PrivateServers.BotGraceSeconds
	end
	return Config.Bots.LobbyGraceSeconds
end

local function getRoundLength()
	if Config.DebugQuickMatch then
		return Config.DebugQuickMatchRoundLength
	end
	return Config.RoundLength
end

local function setState(stateName, data)
	currentState = stateName
	lastStateData = data
	MatchStateChanged:FireAllClients(stateName, data or {})
	if Config.DebugVerboseLogging then
		print("[Match] State -> " .. stateName)
	end
end

-- Late joiners (and clients whose GUI loaded after the last broadcast) get a
-- one-off resync of the current state shortly after they join.
local function resyncPlayer(player)
	task.spawn(function()
		task.wait(2) -- give the client time to load its GUI scripts
		if not player.Parent then
			return
		end
		local data = lastStateData
		if currentState == "RoundPlaying" and roundDeadline then
			data = {
				Round = currentRound,
				RoundsPerMatch = Config.RoundsPerMatch,
				TimeLeft = math.max(0, math.ceil(roundDeadline - now())),
			}
		end
		MatchStateChanged:FireClient(player, currentState, data or {})
	end)
end

---------------------------------------------------------------------------
-- States
---------------------------------------------------------------------------

local function waitForPlayers()
	EggService.SetEnabled(false) -- no pickups in the lobby
	local lastCount = -1
	local firstHumanAt = nil
	while true do
		local count = countPlayers()
		if count ~= lastCount then
			lastCount = count
			setState("Lobby", {
				Players = count,
				MinPlayersToStart = Config.MinPlayersToStart,
				MaxPlayers = Config.MaxPlayers,
				BotsEnabled = Config.Bots.Enabled,
				PrivateServer = isPrivateServer(),
				GraceSeconds = lobbyGrace(),
			})
		end
		if count >= 1 and firstHumanAt == nil then
			firstHumanAt = now()
		elseif count == 0 then
			firstHumanAt = nil
		end

		local ready = false
		if count >= Config.MaxPlayers then
			ready = true -- full house: start immediately
		elseif count >= requiredRealPlayers() then
			if not Config.Bots.Enabled then
				ready = count >= Config.MinPlayersToStart -- legacy 2+ humans
			elseif firstHumanAt and (now() - firstHumanAt) >= lobbyGrace() then
				-- Grace elapsed: start now, bots fill the empty slots.
				ready = true
			end
		end
		if ready then
			return
		end
		task.wait(0.5)
	end
end

-- Returns true when the countdown completed with enough REAL players.
local function runCountdown()
	for count = Config.RoundStartCountdown, 1, -1 do
		if countPlayers() < requiredRealPlayers() then
			return false
		end
		setState("Countdown", { StartsIn = count })
		task.wait(1)
	end
	if countPlayers() < requiredRealPlayers() then
		return false
	end
	setState("Countdown", { StartsIn = 0 }) -- GO!
	return true
end

local function playRound(roundNumber)
	local length = getRoundLength()

	-- Fresh round: reset per-round scoring, egg to center, pickups live.
	ScoringService.StartRound()
	EggService.StartRound()
	EggService.SetEnabled(true)

	setState("RoundPlaying", {
		Round = roundNumber,
		RoundsPerMatch = Config.RoundsPerMatch,
		RoundLength = length,
		TimeLeft = length,
	})
	print(("[Match] --- Round %d/%d started (%ds) ---"):format(
		roundNumber, Config.RoundsPerMatch, length))

	-- Round clock with a 1 Hz broadcast for GUI timers. This fires the remote
	-- directly (not setState) so the verbose log only shows real transitions.
	local deadline = now() + length
	roundDeadline = deadline
	local lastAnnounced = length
	while true do
		local remaining = deadline - now()
		if remaining <= 0 then
			break
		end
		local timeLeft = math.ceil(remaining)
		if timeLeft ~= lastAnnounced then
			lastAnnounced = timeLeft
			MatchStateChanged:FireAllClients("RoundPlaying", {
				Round = roundNumber,
				RoundsPerMatch = Config.RoundsPerMatch,
				TimeLeft = timeLeft,
			})
		end
		task.wait(0.2)
	end

	-- Time! Score FIRST so whoever is carrying at the exact expiry keeps
	-- their partial-second hold time, then park the egg and lock pickups.
	EggService.SetEnabled(false)
	local results = ScoringService.EndRound()
	EggService.EndRound()

	RoundEnded:FireAllClients(roundNumber, results)

	-- Announce the round to the output (deliverable: results in output).
	if results.WinnerName then
		print(("[Match] Round %d winner: %s (%.1fs hold)%s"):format(
			roundNumber, results.WinnerName, results.TopTime,
			results.Tied and "  [TIED]" or ""))
	else
		print(("[Match] Round %d: nobody held the egg - no winner"):format(roundNumber))
	end
	for rank, entry in ipairs(results.Entries) do
		print(("    #%d  %-20s round %6.2fs | match %6.2fs | rounds won %d"):format(
			rank, entry.Name, entry.RoundTime, entry.MatchTime, entry.RoundsWon))
	end

	setState("RoundEnd", {
		Round = roundNumber,
		WinnerName = results.WinnerName,
		NextRoundIn = Config.RoundEndFreeze,
	})
	roundDeadline = nil
	task.wait(Config.RoundEndFreeze)
end

local function playMatch()
	-- 1) Pick the roster: ELO queue when >MaxPlayers humans are waiting,
	--    otherwise everyone plays. Then fill empty slots with bots.
	local humans = MatchmakingService.SelectParticipants(Players:GetPlayers(), true)
	if not humans or #humans == 0 then
		humans = Players:GetPlayers()
	end
	if #humans == 0 then
		return -- everyone left between countdown and kickoff: back to lobby
	end
	local chosenSet = {}
	for _, player in ipairs(humans) do
		chosenSet[player] = true
	end
	-- Non-chosen humans (>MaxPlayers servers) spectate this match: they can
	-- still move around but cannot touch the egg, be hit, or be scored.
	BotRegistry.SetAllowedFilter(function(player)
		return chosenSet[player] == true
	end)

	local botCount = 0
	if Config.Bots.Enabled and Config.Bots.FillToMaxPlayers then
		botCount = math.min(Config.Bots.MaxBots, Config.MaxPlayers - #humans)
	end
	BotService.SpawnBots(botCount)
	print(("[Match] Match starting: %d human(s) + %d bot(s)"):format(#humans, botCount))
	if matchStartHandler then
		task.spawn(matchStartHandler, humans, botCount)
	end

	currentRound = 1
	ScoringService.ResetMatch()
	EggService.ResetHoldTimes()

	while currentRound <= Config.RoundsPerMatch do
		playRound(currentRound)
		currentRound = currentRound + 1
	end

	-- Match over: MVP + final standings.
	local final = ScoringService.GetFinalStandings()
	MatchEnded:FireAllClients(final)

	-- Meta layer: Clout + fragments + pity (EconomyService), then ELO.
	if matchEndHandler then
		task.spawn(matchEndHandler, final)
	end
	MatchmakingService.SettleMatch(final)

	print("[Match] ================= MATCH OVER =================")
	if #final.MVPNames > 0 then
		print(("[Match] MVP: %s (%.1fs total hold time)"):format(
			table.concat(final.MVPNames, " + "), final.BestTotalHoldTime))
	else
		print("[Match] MVP: nobody (no hold time was recorded)")
	end
	print("[Match] Final standings:")
	for rank, entry in ipairs(final.Standings) do
		print(("    #%d  %-20s total %7.2fs | rounds won %d%s%s"):format(
			rank, entry.Name, entry.TotalHoldTime, entry.RoundsWon,
			entry.IsMVP and " | MVP" or "",
			entry.Left and " | left match" or ""))
	end
	print("[Match] =============================================")

	setState("MatchEnd", {
		MVPNames = final.MVPNames,
		BestTotalHoldTime = final.BestTotalHoldTime,
		NextLobbyIn = Config.IntermissionLength,
	})
	task.wait(Config.IntermissionLength)

	-- Cleanup: bots leave, roster filter off (everyone is lobby-eligible).
	BotService.DespawnAll()
	BotRegistry.SetAllowedFilter(nil)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function MatchService.Init()
	if loopStarted then
		return
	end
	loopStarted = true

	Players.PlayerAdded:Connect(resyncPlayer)

	task.spawn(function()
		while true do
			waitForPlayers()
			if runCountdown() then
				playMatch()
			end
		end
	end)

	print("[MatchService] Initialized: Lobby -> Countdown -> Rounds -> MatchEnd loop running")
end

function MatchService.GetState()
	return currentState
end

function MatchService.GetRound()
	return currentRound
end

-- Main injects the meta-layer hooks so MatchService never requires
-- EconomyService directly (keeps the dependency graph one-directional).
function MatchService.SetMatchStartHandler(fn)
	matchStartHandler = (typeof(fn) == "function") and fn or nil
end

function MatchService.SetMatchEndHandler(fn)
	matchEndHandler = (typeof(fn) == "function") and fn or nil
end

function MatchService.DebugState()
	return ("state=%s round=%d/%d players=%d bots=%d private=%s"):format(
		currentState, currentRound, Config.RoundsPerMatch, countPlayers(),
		BotRegistry.CountBots(), tostring(isPrivateServer()))
end

return MatchService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX49">
<Properties>
	<string name="Name">ScoringService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	ScoringService (ServerScriptService.ScoringService)
	===================================================
	Hold-time bookkeeping: per-round accumulation, round winners, match
	totals, rounds won, and MVP computation. Driven by MatchService:

	  StartRound()        -- zero the round clock and begin accumulating
	  EndRound()          -- stop accumulating, settle the final partial tick,
	                         merge round times into match totals, award the
	                         round win(s), return ranked results
	  GetFinalStandings() -- MatchEnded payload (standings + MVPs)
	  ResetMatch()        -- clear everything between matches

	Accumulation: a 10 Hz ticker adds dt to the CURRENT carrier's round time
	(read from EggService.GetCarrier()). While the egg is loose, respawning,
	or nobody carries it, accumulation pauses automatically. EndRound settles
	the remaining partial tick first, so a player carrying at the EXACT moment
	the round expires keeps that time.

	Rules implemented:
	  * Round winner = most hold time this round (exact ties share the win and
	    each get a round win; all-zero round = no winner).
	  * MVP = highest TOTAL hold time across all rounds, chosen among players
	    still in the server at match end (ties share MVP).

	Leavers: when a player leaves mid-match their match totals migrate to a
	"ghost" record (name + userId) so final standings stay complete. The
	partial round they were in is forfeited (not merged into totals).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
-- One-directional dependency: Scoring reads possession from EggService.
local EggService = require(ServerScriptService:WaitForChild("EggService"))
-- Participants = real Players + bot Models (bots can win rounds and MVP,
-- they just earn no currency -- EconomyService pays Players only).
local BotRegistry = require(ServerScriptService:WaitForChild("BotRegistry"))

local ScoringService = {}

local SCORING_TICK = 0.1 -- 10 Hz accumulation

local roundTimes = {}  -- { [Player] = seconds } current round only
local matchTimes = {}  -- { [Player] = seconds } summed across finished rounds
local roundsWon = {}   -- { [Player] = int }
local ghosts = {}      -- { [UserId] = {Name, UserId, MatchTime, RoundsWon} } leavers
local roundActive = false
local lastAccumTime = 0
local initialized = false

local EPSILON = 0.005 -- float tie tolerance (times are accumulated in dt steps)

local function now()
	return os.clock()
end

-- Add elapsed time to the current carrier's round total (pauses implicitly
-- whenever there is no carrier: loose egg, respawning, between rounds).
local function accumulate(dt)
	if dt <= 0 then
		return
	end
	local carrier = EggService.GetCarrier()
	if carrier and carrier.Parent then
		roundTimes[carrier] = (roundTimes[carrier] or 0) + dt
	end
end

local function settle()
	local currentTime = now()
	local dt = currentTime - lastAccumTime
	lastAccumTime = currentTime
	if dt > SCORING_TICK * 3 then
		dt = SCORING_TICK * 3 -- clamp: hitches must not award bonus time
	end
	accumulate(dt)
end

local function startTicker()
	task.spawn(function()
		while initialized do
			if roundActive then
				settle()
			end
			task.wait(SCORING_TICK)
		end
	end)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function ScoringService.Init()
	if initialized then
		return
	end
	initialized = true

	Players.PlayerRemoving:Connect(function(player)
		-- Preserve what they earned; forfeit the in-progress round partial.
		local total = matchTimes[player]
		local won = roundsWon[player]
		if (total and total > 0) or (won and won > 0) then
			ghosts[player.UserId] = {
				Name = player.Name,
				UserId = player.UserId,
				MatchTime = total or 0,
				RoundsWon = won or 0,
			}
		end
		roundTimes[player] = nil
		matchTimes[player] = nil
		roundsWon[player] = nil
	end)

	startTicker()
	print("[ScoringService] Initialized: hold-time bookkeeping live")
end

function ScoringService.StartRound()
	roundTimes = {}
	roundActive = true
	lastAccumTime = now()
end

--[[
	Ends the round and returns:
	{
	  WinnerPlayer : Player?      (nil when nobody scored; first of a tie)
	  WinnerName   : string?
	  Tied         : boolean      (multiple players shared the win)
	  TopTime      : number       (winning round time)
	  Entries      : { {Player, Name, UserId, RoundTime, MatchTime,
	                    RoundsWon, IsWinner?} }  sorted by RoundTime desc
	}
	Round wins are awarded (and merged match totals updated) by this call.
]]
function ScoringService.EndRound()
	if roundActive then
		settle() -- the carrier at the exact expiry keeps their partial time
	end
	roundActive = false

	-- Merge round times into match totals.
	for player, time in pairs(roundTimes) do
		matchTimes[player] = (matchTimes[player] or 0) + time
	end

	-- Ranked entries for everyone in the match (players + bots).
	local entries = {}
	for _, entity in ipairs(BotRegistry.GetParticipants()) do
		table.insert(entries, {
			Player = entity,
			Name = entity.Name,
			UserId = BotRegistry.GetUserId(entity),
			RoundTime = roundTimes[entity] or 0,
			MatchTime = matchTimes[entity] or 0,
			RoundsWon = roundsWon[entity] or 0,
		})
	end
	table.sort(entries, function(a, b)
		if math.abs(a.RoundTime - b.RoundTime) > EPSILON then
			return a.RoundTime > b.RoundTime
		end
		return a.Name < b.Name -- stable, deterministic order for ties
	end)

	-- Winner(s): everyone tied at the top time, provided anyone scored.
	local topTime = entries[1] and entries[1].RoundTime or 0
	local winners = {}
	if topTime > EPSILON then
		for _, entry in ipairs(entries) do
			if entry.RoundTime >= topTime - EPSILON then
				entry.IsWinner = true
				roundsWon[entry.Player] = (roundsWon[entry.Player] or 0) + 1
				entry.RoundsWon = roundsWon[entry.Player]
				table.insert(winners, entry)
			end
		end
	end

	return {
		WinnerPlayer = winners[1] and winners[1].Player or nil,
		WinnerName = winners[1] and winners[1].Name or nil,
		Tied = #winners > 1,
		TopTime = topTime,
		Entries = entries,
	}
end

--[[
	Final standings for MatchEnded:
	{
	  Standings : { {Player?, Name, UserId, TotalHoldTime, RoundsWon,
	                 Left, IsMVP?} } sorted by TotalHoldTime desc
	  MVPs      : subset of Standings (present players only, ties included)
	  MVPNames  : { string }
	  BestTotalHoldTime : number
	}
]]
function ScoringService.GetFinalStandings()
	local standings = {}
	for _, entity in ipairs(BotRegistry.GetParticipants()) do
		table.insert(standings, {
			Player = entity,
			Name = entity.Name,
			UserId = BotRegistry.GetUserId(entity),
			TotalHoldTime = matchTimes[entity] or 0,
			RoundsWon = roundsWon[entity] or 0,
			Left = false,
		})
	end
	for _, ghost in pairs(ghosts) do
		table.insert(standings, {
			Player = nil, -- left the server: name/userId only (remote-safe)
			Name = ghost.Name,
			UserId = ghost.UserId,
			TotalHoldTime = ghost.MatchTime,
			RoundsWon = ghost.RoundsWon,
			Left = true,
		})
	end
	table.sort(standings, function(a, b)
		if math.abs(a.TotalHoldTime - b.TotalHoldTime) > EPSILON then
			return a.TotalHoldTime > b.TotalHoldTime
		end
		return a.Name < b.Name
	end)

	-- MVP among players still present (ties share the title).
	local best = 0
	local mvps = {}
	for _, entry in ipairs(standings) do
		if not entry.Left then
			if entry.TotalHoldTime > best + EPSILON then
				best = entry.TotalHoldTime
				mvps = { entry }
			elseif best > EPSILON and entry.TotalHoldTime >= best - EPSILON then
				table.insert(mvps, entry)
			end
		end
	end
	local mvpNames = {}
	for _, entry in ipairs(mvps) do
		entry.IsMVP = true
		table.insert(mvpNames, entry.Name)
	end

	return {
		Standings = standings,
		MVPs = mvps,
		MVPNames = mvpNames,
		BestTotalHoldTime = best,
	}
end

function ScoringService.ResetMatch()
	roundTimes = {}
	matchTimes = {}
	roundsWon = {}
	ghosts = {}
	roundActive = false
end

function ScoringService.GetRoundTime(player)
	return roundTimes[player] or 0
end

function ScoringService.GetMatchTime(player)
	return matchTimes[player] or 0
end

function ScoringService.GetRoundsWon(player)
	return roundsWon[player] or 0
end

function ScoringService.DebugState()
	local parts = {}
	for player, time in pairs(matchTimes) do
		if player.Parent then
			table.insert(parts, ("%s[round=%.1f match=%.1f won=%d]"):format(
				player.Name, roundTimes[player] or 0, time, roundsWon[player] or 0))
		end
	end
	table.sort(parts)
	return "roundActive=" .. tostring(roundActive)
		.. " | " .. (#parts > 0 and table.concat(parts, ", ") or "(no scores)")
end

return ScoringService
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ServerStorage" referent="RBX50">
<Properties>
	<string name="Name">ServerStorage</string>
</Properties>
</Item>
<Item class="SoundService" referent="RBX51">
<Properties>
	<string name="Name">Sound</string>
</Properties>
</Item>
<Item class="StarterGui" referent="RBX52">
<Properties>
	<string name="Name">StarterGui</string>
</Properties>
<Item class="ScreenGui" referent="RBX53">
<Properties>
	<string name="Name">CTEGui</string>
	<bool name="ResetOnSpawn">false</bool>
</Properties>
<Item class="ModuleScript" referent="RBX54">
<Properties>
	<string name="Name">ControlsPanel</string>
	<ProtectedString name="Source"><![CDATA[--[[
	ControlsPanel (ModuleScript inside StarterGui.CTEGui)
	=====================================================
	The ONLY thing on screen in the lobby: a small, unobtrusive, collapsible
	controls list parked on the right side of the screen (no full-screen
	menus -- the match starts automatically).

	Api:
	  ControlsPanel.Create(parentGui) -> panel
	  panel:SetCollapsed(bool)
]]

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local ControlsPanel = {}
ControlsPanel.__index = ControlsPanel

local HEADER_HEIGHT = 0.05
local PANEL_WIDTH = 0.235

-- key, action pairs (keyboard/gamepad; mobile uses the on-screen buttons).
local CONTROLS = {
	{ "LMB · X", "Attack (no egg)" },
	{ "Q F · Y", "Throw (has egg)" },
	{ "RMB · L1", "Block (hold)" },
	{ "E · R1", "Dash" },
	{ "Shift · R2", "Sprint (hold)" },
	{ "Space", "Jump" },
}

function ControlsPanel.Create(parentGui)
	local self = setmetatable({}, ControlsPanel)

	self.root = UiKit.frame({
		Name = "ControlsPanel",
		Size = UDim2.fromScale(PANEL_WIDTH, 0.05 + 0.052 * (#CONTROLS + 1)),
		Position = UDim2.fromScale(1 - PANEL_WIDTH - 0.012, 0.30),
		BackgroundColor3 = UiKit.Theme.Panel,
		BackgroundTransparency = 0.3,
	}, parentGui)

	-- Header doubles as the collapse toggle.
	self.header = UiKit.button({
		Name = "Header",
		Size = UDim2.fromScale(1, HEADER_HEIGHT / self.root.Size.Y.Scale),
		Text = "CONTROLS  –",
		BackgroundColor3 = UiKit.Theme.Panel,
		BackgroundTransparency = 0.15,
		Font = UiKit.Theme.FontMain,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.root)
	UiKit.padding(self.header, 0.06)

	self.body = UiKit.frame({
		Name = "Body",
		Size = UDim2.fromScale(1, 1 - HEADER_HEIGHT / self.root.Size.Y.Scale),
		Position = UDim2.fromScale(0, HEADER_HEIGHT / self.root.Size.Y.Scale),
		BackgroundTransparency = 1,
	}, self.root)

	local rowHeight = 0.9 / #CONTROLS
	for index, control in ipairs(CONTROLS) do
		local rowY = (index - 1) * rowHeight
		UiKit.label({
			Name = "Key" .. index,
			Size = UDim2.fromScale(0.42, rowHeight * 0.8),
			Position = UDim2.fromScale(0.04, rowY + rowHeight * 0.1),
			Text = control[1],
			Font = UiKit.Theme.FontMain,
			TextColor3 = UiKit.Theme.Accent,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, self.body)
		UiKit.label({
			Name = "Action" .. index,
			Size = UDim2.fromScale(0.52, rowHeight * 0.8),
			Position = UDim2.fromScale(0.46, rowY + rowHeight * 0.1),
			Text = control[2],
			Font = UiKit.Theme.FontSoft,
			TextColor3 = UiKit.Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, self.body)
	end

	UiKit.label({
		Name = "Footer",
		Size = UDim2.fromScale(0.92, rowHeight * 0.8),
		Position = UDim2.fromScale(0.04, #CONTROLS * rowHeight + rowHeight * 0.1),
		Text = "Touch the egg to grab it!",
		Font = UiKit.Theme.FontSoft,
		TextColor3 = UiKit.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.body)

	self.collapsed = false
	self.expandedHeight = HEADER_HEIGHT + 0.052 * (#CONTROLS + 1)
	self.headerFraction = HEADER_HEIGHT / self.expandedHeight
	self.header.Activated:Connect(function()
		self:SetCollapsed(not self.collapsed)
	end)

	return self
end

function ControlsPanel:SetCollapsed(collapsed)
	self.collapsed = collapsed
	self.body.Visible = not collapsed
	self.header.Text = collapsed and "CONTROLS  +" or "CONTROLS  –"
	self.root.Size = collapsed
		and UDim2.fromScale(PANEL_WIDTH, HEADER_HEIGHT)
		or UDim2.fromScale(PANEL_WIDTH, self.expandedHeight)
	-- Collapsed: the header IS the whole panel. Expanded: just the top strip.
	self.header.Size = collapsed
		and UDim2.fromScale(1, 1)
		or UDim2.fromScale(1, self.headerFraction)
end

function ControlsPanel:SetVisible(visible)
	self.root.Visible = visible
end

return ControlsPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX55">
<Properties>
	<bool name="Disabled">false</bool>
	<string name="Name">GuiMain</string>
	<ProtectedString name="Source"><![CDATA[--[[
	GuiMain (LocalScript inside StarterGui.CTEGui)
	==============================================
	Builds and routes the whole GUI. Runs once per player (PlayerGui copy of
	the StarterGui screen, ResetOnSpawn = false), so it survives respawns.

	Layout philosophy: NO full-screen menus. The HUD is always up; the lobby
	is just the idle HUD + a small collapsible CONTROLS panel + a HATCHERY
	button. Matches start automatically (bots fill empty slots), results
	panels overlay the HUD, and toasts report rewards.

	Data sources (NO game logic is duplicated here -- everything is state read
	from the server):
	  MatchStateChanged  -> timer/round/status line, countdown, screen flow
	  RoundEnded         -> round-end results panel
	  MatchEnded         -> match-end results panel (MVP + standings)
	  MatchRewards       -> "+Clout / +Fragments" toast (personal)
	  HoldTimeUpdated    -> hold-time board rows (players AND bots)
	  EggPossessionChanged -> carrier highlight
	  HatcheryUpdated    -> hatchery panel snapshot
	  FeedbackEvent      -> steal/grip feed + cooldown wipes + pet/egg toasts
	  Player attributes  -> HasEgg (button context states), Stamina (bar/dash)

	Buttons call _G.CTEInput (exposed by ClientInput) which fires the Request*
	RemoteEvents; the server validates everything.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local MatchStateChanged = Remotes:WaitForChild("MatchStateChanged")
local RoundEnded = Remotes:WaitForChild("RoundEnded")
local MatchEnded = Remotes:WaitForChild("MatchEnded")
local MatchRewards = Remotes:WaitForChild("MatchRewards")
local HoldTimeUpdated = Remotes:WaitForChild("HoldTimeUpdated")
local EggPossessionChanged = Remotes:WaitForChild("EggPossessionChanged")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")
local HatcheryRequest = Remotes:WaitForChild("HatcheryRequest")
local HatcheryUpdated = Remotes:WaitForChild("HatcheryUpdated")

-- Fallbacks if _G.CTEInput is not ready yet (should never happen mid-match).
local RequestAttack = Remotes:WaitForChild("RequestAttack")
local RequestThrow = Remotes:WaitForChild("RequestThrow")
local RequestDash = Remotes:WaitForChild("RequestDash")
local RequestBlockStart = Remotes:WaitForChild("RequestBlockStart")
local RequestBlockEnd = Remotes:WaitForChild("RequestBlockEnd")

local UiKit = require(script.Parent:WaitForChild("UiKit"))
local ControlsPanel = require(script.Parent:WaitForChild("ControlsPanel"))
local HudScreen = require(script.Parent:WaitForChild("HudScreen"))
local ResultsScreens = require(script.Parent:WaitForChild("ResultsScreens"))
local SettingsPanel = require(script.Parent:WaitForChild("SettingsPanel"))
local HatcheryPanel = require(script.Parent:WaitForChild("HatcheryPanel"))

local player = Players.LocalPlayer
local gui = script.Parent -- the CTEGui ScreenGui (already in PlayerGui)
gui.ResetOnSpawn = false
-- Keep the HUD clear of core buttons (chat/menu) on phones, where available.
pcall(function()
	gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeArea
end)

---------------------------------------------------------------------------
-- Build screens. Creation order = paint order (later siblings draw on top).
---------------------------------------------------------------------------

local hud = HudScreen.Create(gui)
local results = ResultsScreens.Create(gui)
local settings = SettingsPanel.Create(gui)
local controls = ControlsPanel.Create(gui)
local hatchery = HatcheryPanel.Create(gui) -- above controls: it is an overlay

hud:SetVisible(true) -- the HUD is always up now (idle in the lobby)

-- Info toast (top-center, under the timer) for rewards/flow messages.
local toastFrame = UiKit.frame({
	Name = "Toasts",
	Size = UDim2.fromScale(0.5, 0.16),
	Position = UDim2.fromScale(0.25, 0.18),
	BackgroundTransparency = 1,
}, gui)
UiKit.listLayout(toastFrame, Enum.FillDirection.Vertical, 0.02,
	Enum.HorizontalAlignment.Center)

local function toast(message, color)
	local label = UiKit.frame({
		Name = "Toast",
		Size = UDim2.fromScale(1, 0.3),
		BackgroundColor3 = UiKit.Theme.Panel,
		BackgroundTransparency = 0.1,
	}, toastFrame)
	UiKit.label({
		Size = UDim2.fromScale(0.96, 0.7),
		Position = UDim2.fromScale(0.02, 0.15),
		Text = message,
		Font = UiKit.Theme.FontMain,
		TextColor3 = color or UiKit.Theme.Text,
		TextWrapped = true,
	}, label)

	task.delay(3.2, function()
		if label.Parent then
			UiKit.tween(label, 0.4, { BackgroundTransparency = 1 })
			for _, child in ipairs(label:GetChildren()) do
				if child:IsA("TextLabel") then
					UiKit.tween(child, 0.4, { TextTransparency = 1 })
				end
			end
			task.delay(0.45, function()
				label:Destroy()
			end)
		end
	end)
end

---------------------------------------------------------------------------
-- Ability buttons -> ClientInput (which fires the Request* remotes)
---------------------------------------------------------------------------

local function callInput(functionName, fallbackRemote, ...)
	local api = _G.CTEInput
	if api and type(api[functionName]) == "function" then
		api[functionName](...)
	elseif fallbackRemote then
		fallbackRemote:FireServer()
	end
end

hud.OnAbility = function(abilityName, isDown)
	if abilityName == "ATTACK" and isDown then
		callInput("Attack", RequestAttack)
	elseif abilityName == "THROW" and isDown then
		callInput("Throw", RequestThrow)
	elseif abilityName == "DASH" and isDown then
		callInput("Dash", RequestDash)
	elseif abilityName == "BLOCK" then
		callInput("Block", isDown and RequestBlockStart or RequestBlockEnd, isDown)
	end
end

hud.OnSettings = function()
	settings:Toggle()
end
hud.OnHatchery = function()
	hatchery:Toggle()
end

results.OnPlayAgain = function()
	toast("The next match starts automatically after the intermission.", UiKit.Theme.Info)
end
results.OnBackToLobby = function()
	toast("Heading back to the lobby…", UiKit.Theme.Info)
end

---------------------------------------------------------------------------
-- Screen state router (server-driven; the GUI never decides the flow)
---------------------------------------------------------------------------

local matchEndPayload = nil
local currentState = "Lobby"

local function applyState(stateName, data)
	currentState = stateName
	data = data or {}

	if stateName == "Lobby" then
		results:HideRoundEnd()
		results:HideMatchEnd()
		hud.timerLabel.Text = "--"
		hud.countdownLabel.Visible = false
		hud.roundLabel.Text = "Lobby"
		controls:SetCollapsed(false)
		if data.BotsEnabled then
			hud:SetStatus("Waiting for players… bots fill empty slots")
		elseif data.PrivateServer then
			hud:SetStatus("Private server — start when ready")
		else
			hud:SetStatus(("Need %d+ players to start"):format(
				data.MinPlayersToStart or Config.MinPlayersToStart))
		end
	elseif stateName == "Countdown" then
		results:HideRoundEnd()
		results:HideMatchEnd()
		controls:SetCollapsed(true)
		hud:SetStatus("")
		hud:ShowCountdown(data.StartsIn or 3)
	elseif stateName == "RoundPlaying" then
		results:HideRoundEnd()
		results:HideMatchEnd()
		matchEndPayload = nil
		hud:SetStatus("")
		if data.Round then
			hud:SetRoundInfo(data.Round, data.RoundsPerMatch)
		end
		hud:SetTimeLeft(data.TimeLeft)
	elseif stateName == "RoundEnd" then
		results:HideMatchEnd()
		hud:SetStatus("Round over")
		-- panel content arrives via RoundEnded (fired just before this state)
	elseif stateName == "MatchEnd" then
		results:HideRoundEnd()
		hud:SetStatus("Match over")
		if matchEndPayload then
			results:ShowMatchEnd(matchEndPayload)
		end
	end
end

MatchStateChanged.OnClientEvent:Connect(applyState)

RoundEnded.OnClientEvent:Connect(function(roundNumber, resultsData)
	if type(resultsData) == "table" then
		results:ShowRoundEnd(roundNumber, resultsData)
	end
end)

MatchEnded.OnClientEvent:Connect(function(final)
	matchEndPayload = final
	if currentState == "MatchEnd" then
		results:ShowMatchEnd(final)
	end
end)

HoldTimeUpdated.OnClientEvent:Connect(function(entries)
	hud:UpdateHoldTimes(entries)
end)

EggPossessionChanged.OnClientEvent:Connect(function(newCarrier)
	hud:SetCarrier(newCarrier)
end)

---------------------------------------------------------------------------
-- Meta layer: rewards toast + hatchery snapshot
---------------------------------------------------------------------------

MatchRewards.OnClientEvent:Connect(function(rewards)
	if type(rewards) ~= "table" then
		return
	end
	toast(("Match rewards: +%d Clout, +%d Fragments (rank #%d)")
		:format(rewards.Clout or 0, rewards.Fragments or 0, rewards.Rank or 0),
		UiKit.Theme.Accent)
	if rewards.IsMVP then
		toast("MVP bonus: +" .. Config.Economy.CloutMVPBonus .. " Clout ★", UiKit.Theme.Good)
	end
	if rewards.PityEgg or rewards.EggGranted then
		toast("PITY UNLOCKED: a guaranteed-RARE egg was granted! Check the hatchery.",
			UiKit.Theme.Info)
	end
	if Config.DebugVerboseLogging then
		print(("[CTE] rewards: clout=+%d frags=+%d kd=%d steals=%d hold=%ds rank=%d mvp=%s pity=%s")
			:format(rewards.Clout or 0, rewards.Fragments or 0, rewards.Knockdowns or 0,
				rewards.Steals or 0, rewards.HoldSeconds or 0, rewards.Rank or 0,
				tostring(rewards.IsMVP), tostring(rewards.PityEgg)))
	end
end)

HatcheryUpdated.OnClientEvent:Connect(function(snapshot)
	hatchery:SetSnapshot(snapshot)
end)

---------------------------------------------------------------------------
-- FeedbackEvent: feed + toasts + cooldown wipes (success events only)
---------------------------------------------------------------------------

FeedbackEvent.OnClientEvent:Connect(function(kind, data)
	if type(data) ~= "table" then
		data = {}
	end

	-- Feed messages (world events).
	if kind == "EggStolen" then
		local attacker = UiKit.playerName(data.Attacker, "?")
		local victim = UiKit.playerName(data.Victim, "?")
		hud:PushFeed(("%s stole the egg from %s!"):format(attacker, victim), UiKit.Theme.Accent)
	elseif kind == "GripSave" then
		hud:PushFeed(("%s's pet GRIPPED the egg!"):format(
			UiKit.playerName(data.Player, "?")), UiKit.Theme.Good)
	elseif kind == "EggPickup" then
		hud:PushFeed(("%s grabbed the egg!"):format(UiKit.playerName(data.Player, "?")),
			UiKit.Theme.Good)
	elseif kind == "EggThrown" then
		hud:PushFeed(("%s threw the egg!"):format(UiKit.playerName(data.Player, "?")),
			UiKit.Theme.Info)
	elseif kind == "DashFumble" then
		hud:PushFeed(("%s fumbled the egg mid-dash!"):format(UiKit.playerName(data.Player, "?")),
			UiKit.Theme.Bad)
	elseif kind == "EggOutOfBounds" then
		hud:PushFeed("The egg flew out of the arena — respawning…", UiKit.Theme.Bad)
	end

	-- Personal toasts (meta layer).
	if kind == "PetHatched" and data.Pet then
		local pet = data.Pet
		toast(("You hatched %s! (%s · %s · grip +%.1f%%)"):format(
			pet.Name or "a pet", pet.Rarity or "?", pet.Size or "?", pet.GripBonus or 0),
			UiKit.Theme.Accent)
	elseif kind == "EggGranted" then
		toast("You received an egg! Open it in the HATCHERY when it hatches.",
			UiKit.Theme.Info)
	elseif kind == "NotEnoughClout" then
		toast(("Not enough Clout (need %d, have %d)"):format(data.Need or 0, data.Have or 0),
			UiKit.Theme.Bad)
	elseif kind == "NotEnoughFragments" then
		toast(("Not enough fragments (need %d, have %d)"):format(data.Need or 0, data.Have or 0),
			UiKit.Theme.Bad)
	elseif kind == "EggNotReady" then
		toast("That egg is still hatching…", UiKit.Theme.Bad)
	elseif kind == "DataNotReady" then
		toast("Your profile is still loading — try again in a second.", UiKit.Theme.Info)
	end

	-- Cooldown wipes for the LOCAL player, driven by server success events.
	if data.Player == player then
		if kind == "PunchSwing" then
			hud:StartCooldown("ATTACK", Config.AttackCooldown)
		elseif kind == "DashStart" then
			local cooldown = data.Carrying and Config.DashCooldownCarrying or Config.DashCooldown
			hud:StartCooldown("DASH", cooldown)
		end
	end
end)

---------------------------------------------------------------------------
-- Replicated attributes: HasEgg (context buttons) + Stamina (bar/dash gate)
---------------------------------------------------------------------------

local function refreshHasEgg()
	hud:SetHasEgg(player:GetAttribute("HasEgg") == true)
end
local function refreshStamina()
	hud:SetStamina(player:GetAttribute("Stamina") or Config.StaminaMax)
end

player:GetAttributeChangedSignal("HasEgg"):Connect(refreshHasEgg)
player:GetAttributeChangedSignal("Stamina"):Connect(refreshStamina)
refreshHasEgg()
refreshStamina()

---------------------------------------------------------------------------
-- Initial state (the server resyncs us via MatchStateChanged shortly after
-- join if a match is already running, and pushes a HatcheryUpdated snapshot
-- as soon as the profile loads)
---------------------------------------------------------------------------

applyState("Lobby", { BotsEnabled = Config.Bots.Enabled })
task.delay(2, function()
	HatcheryRequest:FireServer("Refresh")
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX56">
<Properties>
	<string name="Name">HatcheryPanel</string>
	<ProtectedString name="Source"><![CDATA[--[[
	HatcheryPanel (ModuleScript inside StarterGui.CTEGui)
	=====================================================
	The meta-game panel, opened from the small HATCHERY button:

	  * Wallet row: Clout, Fragments (x/10), pity progress.
	  * BUY EGG (Clout) / CONVERT 10 FRAGMENTS buttons.
	  * Eggs in progress: hatch countdowns (computed from the server
	    snapshot's Now), OPEN button when ready.
	  * Pet collection: rarity-colored rows with size/mutation/grip and
	    EQUIP buttons (one equipped pet = its tiny capped grip bonus).

	Pure presentation + request buttons: every action goes through the
	HatcheryRequest RemoteEvent and the SERVER validates + answers with a
	fresh HatcheryUpdated snapshot. Nothing is computed locally except the
	countdown display.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local HatcheryRequest = Remotes:WaitForChild("HatcheryRequest")

local HatcheryPanel = {}
HatcheryPanel.__index = HatcheryPanel

local RARITY_COLORS = {
	Common = Color3.fromRGB(158, 164, 180),
	Rare = Color3.fromRGB(95, 170, 255),
	Epic = Color3.fromRGB(180, 100, 255),
	Legendary = Color3.fromRGB(255, 165, 60),
	Mythic = Color3.fromRGB(255, 85, 120),
}

local function request(action, id)
	HatcheryRequest:FireServer(action, id)
end

local function clearChildren(container)
	for _, child in ipairs(container:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

function HatcheryPanel.Create(parentGui)
	local self = setmetatable({}, HatcheryPanel)
	self.snapshot = nil
	self.receivedAt = 0

	self.scrim = UiKit.scrim(parentGui, 0.5)
	self.scrim.Name = "HatcheryScrim"
	self.scrim.Visible = false

	self.panel = UiKit.frame({
		Name = "HatcheryPanel",
		Size = UDim2.fromScale(0.58, 0.74),
		Position = UDim2.fromScale(0.21, 0.13),
		BackgroundColor3 = UiKit.Theme.Panel,
		Visible = false,
	}, parentGui)
	UiKit.stroke(self.panel, UiKit.Theme.AccentDark, 3)

	UiKit.label({
		Name = "Title",
		Size = UDim2.fromScale(0.6, 0.075),
		Position = UDim2.fromScale(0.04, 0.02),
		Text = "HATCHERY",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	self.closeButton = UiKit.button({
		Name = "Close",
		Size = UDim2.fromScale(0.07, 0.06),
		Position = UDim2.fromScale(0.91, 0.02),
		Text = "X",
	}, self.panel)
	self.closeButton.Activated:Connect(function()
		self:SetVisible(false)
	end)
	self.scrim.InputBegan:Connect(function(input)
		if UiKit.isPress(input) then
			self:SetVisible(false)
		end
	end)

	-- Wallet row
	self.walletLabel = UiKit.label({
		Name = "Wallet",
		Size = UDim2.fromScale(0.92, 0.05),
		Position = UDim2.fromScale(0.04, 0.10),
		Text = "Loading…",
		Font = UiKit.Theme.FontMain,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	-- Action buttons
	self.buyButton = UiKit.button({
		Name = "BuyEgg",
		Size = UDim2.fromScale(0.44, 0.065),
		Position = UDim2.fromScale(0.04, 0.165),
		Text = ("BUY EGG — %d CLOUT"):format(Config.Economy.EggCloutCost),
	}, self.panel)
	self.buyButton.Activated:Connect(function()
		request("BuyEgg")
	end)

	self.convertButton = UiKit.button({
		Name = "ConvertFragments",
		Size = UDim2.fromScale(0.44, 0.065),
		Position = UDim2.fromScale(0.52, 0.165),
		Text = ("CONVERT %d FRAGMENTS"):format(Config.Economy.EggFragmentCost),
	}, self.panel)
	self.convertButton.Activated:Connect(function()
		request("ConvertFragments")
	end)

	-- Eggs section
	UiKit.label({
		Name = "EggsHeader",
		Size = UDim2.fromScale(0.92, 0.04),
		Position = UDim2.fromScale(0.04, 0.245),
		Text = "EGGS",
		Font = UiKit.Theme.FontMain,
		TextColor3 = UiKit.Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	self.eggsFrame = UiKit.new("ScrollingFrame", {
		Name = "Eggs",
		Size = UDim2.fromScale(0.92, 0.17),
		Position = UDim2.fromScale(0.04, 0.285),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, self.panel)
	UiKit.listLayout(self.eggsFrame, Enum.FillDirection.Vertical, 0.04)

	-- Pets section
	self.petsHeader = UiKit.label({
		Name = "PetsHeader",
		Size = UDim2.fromScale(0.92, 0.04),
		Position = UDim2.fromScale(0.04, 0.47),
		Text = "PETS",
		Font = UiKit.Theme.FontMain,
		TextColor3 = UiKit.Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	self.petsFrame = UiKit.new("ScrollingFrame", {
		Name = "Pets",
		Size = UDim2.fromScale(0.92, 0.40),
		Position = UDim2.fromScale(0.04, 0.51),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.fromScale(0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	}, self.panel)
	UiKit.listLayout(self.petsFrame, Enum.FillDirection.Vertical, 0.025)

	self.noteLabel = UiKit.label({
		Name = "Note",
		Size = UDim2.fromScale(0.92, 0.035),
		Position = UDim2.fromScale(0.04, 0.945),
		Text = "",
		Font = UiKit.Theme.FontSoft,
		TextColor3 = UiKit.Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	-- 1 Hz countdown refresh while open.
	task.spawn(function()
		while true do
			task.wait(1)
			if self.panel.Visible and self.snapshot then
				self:renderEggs()
			end
		end
	end)

	return self
end

---------------------------------------------------------------------------
-- Rendering
---------------------------------------------------------------------------

function HatcheryPanel:serverNow()
	-- Snapshot's Now + time elapsed on this client since it arrived.
	return (self.snapshot and self.snapshot.Now or os.time())
		+ math.floor(tick() - self.receivedAt)
end

function HatcheryPanel:renderEggs()
	local snap = self.snapshot
	if not snap then
		return
	end
	clearChildren(self.eggsFrame)

	if #snap.Eggs == 0 then
		UiKit.label({
			Size = UDim2.fromScale(1, 0.4),
			Text = "No eggs yet — buy one or convert fragments!",
			Font = UiKit.Theme.FontSoft,
			TextColor3 = UiKit.Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, self.eggsFrame)
		return
	end

	local serverNow = self:serverNow()
	for _, egg in ipairs(snap.Eggs) do
		local row = UiKit.frame({
			Name = "Egg_" .. tostring(egg.Id),
			Size = UDim2.fromScale(1, 0.4),
			BackgroundColor3 = UiKit.Theme.PanelAlt,
			BackgroundTransparency = 0.35,
		}, self.eggsFrame)

		local title = egg.GuaranteedRare and "RARE Egg" or "Mystery Egg"
		UiKit.label({
			Size = UDim2.fromScale(0.5, 0.7),
			Position = UDim2.fromScale(0.03, 0.15),
			Text = ("%s  <font color='#9ea4b4'>(%s)</font>"):format(title, tostring(egg.Source)),
			Font = UiKit.Theme.FontMain,
			TextColor3 = egg.GuaranteedRare and RARITY_COLORS.Rare or UiKit.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)

		local remaining = (egg.UnlocksAt or 0) - serverNow
		if remaining > 0 then
			UiKit.label({
				Size = UDim2.fromScale(0.4, 0.7),
				Position = UDim2.fromScale(0.57, 0.15),
				Text = ("hatching… %d:%02d"):format(
					math.floor(remaining / 60), remaining % 60),
				Font = UiKit.Theme.FontSoft,
				TextColor3 = UiKit.Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Right,
			}, row)
		else
			local openButton = UiKit.button({
				Size = UDim2.fromScale(0.38, 0.72),
				Position = UDim2.fromScale(0.59, 0.14),
				Text = "OPEN",
				TextColor3 = UiKit.Theme.Background,
			}, row)
			openButton.BackgroundColor3 = UiKit.Theme.Accent
			openButton.Activated:Connect(function()
				request("OpenEgg", egg.Id)
			end)
		end
	end
end

function HatcheryPanel:renderPets()
	local snap = self.snapshot
	if not snap then
		return
	end
	clearChildren(self.petsFrame)
	self.petsHeader.Text = ("PETS (%d)"):format(#snap.Pets)

	if #snap.Pets == 0 then
		UiKit.label({
			Size = UDim2.fromScale(1, 0.15),
			Text = "No pets yet — hatch an egg!",
			Font = UiKit.Theme.FontSoft,
			TextColor3 = UiKit.Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, self.petsFrame)
		return
	end

	for _, pet in ipairs(snap.Pets) do
		local row = UiKit.frame({
			Name = "Pet_" .. tostring(pet.Id),
			Size = UDim2.fromScale(1, 0.2),
			BackgroundColor3 = UiKit.Theme.PanelAlt,
			BackgroundTransparency = 0.35,
		}, self.petsFrame)

		UiKit.label({
			Size = UDim2.fromScale(0.42, 0.7),
			Position = UDim2.fromScale(0.03, 0.15),
			Text = pet.Name or "?",
			Font = UiKit.Theme.FontMain,
			TextColor3 = RARITY_COLORS[pet.Rarity] or UiKit.Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)

		local details = pet.Rarity .. " · " .. tostring(pet.Size)
		if pet.Mutation then
			details = details .. " · " .. pet.Mutation
		end
		details = details .. (" · grip +%.1f%%"):format(pet.GripBonus or 0)
		UiKit.label({
			Size = UDim2.fromScale(0.36, 0.7),
			Position = UDim2.fromScale(0.44, 0.15),
			Text = details,
			Font = UiKit.Theme.FontSoft,
			TextColor3 = UiKit.Theme.TextDim,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)

		local equipped = (snap.EquippedPetId == pet.Id)
		local equipButton = UiKit.button({
			Size = UDim2.fromScale(0.16, 0.72),
			Position = UDim2.fromScale(0.82, 0.14),
			Text = equipped and "ON" or "EQUIP",
		}, row)
		if equipped then
			equipButton.BackgroundColor3 = UiKit.Theme.Good
			equipButton.TextColor3 = UiKit.Theme.Background
			equipButton.AutoButtonColor = false
		else
			equipButton.Activated:Connect(function()
				request("EquipPet", pet.Id)
			end)
		end
	end
end

function HatcheryPanel:SetSnapshot(snapshot)
	self.snapshot = snapshot
	self.receivedAt = tick()
	if not snapshot then
		self.walletLabel.Text = "Loading…"
		return
	end
	self.walletLabel.Text = ("Clout: %d    Fragments: %d/%d    Pity: %d/%d"):format(
		snapshot.Clout, snapshot.Fragments, Config.Economy.EggFragmentCost,
		snapshot.PityProgress and snapshot.PityProgress.SinceRoundWin or 0,
		snapshot.PityProgress and snapshot.PityProgress.Needed
			or Config.Economy.PityMatchesWithoutRoundWin)
	self.noteLabel.Text = snapshot.StoreOK and ""
		or "Data is TEMPORARY this session (DataStore unavailable)."
	if self.panel.Visible then
		self:renderEggs()
		self:renderPets()
	end
end

function HatcheryPanel:SetVisible(visible)
	self.scrim.Visible = visible
	self.panel.Visible = visible
	if visible then
		self:renderEggs()
		self:renderPets()
		request("Refresh") -- make sure we show fresh numbers
	end
end

function HatcheryPanel:Toggle()
	self:SetVisible(not self.panel.Visible)
end

return HatcheryPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX57">
<Properties>
	<string name="Name">HudScreen</string>
	<ProtectedString name="Source"><![CDATA[--[[
	HudScreen (ModuleScript inside StarterGui.CTEGui)
	=================================================
	The in-match HUD:

	  * Round timer (big, center top) + "Round 1/3" indicator + countdown.
	  * Hold-time board: one row per arena slot (Config.MaxPlayers) with the
	    player's accumulated hold time, a relative fill bar, and a gold
	    highlight for the current carrier. Data comes straight from the
	    HoldTimeUpdated / EggPossessionChanged remotes -- no game logic here.
	  * Four ability buttons (ATTACK / THROW / BLOCK / DASH):
	      - contextual greying from the replicated HasEgg attribute
	        ("Hands Full" / "Need Egg")
	      - DASH greys out when the replicated Stamina attribute is below the
	        dash cost (carry-aware, costs read from Config = presentation only)
	      - cooldown wipe overlay, started from SUCCESS feedback events
	        (PunchSwing / DashStart) so keyboard users see it too
	      - BLOCK is a hold button (press/release callbacks)
	  * Stamina bar (rounded "Stamina" player attribute).
	  * Steal feed (GuiMain pushes strings from FeedbackEvent).

	All sizes are Scale-based; text is TextScaled (mobile-friendly).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local UiKit = require(script.Parent:WaitForChild("UiKit"))

local HudScreen = {}
HudScreen.__index = HudScreen

local ABILITY_ORDER = { "ATTACK", "THROW", "BLOCK", "DASH" }
local FEED_MAX = 4
local FEED_LIFETIME = 3.2

function HudScreen.Create(parentGui)
	local self = setmetatable({}, HudScreen)

	self.OnAbility = nil   -- GuiMain sets: function(abilityName, isDown)
	self.OnSettings = nil
	self.OnHatchery = nil

	self.carrier = nil
	self.holdTimes = {}    -- { [Player] = seconds } from HoldTimeUpdated
	self.hasEgg = false
	self.stamina = Config.StaminaMax
	self.abilities = {}

	self.root = UiKit.frame({
		Name = "HUD",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
	}, parentGui)
	self.root.Visible = false

	-------------------------------------------------------------------
	-- Top center: timer + round indicator + countdown overlay
	-------------------------------------------------------------------
	self.timerLabel = UiKit.label({
		Name = "RoundTimer",
		Size = UDim2.fromScale(0.24, 0.085),
		Position = UDim2.fromScale(0.38, 0.012),
		Text = "--",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Accent,
	}, self.root)

	self.roundLabel = UiKit.label({
		Name = "RoundIndicator",
		Size = UDim2.fromScale(0.24, 0.035),
		Position = UDim2.fromScale(0.38, 0.10),
		Text = ("Round -/%d"):format(Config.RoundsPerMatch),
		Font = UiKit.Theme.FontSoft,
		TextColor3 = UiKit.Theme.TextDim,
	}, self.root)

	-- Lobby/flow status line (sits between the board and the corner buttons).
	self.statusLabel = UiKit.label({
		Name = "Status",
		Size = UDim2.fromScale(0.32, 0.035),
		Position = UDim2.fromScale(0.34, 0.138),
		Text = "",
		Font = UiKit.Theme.FontSoft,
		TextColor3 = UiKit.Theme.TextDim,
	}, self.root)

	self.countdownLabel = UiKit.label({
		Name = "Countdown",
		Size = UDim2.fromScale(0.6, 0.22),
		Position = UDim2.fromScale(0.2, 0.30),
		Text = "",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Accent,
		Visible = false,
	}, self.root)

	-------------------------------------------------------------------
	-- Top left: hold-time board
	-------------------------------------------------------------------
	self.boardFrame = UiKit.frame({
		Name = "HoldTimeBoard",
		Size = UDim2.fromScale(0.31, 0.055 + 0.055 * Config.MaxPlayers),
		Position = UDim2.fromScale(0.015, 0.145),
		BackgroundColor3 = UiKit.Theme.Panel,
		BackgroundTransparency = 0.25,
	}, self.root)

	UiKit.label({
		Name = "Header",
		Size = UDim2.fromScale(0.96, 0.055 / (0.055 + 0.055 * Config.MaxPlayers)),
		Position = UDim2.fromScale(0.02, 0.008),
		Text = "HOLD TIME",
		Font = UiKit.Theme.FontMain,
		TextColor3 = UiKit.Theme.TextDim,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.boardFrame)

	self.rows = {}
	local rowHeight = 0.86 / Config.MaxPlayers -- share of board below the header
	for index = 1, Config.MaxPlayers do
		local rowY = 0.12 + (index - 1) * rowHeight
		local row = UiKit.frame({
			Name = "Row" .. index,
			Size = UDim2.fromScale(0.96, rowHeight * 0.86),
			Position = UDim2.fromScale(0.02, rowY),
			BackgroundColor3 = UiKit.Theme.PanelAlt,
			BackgroundTransparency = 0.55,
		}, self.boardFrame)

		local fill = UiKit.frame({
			Name = "Fill",
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = UiKit.Theme.AccentDark,
			BackgroundTransparency = 0.35,
		}, row)

		local nameLabel = UiKit.label({
			Name = "PlayerName",
			Size = UDim2.fromScale(0.62, 0.8),
			Position = UDim2.fromScale(0.025, 0.1),
			Text = "",
			Font = UiKit.Theme.FontMain,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, row)

		local timeLabel = UiKit.label({
			Name = "HoldTime",
			Size = UDim2.fromScale(0.3, 0.8),
			Position = UDim2.fromScale(0.68, 0.1),
			Text = "",
			Font = UiKit.Theme.FontMain,
			TextXAlignment = Enum.TextXAlignment.Right,
		}, row)

		self.rows[index] = {
			frame = row,
			fill = fill,
			nameLabel = nameLabel,
			timeLabel = timeLabel,
		}
	end

	-------------------------------------------------------------------
	-- Left, under the board: steal/event feed
	-------------------------------------------------------------------
	self.feedFrame = UiKit.frame({
		Name = "Feed",
		Size = UDim2.fromScale(0.31, 0.20),
		Position = UDim2.fromScale(0.015, 0.145 + 0.075 + 0.055 * Config.MaxPlayers),
		BackgroundTransparency = 1,
	}, self.root)
	UiKit.listLayout(self.feedFrame, Enum.FillDirection.Vertical, 0.012)

	-------------------------------------------------------------------
	-- Bottom left: stamina bar
	-------------------------------------------------------------------
	self.staminaFrame = UiKit.frame({
		Name = "StaminaBar",
		Size = UDim2.fromScale(0.22, 0.032),
		Position = UDim2.fromScale(0.03, 0.895),
		BackgroundColor3 = UiKit.Theme.Disabled,
	}, self.root)

	self.staminaFill = UiKit.frame({
		Name = "Fill",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UiKit.Theme.Stamina,
	}, self.staminaFrame)

	self.staminaLabel = UiKit.label({
		Name = "Label",
		Size = UDim2.fromScale(0.96, 0.8),
		Position = UDim2.fromScale(0.02, 0.1),
		Text = "STAMINA",
		Font = UiKit.Theme.FontMain,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.staminaFrame)

	-------------------------------------------------------------------
	-- Bottom center: ability buttons
	-------------------------------------------------------------------
	self.abilitiesFrame = UiKit.frame({
		Name = "Abilities",
		Size = UDim2.fromScale(0.48, 0.14),
		Position = UDim2.fromScale(0.26, 0.845),
		BackgroundTransparency = 1,
	}, self.root)

	for index, abilityName in ABILITY_ORDER do
		self:createAbilityButton(index, abilityName)
	end

	-------------------------------------------------------------------
	-- Top right: settings gear (mobile players need mute mid-match)
	-------------------------------------------------------------------
	self.settingsButton = UiKit.button({
		Name = "SettingsButton",
		Size = UDim2.fromScale(0.075, 0.055),
		Position = UDim2.fromScale(0.905, 0.025),
		Text = "SET",
	}, self.root)
	self.settingsButton.Activated:Connect(function()
		if self.OnSettings then self.OnSettings() end
	end)

	-- Small hatchery button (the meta layer lives behind one click, not a
	-- full-screen lobby).
	self.hatcheryButton = UiKit.button({
		Name = "HatcheryButton",
		Size = UDim2.fromScale(0.09, 0.055),
		Position = UDim2.fromScale(0.805, 0.025),
		Text = "HATCHERY",
	}, self.root)
	self.hatcheryButton.Activated:Connect(function()
		if self.OnHatchery then self.OnHatchery() end
	end)

	-- Keep the roster rows fresh as players come and go.
	Players.PlayerAdded:Connect(function() self:refreshBoard() end)
	Players.PlayerRemoving:Connect(function() self:refreshBoard() end)

	-- Bots join/leave via Workspace.Bots (created by the server on demand).
	local function watchBotsFolder(folder)
		folder.ChildAdded:Connect(function() self:refreshBoard() end)
		folder.ChildRemoved:Connect(function() self:refreshBoard() end)
	end
	local botsFolder = Workspace:FindFirstChild("Bots")
	if botsFolder then
		watchBotsFolder(botsFolder)
	else
		Workspace.ChildAdded:Connect(function(child)
			if child.Name == "Bots" then
				watchBotsFolder(child)
			end
		end)
	end

	self:refreshBoard()

	return self
end

---------------------------------------------------------------------------
-- Ability buttons
---------------------------------------------------------------------------

function HudScreen:createAbilityButton(index, abilityName)
	local slotWidth = 0.235
	local gap = (1 - slotWidth * 4) / 5
	local button = UiKit.button({
		Name = abilityName,
		Size = UDim2.fromScale(slotWidth, 0.92),
		Position = UDim2.fromScale(gap + (index - 1) * (slotWidth + gap), 0.04),
		Text = "",
		BackgroundColor3 = UiKit.Theme.Button,
	}, self.abilitiesFrame)
	UiKit.stroke(button, UiKit.Theme.PanelAlt, 2)

	local titleLabel = UiKit.label({
		Name = "Title",
		Size = UDim2.fromScale(0.92, 0.40),
		Position = UDim2.fromScale(0.04, 0.13),
		Text = abilityName,
		Font = UiKit.Theme.FontTitle,
	}, button)

	local stateLabel = UiKit.label({
		Name = "StateLabel",
		Size = UDim2.fromScale(0.96, 0.26),
		Position = UDim2.fromScale(0.02, 0.60),
		Text = "",
		Font = UiKit.Theme.FontSoft,
		TextColor3 = UiKit.Theme.TextDim,
	}, button)

	-- Cooldown wipe: covers the button top-down, shrinks to nothing.
	local cooldown = UiKit.frame({
		Name = "Cooldown",
		Size = UDim2.fromScale(1, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.45,
		Visible = false,
	}, button)

	local entry = {
		button = button,
		titleLabel = titleLabel,
		stateLabel = stateLabel,
		cooldown = cooldown,
		cooldownTween = nil,
		disabled = false,
	}
	self.abilities[abilityName] = entry

	-- Press (mouse down / touch begin) -> down; release -> up. GuiMain maps
	-- these to _G.CTEInput (one-shot abilities ignore isDown=false).
	button.InputBegan:Connect(function(input)
		if UiKit.isPress(input) then
			self:pressAbility(abilityName, true)
		end
	end)
	button.InputEnded:Connect(function(input)
		if UiKit.isPress(input) then
			self:pressAbility(abilityName, false)
		end
	end)
end

function HudScreen:pressAbility(abilityName, isDown)
	if not self.OnAbility then
		return
	end
	if isDown and self.abilities[abilityName].disabled then
		return -- contextually unavailable: do not even send the request
	end
	self.OnAbility(abilityName, isDown)
end

function HudScreen:refreshAbilityStates()
	local attack = self.abilities["ATTACK"]
	local throw = self.abilities["THROW"]
	local dash = self.abilities["DASH"]

	-- Contextual rules (mirrors the server's validation for DISPLAY only).
	attack.disabled = self.hasEgg
	attack.stateLabel.Text = self.hasEgg and "Hands Full" or ""

	throw.disabled = not self.hasEgg
	throw.stateLabel.Text = self.hasEgg and "" or "Need Egg"

	local dashCost = self.hasEgg and Config.DashStaminaCostCarrying or Config.DashStaminaCost
	dash.disabled = self.stamina < dashCost
	dash.stateLabel.Text = dash.disabled and "No Stamina" or ""

	for _, entry in pairs(self.abilities) do
		if entry.disabled then
			entry.button.BackgroundColor3 = UiKit.Theme.Disabled
			entry.titleLabel.TextColor3 = UiKit.Theme.TextDim
		else
			entry.button.BackgroundColor3 = UiKit.Theme.Button
			entry.titleLabel.TextColor3 = UiKit.Theme.Text
		end
	end
end

-- Started by GuiMain from SUCCESS feedback (PunchSwing / DashStart), so the
-- wipe shows for keyboard players too. Purely visual; server stays authority.
function HudScreen:StartCooldown(abilityName, duration)
	local entry = self.abilities[abilityName]
	if not entry or not duration or duration <= 0 then
		return
	end
	if entry.cooldownTween then
		entry.cooldownTween:Cancel()
	end
	entry.cooldown.Visible = true
	entry.cooldown.Size = UDim2.fromScale(1, 1)
	entry.cooldownTween = TweenService:Create(
		entry.cooldown,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(1, 0) }
	)
	entry.cooldownTween.Completed:Connect(function()
		entry.cooldown.Visible = false
	end)
	entry.cooldownTween:Play()
end

---------------------------------------------------------------------------
-- State updates (all driven by remotes / replicated attributes)
---------------------------------------------------------------------------

function HudScreen:SetVisible(visible)
	self.root.Visible = visible
end

-- Small one-line status under the timer ("Waiting for players…", etc).
function HudScreen:SetStatus(text)
	self.statusLabel.Text = text or ""
end

function HudScreen:SetRoundInfo(roundNumber, roundsPerMatch)
	self.roundLabel.Text = ("Round %d/%d"):format(roundNumber, roundsPerMatch or Config.RoundsPerMatch)
end

function HudScreen:SetTimeLeft(seconds)
	self.countdownLabel.Visible = false
	if type(seconds) == "number" then
		self.timerLabel.Text = tostring(math.max(0, math.ceil(seconds)))
	end
end

function HudScreen:ShowCountdown(startsIn)
	if type(startsIn) ~= "number" then
		return
	end
	self.timerLabel.Text = "--"
	self.countdownLabel.Visible = true
	self.countdownLabel.Text = startsIn > 0 and tostring(startsIn) or "GO!"
end

function HudScreen:SetCarrier(carrierPlayerOrNil)
	self.carrier = carrierPlayerOrNil
	self:refreshBoard()
end

function HudScreen:UpdateHoldTimes(entries)
	self.holdTimes = {}
	if type(entries) == "table" then
		for _, entry in ipairs(entries) do
			if entry.Player then
				self.holdTimes[entry.Player] = entry.HoldTime or 0
			end
		end
	end
	self:refreshBoard()
end

function HudScreen:SetHasEgg(hasEgg)
	self.hasEgg = hasEgg and true or false
	self:refreshAbilityStates()
end

function HudScreen:SetStamina(value)
	self.stamina = tonumber(value) or 0
	local fraction = math.clamp(self.stamina / Config.StaminaMax, 0, 1)
	self.staminaFill.Size = UDim2.fromScale(fraction, 1)
	self.staminaLabel.Text = ("STAMINA %d"):format(math.floor(self.stamina + 0.5))
	-- Low stamina reads red.
	if fraction <= 0.25 then
		self.staminaFill.BackgroundColor3 = UiKit.Theme.Bad
	else
		self.staminaFill.BackgroundColor3 = UiKit.Theme.Stamina
	end
	self:refreshAbilityStates()
end

function HudScreen:refreshBoard()
	local localPlayer = Players.LocalPlayer

	-- Display list: players with hold time first (desc), then the rest of the
	-- roster (INCLUDING bots from Workspace.Bots), then empty arena slots.
	local list = {}
	local seen = {}
	local function addEntity(entity)
		if entity == nil or seen[entity] then
			return
		end
		if typeof(entity) == "Instance" and not entity.Parent then
			return -- despawned bot / left player
		end
		seen[entity] = true
		table.insert(list, {
			player = entity,
			time = self.holdTimes[entity] or 0,
		})
	end

	for _, player in ipairs(Players:GetPlayers()) do
		addEntity(player)
	end
	local botsFolder = Workspace:FindFirstChild("Bots")
	if botsFolder then
		for _, model in ipairs(botsFolder:GetChildren()) do
			if model:IsA("Model") then
				addEntity(model)
			end
		end
	end
	-- Anyone still holding time (e.g. a bot that just despawned mid-push).
	for entity in pairs(self.holdTimes) do
		addEntity(entity)
	end
	table.sort(list, function(a, b)
		if math.abs(a.time - b.time) > 0.005 then
			return a.time > b.time
		end
		return a.player.Name < b.player.Name
	end)

	local maxTime = list[1] and list[1].time or 0
	if maxTime < 1 then
		maxTime = 1 -- keeps the fill bar readable early in a round
	end

	for index, row in ipairs(self.rows) do
		local data = list[index]
		if data then
			local isCarrier = (data.player == self.carrier)
			local isLocal = (data.player == localPlayer)
			row.nameLabel.Text = UiKit.playerName(data.player) .. (isLocal and " (you)" or "")
			row.timeLabel.Text = ("%.1fs"):format(data.time)
			row.fill.Size = UDim2.fromScale(math.clamp(data.time / maxTime, 0, 1), 1)

			if isCarrier then
				row.frame.BackgroundColor3 = UiKit.Theme.Accent
				row.frame.BackgroundTransparency = 0.15
				row.nameLabel.TextColor3 = UiKit.Theme.Background
				row.timeLabel.TextColor3 = UiKit.Theme.Background
			else
				row.frame.BackgroundColor3 = UiKit.Theme.PanelAlt
				row.frame.BackgroundTransparency = 0.55
				row.nameLabel.TextColor3 = UiKit.Theme.Text
				row.timeLabel.TextColor3 = UiKit.Theme.TextDim
			end
		else
			row.nameLabel.Text = "—"
			row.timeLabel.Text = ""
			row.fill.Size = UDim2.fromScale(0, 1)
			row.frame.BackgroundColor3 = UiKit.Theme.PanelAlt
			row.frame.BackgroundTransparency = 0.75
			row.nameLabel.TextColor3 = UiKit.Theme.TextDim
		end
	end
end

---------------------------------------------------------------------------
-- Feed
---------------------------------------------------------------------------

function HudScreen:PushFeed(message, color)
	local label = UiKit.label({
		Name = "FeedMessage",
		Size = UDim2.fromScale(1, 0.2),
		Text = message,
		Font = UiKit.Theme.FontMain,
		TextColor3 = color or UiKit.Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		BackgroundTransparency = 1,
	}, self.feedFrame)

	-- Cap the stack: oldest messages go first (count labels, not the layout).
	local function countMessages()
		local count = 0
		for _, child in ipairs(self.feedFrame:GetChildren()) do
			if child:IsA("TextLabel") then
				count = count + 1
			end
		end
		return count
	end
	while countMessages() > FEED_MAX do
		local oldest = nil
		for _, child in ipairs(self.feedFrame:GetChildren()) do
			if child:IsA("TextLabel") then
				oldest = child
				break
			end
		end
		if not oldest then
			break
		end
		oldest:Destroy()
	end

	task.delay(FEED_LIFETIME, function()
		if label.Parent then
			UiKit.tween(label, 0.5, { TextTransparency = 1 })
			task.delay(0.55, function()
				label:Destroy()
			end)
		end
	end)
end

return HudScreen
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX58">
<Properties>
	<string name="Name">ResultsScreens</string>
	<ProtectedString name="Source"><![CDATA[--[[
	ResultsScreens (ModuleScript inside StarterGui.CTEGui)
	======================================================
	Round-end and match-end overlay panels. Pure presentation of the
	RoundEnded / MatchEnded remote payloads (built by ScoringService):

	  ShowRoundEnd(roundNumber, results)   -- winner + ranked round standings
	  ShowMatchEnd(finalStandings)         -- MVP banner + final standings
	                                        -- + Play Again / Back to Lobby

	The two bottom buttons are flow-cosmetic for now: the server returns to
	the lobby automatically after the intermission, so both simply close the
	panel (a ready-up system can wire them to real remotes later).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local ResultsScreens = {}
ResultsScreens.__index = ResultsScreens

local ROW_HEIGHT = 0.075

local function entryName(entry)
	return UiKit.playerName(entry.Player, entry.Name)
end

---------------------------------------------------------------------------
-- Generic ranked-rows panel builder
---------------------------------------------------------------------------

local function buildPanel(parentGui, panelName, size, position)
	local scrim = UiKit.scrim(parentGui, 0.45)
	scrim.Name = panelName .. "Scrim"
	scrim.Visible = false

	local panel = UiKit.frame({
		Name = panelName,
		Size = size,
		Position = position,
		BackgroundColor3 = UiKit.Theme.Panel,
		Visible = false,
	}, parentGui)
	UiKit.stroke(panel, UiKit.Theme.AccentDark, 3)

	return scrim, panel
end

local function makeRow(panel, index, columns, rowTop)
	local row = UiKit.frame({
		Name = "Row" .. index,
		Size = UDim2.fromScale(0.94, ROW_HEIGHT),
		Position = UDim2.fromScale(0.03, rowTop + (index - 1) * (ROW_HEIGHT + 0.012)),
		BackgroundColor3 = UiKit.Theme.PanelAlt,
		BackgroundTransparency = 0.35,
	}, panel)

	local labels = {}
	for columnIndex, column in ipairs(columns) do
		labels[columnIndex] = UiKit.label({
			Name = "Col" .. columnIndex,
			Size = UDim2.fromScale(column.width, 0.72),
			Position = UDim2.fromScale(column.x, 0.14),
			Text = "",
			Font = column.font or UiKit.Theme.FontSoft,
			TextColor3 = UiKit.Theme.Text,
			TextXAlignment = column.align or Enum.TextXAlignment.Left,
		}, row)
	end
	return row, labels
end

function ResultsScreens.Create(parentGui)
	local self = setmetatable({}, ResultsScreens)

	self.OnPlayAgain = nil
	self.OnBackToLobby = nil

	-------------------------------------------------------------------
	-- Round end panel
	-------------------------------------------------------------------
	self.roundScrim, self.roundPanel = buildPanel(
		parentGui, "RoundEndPanel",
		UDim2.fromScale(0.62, 0.62), UDim2.fromScale(0.19, 0.19)
	)

	self.roundTitle = UiKit.label({
		Name = "Title",
		Size = UDim2.fromScale(0.94, 0.10),
		Position = UDim2.fromScale(0.03, 0.03),
		Text = "ROUND",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Accent,
	}, self.roundPanel)

	self.roundWinner = UiKit.label({
		Name = "Winner",
		Size = UDim2.fromScale(0.94, 0.07),
		Position = UDim2.fromScale(0.03, 0.135),
		Text = "",
		Font = UiKit.Theme.FontMain,
	}, self.roundPanel)

	self.roundHeader, self.roundHeaderLabels = makeRow(self.roundPanel, 0, {
		{ x = 0.02, width = 0.08 },
		{ x = 0.11, width = 0.40 },
		{ x = 0.52, width = 0.16, align = Enum.TextXAlignment.Right },
		{ x = 0.69, width = 0.16, align = Enum.TextXAlignment.Right },
		{ x = 0.86, width = 0.12, align = Enum.TextXAlignment.Right },
	}, 0.215)
	self.roundHeader.BackgroundTransparency = 1
	self.roundHeaderLabels[1].Text = "#"
	self.roundHeaderLabels[2].Text = "PLAYER"
	self.roundHeaderLabels[3].Text = "ROUND"
	self.roundHeaderLabels[4].Text = "MATCH"
	self.roundHeaderLabels[5].Text = "WON"
	for _, label in ipairs(self.roundHeaderLabels) do
		label.TextColor3 = UiKit.Theme.TextDim
	end

	self.roundRows = {}
	for index = 1, 6 do
		local row, labels = makeRow(self.roundPanel, index, {
			{ x = 0.02, width = 0.08 },
			{ x = 0.11, width = 0.40 },
			{ x = 0.52, width = 0.16, align = Enum.TextXAlignment.Right },
			{ x = 0.69, width = 0.16, align = Enum.TextXAlignment.Right },
			{ x = 0.86, width = 0.12, align = Enum.TextXAlignment.Right },
		}, 0.215 + ROW_HEIGHT + 0.012)
		self.roundRows[index] = { row = row, labels = labels }
	end

	-------------------------------------------------------------------
	-- Match end panel
	-------------------------------------------------------------------
	self.matchScrim, self.matchPanel = buildPanel(
		parentGui, "MatchEndPanel",
		UDim2.fromScale(0.66, 0.78), UDim2.fromScale(0.17, 0.11)
	)

	UiKit.label({
		Name = "Title",
		Size = UDim2.fromScale(0.94, 0.085),
		Position = UDim2.fromScale(0.03, 0.025),
		Text = "MATCH OVER",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Accent,
	}, self.matchPanel)

	self.mvpBanner = UiKit.label({
		Name = "MVP",
		Size = UDim2.fromScale(0.94, 0.075),
		Position = UDim2.fromScale(0.03, 0.115),
		Text = "",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Good,
	}, self.matchPanel)

	self.matchHeader, self.matchHeaderLabels = makeRow(self.matchPanel, 0, {
		{ x = 0.02, width = 0.08 },
		{ x = 0.11, width = 0.38 },
		{ x = 0.50, width = 0.22, align = Enum.TextXAlignment.Right },
		{ x = 0.73, width = 0.12, align = Enum.TextXAlignment.Right },
		{ x = 0.86, width = 0.12 },
	}, 0.20)
	self.matchHeader.BackgroundTransparency = 1
	self.matchHeaderLabels[1].Text = "#"
	self.matchHeaderLabels[2].Text = "PLAYER"
	self.matchHeaderLabels[3].Text = "TOTAL HOLD"
	self.matchHeaderLabels[4].Text = "WON"
	self.matchHeaderLabels[5].Text = ""
	for _, label in ipairs(self.matchHeaderLabels) do
		label.TextColor3 = UiKit.Theme.TextDim
	end

	self.matchRows = {}
	for index = 1, 6 do
		local row, labels = makeRow(self.matchPanel, index, {
			{ x = 0.02, width = 0.08 },
			{ x = 0.11, width = 0.38 },
			{ x = 0.50, width = 0.22, align = Enum.TextXAlignment.Right },
			{ x = 0.73, width = 0.12, align = Enum.TextXAlignment.Right },
			{ x = 0.86, width = 0.12 },
		}, 0.20 + ROW_HEIGHT + 0.012)
		self.matchRows[index] = { row = row, labels = labels }
	end

	-- Bottom buttons
	self.playAgainButton = UiKit.button({
		Name = "PlayAgain",
		Size = UDim2.fromScale(0.36, 0.085),
		Position = UDim2.fromScale(0.11, 0.875),
		Text = "PLAY AGAIN",
		TextColor3 = UiKit.Theme.Background,
	}, self.matchPanel)
	self.playAgainButton.BackgroundColor3 = UiKit.Theme.Accent

	self.backToLobbyButton = UiKit.button({
		Name = "BackToLobby",
		Size = UDim2.fromScale(0.36, 0.085),
		Position = UDim2.fromScale(0.53, 0.875),
		Text = "BACK TO LOBBY",
	}, self.matchPanel)

	self.playAgainButton.Activated:Connect(function()
		self:HideMatchEnd()
		if self.OnPlayAgain then self.OnPlayAgain() end
	end)
	self.backToLobbyButton.Activated:Connect(function()
		self:HideMatchEnd()
		if self.OnBackToLobby then self.OnBackToLobby() end
	end)

	return self
end

---------------------------------------------------------------------------
-- Round end
---------------------------------------------------------------------------

function ResultsScreens:ShowRoundEnd(roundNumber, results)
	self.roundTitle.Text = ("ROUND %d"):format(roundNumber or 0)

	if results.WinnerName then
		local tieText = results.Tied and "  (tie!)" or ""
		self.roundWinner.Text = ("Winner: %s — %.1fs hold%s"):format(
			UiKit.playerName(results.WinnerPlayer, results.WinnerName),
			results.TopTime or 0, tieText)
		self.roundWinner.TextColor3 = UiKit.Theme.Accent
	else
		self.roundWinner.Text = "Nobody held the egg — no winner"
		self.roundWinner.TextColor3 = UiKit.Theme.TextDim
	end

	for index, entry in ipairs(results.Entries or {}) do
		local row = self.roundRows[index]
		if row then
			row.labels[1].Text = tostring(index)
			row.labels[2].Text = entryName(entry)
			row.labels[3].Text = ("%.1fs"):format(entry.RoundTime or 0)
			row.labels[4].Text = ("%.1fs"):format(entry.MatchTime or 0)
			row.labels[5].Text = tostring(entry.RoundsWon or 0)

			if entry.IsWinner then
				row.row.BackgroundColor3 = UiKit.Theme.AccentDark
				row.row.BackgroundTransparency = 0.15
			else
				row.row.BackgroundColor3 = UiKit.Theme.PanelAlt
				row.row.BackgroundTransparency = 0.35
			end
			row.row.Visible = true
		end
	end
	for index = #(results.Entries or {}) + 1, #self.roundRows do
		self.roundRows[index].row.Visible = false
	end

	self.roundScrim.Visible = true
	self.roundPanel.Visible = true
end

function ResultsScreens:HideRoundEnd()
	self.roundScrim.Visible = false
	self.roundPanel.Visible = false
end

---------------------------------------------------------------------------
-- Match end
---------------------------------------------------------------------------

function ResultsScreens:ShowMatchEnd(final)
	if #final.MVPNames > 0 then
		self.mvpBanner.Text = ("★ MVP: %s — %.1fs total hold ★"):format(
			table.concat(final.MVPNames, " + "), final.BestTotalHoldTime or 0)
	else
		self.mvpBanner.Text = "★ MVP: nobody — no hold time recorded ★"
	end

	for index, entry in ipairs(final.Standings or {}) do
		local row = self.matchRows[index]
		if row then
			row.labels[1].Text = tostring(index)
			row.labels[2].Text = entryName(entry)
			row.labels[3].Text = ("%.1fs"):format(entry.TotalHoldTime or 0)
			row.labels[4].Text = tostring(entry.RoundsWon or 0)
			row.labels[5].Text = (entry.IsMVP and "★" or "") .. (entry.Left and "left" or "")
			row.labels[5].TextColor3 = entry.IsMVP and UiKit.Theme.Accent or UiKit.Theme.TextDim

			if entry.IsMVP then
				row.row.BackgroundColor3 = UiKit.Theme.AccentDark
				row.row.BackgroundTransparency = 0.1
			else
				row.row.BackgroundColor3 = UiKit.Theme.PanelAlt
				row.row.BackgroundTransparency = 0.35
			end
			row.row.Visible = true
		end
	end
	for index = #(final.Standings or {}) + 1, #self.matchRows do
		self.matchRows[index].row.Visible = false
	end

	self.matchScrim.Visible = true
	self.matchPanel.Visible = true
end

function ResultsScreens:HideMatchEnd()
	self.matchScrim.Visible = false
	self.matchPanel.Visible = false
end

return ResultsScreens
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX59">
<Properties>
	<string name="Name">SettingsPanel</string>
	<ProtectedString name="Source"><![CDATA[--[[
	SettingsPanel (ModuleScript inside StarterGui.CTEGui)
	=====================================================
	Simple settings overlay:
	  * Mute toggle -- actually sets SoundService.Volume (0/1) for this client.
	  * Sensitivity stepper -- PLACEHOLDER: stores the value on _G.CTESettings
	    and does nothing else until camera/gameplay code consumes it later.

	Api:
	  SettingsPanel.Create(parentGui) -> panel
	  panel:Toggle() / panel:SetVisible(bool)
]]

local SoundService = game:GetService("SoundService")

local UiKit = require(script.Parent:WaitForChild("UiKit"))

local SettingsPanel = {}
SettingsPanel.__index = SettingsPanel

function SettingsPanel.Create(parentGui)
	local self = setmetatable({}, SettingsPanel)

	self.muted = false
	self.sensitivity = 5

	_G.CTESettings = _G.CTESettings or {}
	_G.CTESettings.Sensitivity = self.sensitivity

	self.scrim = UiKit.scrim(parentGui, 0.5)
	self.scrim.Name = "SettingsScrim"
	self.scrim.Visible = false

	self.panel = UiKit.frame({
		Name = "SettingsPanel",
		Size = UDim2.fromScale(0.44, 0.46),
		Position = UDim2.fromScale(0.28, 0.27),
		BackgroundColor3 = UiKit.Theme.Panel,
		Visible = false,
	}, parentGui)
	UiKit.stroke(self.panel, UiKit.Theme.AccentDark, 3)

	UiKit.label({
		Name = "Title",
		Size = UDim2.fromScale(0.8, 0.12),
		Position = UDim2.fromScale(0.05, 0.04),
		Text = "SETTINGS",
		Font = UiKit.Theme.FontTitle,
		TextColor3 = UiKit.Theme.Accent,
	}, self.panel)

	self.closeButton = UiKit.button({
		Name = "Close",
		Size = UDim2.fromScale(0.09, 0.10),
		Position = UDim2.fromScale(0.88, 0.035),
		Text = "X",
	}, self.panel)

	-- Mute row
	UiKit.label({
		Name = "SoundLabel",
		Size = UDim2.fromScale(0.45, 0.10),
		Position = UDim2.fromScale(0.05, 0.24),
		Text = "Sound",
		Font = UiKit.Theme.FontMain,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	self.muteButton = UiKit.button({
		Name = "MuteToggle",
		Size = UDim2.fromScale(0.4, 0.11),
		Position = UDim2.fromScale(0.55, 0.235),
		Text = "MUTE: OFF",
	}, self.panel)

	-- Sensitivity row (placeholder)
	UiKit.label({
		Name = "SensLabel",
		Size = UDim2.fromScale(0.45, 0.10),
		Position = UDim2.fromScale(0.05, 0.44),
		Text = "Sensitivity",
		Font = UiKit.Theme.FontMain,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, self.panel)

	self.sensDown = UiKit.button({
		Name = "SensDown",
		Size = UDim2.fromScale(0.11, 0.11),
		Position = UDim2.fromScale(0.55, 0.435),
		Text = "-",
	}, self.panel)

	self.sensValue = UiKit.label({
		Name = "SensValue",
		Size = UDim2.fromScale(0.14, 0.10),
		Position = UDim2.fromScale(0.675, 0.44),
		Text = tostring(self.sensitivity),
	}, self.panel)

	self.sensUp = UiKit.button({
		Name = "SensUp",
		Size = UDim2.fromScale(0.11, 0.11),
		Position = UDim2.fromScale(0.83, 0.435),
		Text = "+",
	}, self.panel)

	UiKit.label({
		Name = "SensNote",
		Size = UDim2.fromScale(0.9, 0.08),
		Position = UDim2.fromScale(0.05, 0.58),
		Text = "Sensitivity is a placeholder — it is not wired to anything yet.",
		Font = UiKit.Theme.FontSoft,
		TextColor3 = UiKit.Theme.TextDim,
		TextWrapped = true,
	}, self.panel)

	-- Wiring
	self.closeButton.Activated:Connect(function()
		self:SetVisible(false)
	end)
	self.scrim.InputBegan:Connect(function(input)
		if UiKit.isPress(input) then
			self:SetVisible(false)
		end
	end)

	self.muteButton.Activated:Connect(function()
		self.muted = not self.muted
		self.muteButton.Text = self.muted and "MUTE: ON" or "MUTE: OFF"
		self.muteButton.BackgroundColor3 = self.muted
			and UiKit.Theme.Bad or UiKit.Theme.Button
		-- Real (client-local) mute:
		pcall(function()
			SoundService.Volume = self.muted and 0 or 1
		end)
	end)

	self.sensDown.Activated:Connect(function()
		self.sensitivity = math.max(1, self.sensitivity - 1)
		self:refreshSensitivity()
	end)
	self.sensUp.Activated:Connect(function()
		self.sensitivity = math.min(10, self.sensitivity + 1)
		self:refreshSensitivity()
	end)

	return self
end

function SettingsPanel:refreshSensitivity()
	self.sensValue.Text = tostring(self.sensitivity)
	_G.CTESettings = _G.CTESettings or {}
	_G.CTESettings.Sensitivity = self.sensitivity
	-- TODO(settings): consumed by camera/aim code in a later pass.
end

function SettingsPanel:SetVisible(visible)
	self.scrim.Visible = visible
	self.panel.Visible = visible
end

function SettingsPanel:Toggle()
	self:SetVisible(not self.panel.Visible)
end

return SettingsPanel
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX60">
<Properties>
	<string name="Name">UiKit</string>
	<ProtectedString name="Source"><![CDATA[--[[
	UiKit (ModuleScript inside StarterGui.CTEGui)
	=============================================
	Tiny helper library for building clean, mobile-friendly GUI in code.

	Rules enforced here:
	  * ALL sizes/positions use Scale only (UDim2.fromScale / UDim.fromScale)
	    so everything scales from phones to desktops. No Offset sizing.
	  * Every text element uses TextScaled = true.
	  * One shared Theme table -> restyling the whole game later = edit here.
]]

local TweenService = game:GetService("TweenService")

local UiKit = {}

---------------------------------------------------------------------------
-- Theme (restyle the whole game by editing this table)
---------------------------------------------------------------------------

UiKit.Theme = {
	Background = Color3.fromRGB(20, 22, 30),
	Panel = Color3.fromRGB(32, 35, 46),
	PanelAlt = Color3.fromRGB(43, 47, 61),
	Button = Color3.fromRGB(55, 60, 78),
	Accent = Color3.fromRGB(255, 200, 60),   -- egg gold
	AccentDark = Color3.fromRGB(122, 95, 32),
	Text = Color3.fromRGB(238, 240, 246),
	TextDim = Color3.fromRGB(158, 164, 180),
	Good = Color3.fromRGB(110, 210, 130),
	Bad = Color3.fromRGB(235, 95, 95),
	Info = Color3.fromRGB(95, 170, 255),
	Stamina = Color3.fromRGB(90, 200, 250),
	Disabled = Color3.fromRGB(26, 28, 36),
	Scrim = Color3.fromRGB(10, 11, 15),
	FontTitle = Enum.Font.GothamBlack,
	FontMain = Enum.Font.GothamBold,
	FontSoft = Enum.Font.Gotham,
	Corner = UDim.new(0.14, 0), -- scale-based rounding (no offsets)
}

---------------------------------------------------------------------------
-- Core helpers
---------------------------------------------------------------------------

local function withDefaults(defaults, overrides)
	local props = {}
	for key, value in pairs(defaults) do
		props[key] = value
	end
	for key, value in pairs(overrides or {}) do
		props[key] = value
	end
	return props
end

function UiKit.new(className, props, parent)
	local instance = Instance.new(className)
	for key, value in pairs(props or {}) do
		instance[key] = value
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UiKit.corner(instance, radius)
	return UiKit.new("UICorner", { CornerRadius = radius or UiKit.Theme.Corner }, instance)
end

function UiKit.stroke(instance, color, thickness, transparency)
	return UiKit.new("UIStroke", {
		Color = color or UiKit.Theme.PanelAlt,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, instance)
end

function UiKit.frame(props, parent)
	local frame = UiKit.new("Frame", withDefaults({
		BackgroundColor3 = UiKit.Theme.Panel,
		BorderSizePixel = 0,
	}, props), parent)
	if frame.BackgroundTransparency == 0 then
		UiKit.corner(frame)
	end
	return frame
end

function UiKit.label(props, parent)
	return UiKit.new("TextLabel", withDefaults({
		BackgroundTransparency = 1,
		Text = "",
		TextScaled = true,
		TextColor3 = UiKit.Theme.Text,
		Font = UiKit.Theme.FontMain,
		RichText = true,
		TextTruncate = Enum.TextTruncate.Ellipsis,
	}, props), parent)
end

function UiKit.button(props, parent)
	local button = UiKit.new("TextButton", withDefaults({
		BackgroundColor3 = UiKit.Theme.Button,
		BorderSizePixel = 0,
		Text = "",
		TextScaled = true,
		TextColor3 = UiKit.Theme.Text,
		Font = UiKit.Theme.FontMain,
		AutoButtonColor = true,
	}, props), parent)
	UiKit.corner(button)
	return button
end

-- Scale-only padding (UIPadding accepts UDim; scale works relative to parent).
function UiKit.padding(parent, all)
	return UiKit.new("UIPadding", {
		PaddingTop = UDim.new(all, 0),
		PaddingBottom = UDim.new(all, 0),
		PaddingLeft = UDim.new(all, 0),
		PaddingRight = UDim.new(all, 0),
	}, parent)
end

function UiKit.listLayout(parent, fillDirection, padding, horizontalAlign, verticalAlign)
	return UiKit.new("UIListLayout", {
		FillDirection = fillDirection or Enum.FillDirection.Vertical,
		Padding = UDim.new(padding or 0.02, 0),
		HorizontalAlignment = horizontalAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = verticalAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, parent)
end

function UiKit.tween(instance, time, props, style)
	local info = TweenInfo.new(time, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tween = TweenService:Create(instance, info, props)
	tween:Play()
	return tween
end

-- A dark full-screen scrim used behind overlay panels.
function UiKit.scrim(parent, transparency)
	return UiKit.new("Frame", {
		Name = "Scrim",
		BackgroundColor3 = UiKit.Theme.Scrim,
		BackgroundTransparency = transparency or 0.35,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	}, parent)
end

---------------------------------------------------------------------------
-- Misc
---------------------------------------------------------------------------

-- Display-friendly name for any participant. Handles Players, bot Models
-- (Workspace.Bots -- prefer the Humanoid DisplayName, tag them as bots) and
-- nil (ghost standings fall back to the stored name).
function UiKit.playerName(playerOrNil, fallbackName)
	if playerOrNil then
		if playerOrNil:IsA("Player") then
			local displayName = playerOrNil.DisplayName
			if displayName and displayName ~= "" then
				return displayName
			end
			return playerOrNil.Name
		end
		local humanoid = playerOrNil:FindFirstChildOfClass("Humanoid")
		if humanoid then
			local displayName = humanoid.DisplayName
			if displayName and displayName ~= "" then
				if humanoid:GetAttribute("IsBot") then
					return displayName .. " (bot)"
				end
				return displayName
			end
		end
		return playerOrNil.Name
	end
	return fallbackName or "?"
end

-- True when a GuiObject input should count as a "press" (mouse click/touch).
function UiKit.isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

return UiKit
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPack" referent="RBX61">
<Properties>
	<string name="Name">StarterPack</string>
</Properties>
</Item>
<Item class="StarterPlayer" referent="RBX62">
<Properties>
	<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterCharacterScripts" referent="RBX63">
<Properties>
	<string name="Name">StarterCharacterScripts</string>
</Properties>
<Item class="LocalScript" referent="RBX64">
<Properties>
	<bool name="Disabled">false</bool>
	<string name="Name">Animations</string>
	<ProtectedString name="Source"><![CDATA[--[[
	Animations (StarterPlayer.StarterCharacterScripts.Animations)
	=============================================================
	Plays character animations in response to server FeedbackEvents for the
	LocalPlayer (dash, punch, throw) and replicated state (block/sprint
	loops, carry loop via the HasEgg attribute).

	Animation IDs live in Config.Animations. An EMPTY STRING means "not
	uploaded yet" and is skipped silently -- so this system is fully wired
	now and starts animating the moment real animation asset IDs are pasted
	into Config (Creator Dashboard -> Animations -> upload -> rbxassetid://).

	Mapping:
	  DashStart   -> Config.Animations.Dash    (one-shot)
	  PunchSwing  -> Config.Animations.Attack  (one-shot)
	  EggThrown   -> Config.Animations.Throw   (one-shot)
	  BlockStart/BlockEnd/BlockBroken -> Config.Animations.Block  (loop)
	  SprintStart/SprintEnd           -> Config.Animations.Sprint (loop)
	  HasEgg attribute true/false     -> Config.Animations.Carry  (loop)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
local FeedbackEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("FeedbackEvent")

local player = Players.LocalPlayer
local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")
local animator = humanoid:WaitForChild("Animator")

local tracks = {} -- kind -> AnimationTrack | false (false = tried, unavailable)

local function getTrack(kind)
	if tracks[kind] ~= nil then
		return tracks[kind] or nil
	end

	local id = Config.Animations and Config.Animations[kind]
	if type(id) ~= "string" or id == "" then
		tracks[kind] = false -- not uploaded yet: skip silently
		return nil
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = id
	local ok, track = pcall(function()
		return animator:LoadAnimation(animation)
	end)
	animation:Destroy()

	if ok and track then
		tracks[kind] = track
		return track
	end

	warn("[Animations] Could not load '" .. kind .. "' animation (" .. id .. ")")
	tracks[kind] = false
	return nil
end

local function playOneShot(kind)
	local track = getTrack(kind)
	if track then
		track:Stop(0)
		track:Play(0.1)
	end
end

local function startLoop(kind)
	local track = getTrack(kind)
	if track then
		track.Looped = true
		track:Play(0.15)
	end
end

local function stopLoop(kind)
	local track = getTrack(kind)
	if track then
		track:Stop(0.15)
	end
end

-- World feedback: only animate the LocalPlayer's own events.
FeedbackEvent.OnClientEvent:Connect(function(kind, data)
	if type(data) ~= "table" or data.Player ~= player then
		return
	end
	if kind == "DashStart" then
		playOneShot("Dash")
	elseif kind == "PunchSwing" then
		playOneShot("Attack")
	elseif kind == "EggThrown" then
		playOneShot("Throw")
	elseif kind == "BlockStart" then
		startLoop("Block")
	elseif kind == "BlockEnd" or kind == "BlockBroken" then
		stopLoop("Block")
	elseif kind == "SprintStart" then
		startLoop("Sprint")
	elseif kind == "SprintEnd" then
		stopLoop("Sprint")
	end
end)

-- Carry loop: driven by the replicated HasEgg attribute (survives across
-- pickup/fumble/throw without extra remotes).
local function updateCarryLoop()
	if player:GetAttribute("HasEgg") then
		startLoop("Carry")
	else
		stopLoop("Carry")
	end
end

player:GetAttributeChangedSignal("HasEgg"):Connect(updateCarryLoop)
updateCarryLoop()
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX65">
<Properties>
	<bool name="Disabled">false</bool>
	<string name="Name">ClientInput</string>
	<ProtectedString name="Source"><![CDATA[--[[
	ClientInput (StarterPlayer.StarterCharacterScripts.ClientInput)
	===============================================================
	Client-side input controller (runs on every character spawn).

	Philosophy: this script ONLY translates input into Request* RemoteEvent
	fires. It never applies gameplay locally -- the server validates cooldowns,
	stamina and the contextual rules (has egg / hands full) and rejects
	cheaters. The only client-side gating is a soft possession check (don't
	even send obviously-invalid requests); the server re-checks everything.

	Bindings
	--------
	  Attack : Left Mouse, Gamepad X         (only when NOT carrying)
	  Throw  : Q or F, Gamepad Y             (only when carrying)
	  Block  : Right Mouse (hold), Gamepad L1
	  Dash   : E, Gamepad R1                 (Space is pure jump again)
	  Sprint : Left Shift (hold), Gamepad R2 -- drains stamina while held

	Mobile: ContextActionService touch buttons are created for all five
	abilities as a functional placeholder. The real mobile GUI comes in a
	later prompt and should call the exposed functions below.

	GUI hook (later prompt): the API is exposed on _G for other client
	scripts (ScreenGui buttons live in a different LocalScript):
	  _G.CTEInput.Attack()
	  _G.CTEInput.Throw()
	  _G.CTEInput.Dash()
	  _G.CTEInput.Block(true)    -- press
	  _G.CTEInput.Block(false)   -- release
	  _G.CTEInput.Sprint(true)   -- press
	  _G.CTEInput.Sprint(false)  -- release

	TODO(gui): when real buttons exist, consider sinking MouseButton1 here or
	unbinding it so clicks on the HUD do not also punch.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RequestAttack = Remotes:WaitForChild("RequestAttack")
local RequestThrow = Remotes:WaitForChild("RequestThrow")
local RequestDash = Remotes:WaitForChild("RequestDash")
local RequestBlockStart = Remotes:WaitForChild("RequestBlockStart")
local RequestBlockEnd = Remotes:WaitForChild("RequestBlockEnd")
local RequestSprintStart = Remotes:WaitForChild("RequestSprintStart")
local RequestSprintEnd = Remotes:WaitForChild("RequestSprintEnd")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local player = Players.LocalPlayer

---------------------------------------------------------------------------
-- Ability requests (also the public API for the future GUI)
---------------------------------------------------------------------------

local function attack()
	-- Soft gate only: the server is authoritative and answers "HandsFull".
	if player:GetAttribute("HasEgg") then
		return
	end
	RequestAttack:FireServer()
end

local function throwEgg()
	-- Soft gate only: the server answers "NotCarrying" if we are wrong.
	if not player:GetAttribute("HasEgg") then
		return
	end
	RequestThrow:FireServer()
end

local function dash()
	RequestDash:FireServer()
end

-- Hold-style abilities (block/sprint): mouse button + key can overlap, so
-- count the holds and only tell the server about the first press / final
-- release.
local blockDepth = 0

local function setBlocking(blocking)
	if blocking then
		blockDepth = blockDepth + 1
		if blockDepth == 1 then
			RequestBlockStart:FireServer()
		end
	else
		blockDepth = math.max(0, blockDepth - 1)
		if blockDepth == 0 then
			RequestBlockEnd:FireServer()
		end
	end
end

local sprintDepth = 0

local function setSprinting(sprinting)
	if sprinting then
		sprintDepth = sprintDepth + 1
		if sprintDepth == 1 then
			RequestSprintStart:FireServer()
		end
	else
		sprintDepth = math.max(0, sprintDepth - 1)
		if sprintDepth == 0 then
			RequestSprintEnd:FireServer()
		end
	end
end

_G.CTEInput = {
	Attack = attack,
	Throw = throwEgg,
	Dash = dash,
	Block = setBlocking,
	Sprint = setSprinting,
}

---------------------------------------------------------------------------
-- ContextActionService bindings (keyboard + mouse + gamepad + touch buttons)
---------------------------------------------------------------------------

local function attackAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		attack()
	end
	return Enum.ContextActionResult.Pass
end

local function throwAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		throwEgg()
	end
	return Enum.ContextActionResult.Pass
end

local function dashAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		dash()
	end
	return Enum.ContextActionResult.Pass
end

local function holdAction(setter)
	return function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			setter(true)
		elseif inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel then
			setter(false)
		end
		return Enum.ContextActionResult.Pass
	end
end

-- createTouchButton = true gives free (ugly) on-screen buttons on mobile
-- until the real GUI is wired up. Rebinding the same names on respawn
-- replaces the previous character's bindings.
ContextActionService:BindAction("CTE_Attack", attackAction, true,
	Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonX)
ContextActionService:BindAction("CTE_Throw", throwAction, true,
	Enum.KeyCode.Q, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
ContextActionService:BindAction("CTE_Block", holdAction(setBlocking), true,
	Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL1)
ContextActionService:BindAction("CTE_Dash", dashAction, true,
	Enum.KeyCode.E, Enum.KeyCode.ButtonR1)
ContextActionService:BindAction("CTE_Sprint", holdAction(setSprinting), true,
	Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonR2)

---------------------------------------------------------------------------
-- Personal feedback (rejection reasons) -- print for now, GUI toast later
---------------------------------------------------------------------------

local PERSONAL_FEEDBACK = {
	HandsFull = true,
	NotCarrying = true,
	NoStamina = true,
	OnCooldown = true,
	Stunned = true,
	PunchWhiff = true,
	Exhausted = true,
}

FeedbackEvent.OnClientEvent:Connect(function(kind, data)
	if PERSONAL_FEEDBACK[kind] and Config.DebugVerboseLogging then
		local ability = type(data) == "table" and data.Ability or ""
		print(("[CTE] %s %s"):format(kind, ability)) -- TODO(gui): toast/flash instead
	end
end)
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="StarterPlayerScripts" referent="RBX66">
<Properties>
	<string name="Name">StarterPlayerScripts</string>
</Properties>

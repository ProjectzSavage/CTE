<Item class="ServerScriptService" referent="RBX32">
<Properties>
	<string name="Name">ServerScriptService</string>
</Properties>
<Item class="ModuleScript" referent="RBX33">
<Properties>
	<string name="Name">CombatService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	CombatService (ServerScriptService.CombatService)
	=================================================
	Server-authoritative abilities: Attack, Throw, Block, Dash + the shared
	stamina pool. Clients only fire Request* RemoteEvents; EVERY rule is
	checked here (context, cooldown, stamina, alive/stun state). Cheaters get
	rejected and nothing happens.

	Ability rules (from the game spec)
	----------------------------------
	Attack : ONLY when NOT holding the egg ("HandsFull" feedback otherwise).
	         Short-range punch (Config.AttackRange + forward hemisphere).
	         On hit: knockback (Config.AttackKnockback) + brief hitstun.
	         If the victim is the carrier: EggService.Fumble with a knock-loose
	         pop -> "EggStolen" feedback. Cooldown Config.AttackCooldown.
	Throw  : ONLY when holding the egg. Launches it via EggService.ReleaseThrow
	         at Config.ThrowSpeed with an upward lob. While "hot", the thrown
	         egg knocks players back and bounces loose (HandleEggImpact).
	Block  : ALWAYS usable. Incoming knockback reduced by
	         Config.BlockKnockbackReduction, move speed multiplied by
	         Config.BlockSpeedMultiplier, drains Config.BlockStaminaDrain/s.
	         A blocking carrier STILL accrues hold time (EggService does not
	         care about blocking). Block breaks automatically at 0 stamina.
	Dash   : ALWAYS usable. Speed burst for Config.DashDuration. NOT carrying:
	         brief i-frames (Config.DashIFrames). Carrying: shorter dash, NO
	         i-frames, and colliding with a player fumbles the egg
	         ("DashFumble" feedback + small knockback to the victim).

	Stamina: max Config.StaminaMax, regenerates Config.StaminaRegenPerSecond
	         after Config.StaminaRegenDelay without spending. Dash and Attack
	         cost stamina up front; Block drains while held. Published to
	         clients as the "Stamina" Player attribute (rounded) for the future
	         HUD.

	Speed ownership: this module is the ONLY writer of Humanoid.WalkSpeed.
	         Base = carrier ? CarrySpeed : WalkSpeed, then block/stun/dash
	         modifiers. Recalculated every tick (writes only on change) plus
	         on HasEgg attribute changes.

	FeedbackEvent kinds fired here
	------------------------------
	FireAllClients : PunchSwing, PunchHit, BlockedHit, IFrameDodge, EggStolen,
	                 DashStart, DashFumble, BlockStart, BlockEnd, BlockBroken
	FireClient     : HandsFull, NotCarrying, NoStamina, OnCooldown, Stunned,
	                 PunchWhiff
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))
-- One-directional dependency: CombatService may use EggService, never the
-- reverse (EggService calls back through the injected impact handler).
local EggService = require(ServerScriptService:WaitForChild("EggService"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RequestAttack = Remotes:WaitForChild("RequestAttack")
local RequestThrow = Remotes:WaitForChild("RequestThrow")
local RequestDash = Remotes:WaitForChild("RequestDash")
local RequestBlockStart = Remotes:WaitForChild("RequestBlockStart")
local RequestBlockEnd = Remotes:WaitForChild("RequestBlockEnd")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local CombatService = {}

local COMBAT_TICK = 0.05 -- 20 Hz: stamina, dash windows, collisions, speed recalc

---------------------------------------------------------------------------
-- Per-player combat state (server only)
---------------------------------------------------------------------------

local statuses = {} -- { [Player] = status }
local lastTickTime = 0
local initialized = false

local function now()
	return os.clock()
end

local function newStatus()
	return {
		stamina = Config.StaminaMax,
		publishedStamina = -1, -- forces the first attribute publish
		lastSpendTime = -math.huge,
		blocking = false,
		attackReadyAt = 0,
		dashReadyAt = 0,
		dashUntil = 0,
		dashSpeed = Config.WalkSpeed,
		dashCollisionDone = false,
		iFramesUntil = 0,
		stunUntil = 0,
	}
end

local function getStatus(player)
	local status = statuses[player]
	if not status then
		status = newStatus()
		statuses[player] = status
	end
	return status
end

---------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------

local function getAliveCharacter(player)
	local character = player.Character
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character
end

local function getRoot(player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function broadcastFeedback(kind, data)
	FeedbackEvent:FireAllClients(kind, data or {})
end

local function rejectClient(player, kind, data)
	data = data or {}
	FeedbackEvent:FireClient(player, kind, data)
end

local function spendStamina(status, amount)
	if status.stamina < amount then
		return false
	end
	status.stamina = status.stamina - amount
	status.lastSpendTime = now()
	return true
end

-- The single authority for movement speed. Called every tick and on state
-- flips; only writes when the value actually changes (no property churn).
local function recalcSpeed(player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local status = getStatus(player)
	local nowv = now()
	local speed

	if nowv < status.stunUntil then
		speed = 0 -- hitstun: rooted in place
	elseif nowv < status.dashUntil then
		speed = status.dashSpeed -- dash burst overrides everything
	else
		local isCarrier = (EggService.GetCarrier() == player)
		speed = isCarrier and Config.CarrySpeed or Config.WalkSpeed
		if status.blocking then
			speed = speed * Config.BlockSpeedMultiplier
		end
	end

	if math.abs(humanoid.WalkSpeed - speed) > 0.01 then
		humanoid.WalkSpeed = speed
	end
end

---------------------------------------------------------------------------
-- Knockback (shared by punches, thrown-egg impacts and dash collisions)
---------------------------------------------------------------------------

--[[
	CombatService.ApplyKnockback(player, direction, force, upwardForce, stunTime)
	  direction   : Vector3 push direction (flattened to horizontal internally)
	  force       : horizontal speed applied (studs/s)
	  upwardForce : vertical pop (studs/s), optional
	  stunTime    : seconds of rooted hitstun, optional (blocked victims skip it)

	Returns "Hit" | "Blocked" | "IFramed" | "Invalid".
]]
function CombatService.ApplyKnockback(player, direction, force, upwardForce, stunTime)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return "Invalid"
	end
	if typeof(direction) ~= "Vector3" then
		return "Invalid"
	end

	local status = getStatus(player)
	local nowv = now()
	if nowv < status.iFramesUntil then
		return "IFramed"
	end

	local root = getRoot(player)
	if not root then
		return "Invalid"
	end

	local flat = Vector3.new(direction.X, 0, direction.Z)
	if flat.Magnitude < 0.001 then
		flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if flat.Magnitude < 0.001 then
			flat = Vector3.new(0, 0, 1)
		end
	end
	flat = flat.Unit

	local appliedForce = force
	local appliedUp = upwardForce or 0
	local blocked = status.blocking
	if blocked then
		appliedForce = appliedForce * (1 - Config.BlockKnockbackReduction)
		appliedUp = appliedUp * (1 - Config.BlockKnockbackReduction)
	end

	root.AssemblyLinearVelocity = Vector3.new(flat.X * appliedForce, appliedUp, flat.Z * appliedForce)

	if stunTime and stunTime > 0 and not blocked then
		status.stunUntil = nowv + stunTime
	end
	recalcSpeed(player)

	return blocked and "Blocked" or "Hit"
end

---------------------------------------------------------------------------
-- Attack
---------------------------------------------------------------------------

local function handleAttack(player)
	local character = getAliveCharacter(player)
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local status = getStatus(player)
	local nowv = now()

	-- Contextual rule: HANDS FULL -- no punching while carrying the egg.
	if EggService.GetCarrier() == player then
		rejectClient(player, "HandsFull", { Ability = "Attack" })
		return
	end
	if nowv < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Attack" })
		return
	end
	if nowv < status.attackReadyAt then
		rejectClient(player, "OnCooldown", { Ability = "Attack" })
		return
	end
	if not spendStamina(status, Config.AttackStaminaCost) then
		rejectClient(player, "NoStamina", { Ability = "Attack" })
		return
	end

	status.attackReadyAt = nowv + Config.AttackCooldown
	broadcastFeedback("PunchSwing", { Player = player, Position = root.Position })

	-- Hit detection: everyone inside range AND in the forward hemisphere.
	local look = root.CFrame.LookVector
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	if lookFlat.Magnitude > 0.001 then
		lookFlat = lookFlat.Unit
	else
		lookFlat = nil -- looking straight up/down: accept any direction
	end

	local hits = 0
	for _, victim in ipairs(Players:GetPlayers()) do
		if victim ~= player then
			local victimRoot = getRoot(victim)
			local victimCharacter = getAliveCharacter(victim)
			if victimRoot and victimCharacter then
				local offset = victimRoot.Position - root.Position
				local distance = offset.Magnitude
				-- +1 stud accounts for the victim's body radius.
				if distance <= Config.AttackRange + 1 then
					local pushDir = Vector3.new(offset.X, 0, offset.Z)
					if pushDir.Magnitude < 0.001 then
						-- Point-blank (dead center): push wherever we face.
						pushDir = lookFlat or Vector3.new(0, 0, 1)
					end
					pushDir = pushDir.Unit

					local inCone = (lookFlat == nil)
						or (lookFlat:Dot(pushDir) >= Config.AttackFacingDot)
					if inCone then
						hits = hits + 1

						local victimWasCarrier = (EggService.GetCarrier() == victim)
						local victimIFramed = (nowv < getStatus(victim).iFramesUntil)

						local result = CombatService.ApplyKnockback(
							victim, pushDir,
							Config.AttackKnockback, Config.AttackUpwardKnockback,
							Config.AttackHitstun
						)

						broadcastFeedback("PunchHit", {
							Attacker = player,
							Victim = victim,
							Position = victimRoot.Position,
							Result = result,
						})
						if result == "Blocked" then
							broadcastFeedback("BlockedHit", {
								Attacker = player,
								Victim = victim,
								Position = victimRoot.Position,
							})
						elseif result == "IFramed" then
							broadcastFeedback("IFrameDodge", {
								Attacker = player,
								Victim = victim,
								Position = victimRoot.Position,
							})
						end

						-- Steal: punching the carrier knocks the egg loose
						-- (i-framed carriers keep it -- the punch fully whiffed).
						if victimWasCarrier and not victimIFramed then
							EggService.Fumble(
								victim,
								"Attacked",
								Vector3.new(
									pushDir.X * Config.EggKnockLooseSpeed,
									Config.EggKnockLooseUpward,
									pushDir.Z * Config.EggKnockLooseSpeed
								)
							)
							broadcastFeedback("EggStolen", {
								Attacker = player,
								Victim = victim,
								Position = victimRoot.Position,
							})
						end
					end
				end
			end
		end
	end

	if hits == 0 then
		rejectClient(player, "PunchWhiff", {})
	end

	if Config.DebugVerboseLogging and hits > 0 then
		print("[CombatService] " .. player.Name .. " punched " .. hits .. " target(s)")
	end
end

---------------------------------------------------------------------------
-- Throw
---------------------------------------------------------------------------

local function handleThrow(player)
	local character = getAliveCharacter(player)
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local status = getStatus(player)

	-- Contextual rule: can only throw WHILE carrying.
	if EggService.GetCarrier() ~= player then
		rejectClient(player, "NotCarrying", { Ability = "Throw" })
		return
	end
	if now() < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Throw" })
		return
	end

	-- Throw where the character faces; EggService adds the lob + "hot" window
	-- and fires the "EggThrown" feedback. Hold time stops the instant it
	-- leaves the hands (possession ends inside ReleaseThrow).
	EggService.ReleaseThrow(player, root.CFrame.LookVector)
end

---------------------------------------------------------------------------
-- Dash
---------------------------------------------------------------------------

local function handleDash(player)
	local character = getAliveCharacter(player)
	if not character then
		return
	end

	local status = getStatus(player)
	local nowv = now()
	if nowv < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Dash" })
		return
	end

	local isCarrier = (EggService.GetCarrier() == player)
	local cooldown = isCarrier and Config.DashCooldownCarrying or Config.DashCooldown
	if nowv < status.dashReadyAt then
		rejectClient(player, "OnCooldown", { Ability = "Dash" })
		return
	end

	local cost = isCarrier and Config.DashStaminaCostCarrying or Config.DashStaminaCost
	if not spendStamina(status, cost) then
		rejectClient(player, "NoStamina", { Ability = "Dash" })
		return
	end

	local duration = isCarrier and Config.DashDurationCarrying or Config.DashDuration
	local bonus = isCarrier and Config.DashSpeedBonusCarrying or Config.DashSpeedBonus

	status.dashReadyAt = nowv + cooldown
	status.dashUntil = nowv + duration
	status.dashSpeed = (isCarrier and Config.CarrySpeed or Config.WalkSpeed) + bonus
	status.dashCollisionDone = false

	-- I-frames ONLY when not carrying the egg.
	if not isCarrier and Config.DashIFrames > 0 then
		status.iFramesUntil = nowv + Config.DashIFrames
	end

	broadcastFeedback("DashStart", { Player = player, Carrying = isCarrier })
	recalcSpeed(player)
end

-- Carrier dash collision check (runs in the ticker while dashing): bumping
-- into another player fumbles the egg and nudges the victim.
local function checkDashCollision(player, status)
	local root = getRoot(player)
	if not root then
		return
	end
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			local otherRoot = getRoot(other)
			if otherRoot and getAliveCharacter(other) then
				local offset = otherRoot.Position - root.Position
				if offset.Magnitude <= Config.DashCollisionRadius then
					status.dashCollisionDone = true

					local pushDir = Vector3.new(offset.X, 0, offset.Z)
					if pushDir.Magnitude < 0.001 then
						pushDir = root.CFrame.LookVector
					end

					EggService.Fumble(player, "DashCollision")
					broadcastFeedback("DashFumble", {
						Player = player,
						Victim = other,
						Position = root.Position,
					})
					CombatService.ApplyKnockback(
						other, pushDir,
						Config.DashCollisionKnockback, Config.DashCollisionUpward,
						nil
					)
					return
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Block
---------------------------------------------------------------------------

local function handleBlockStart(player)
	if not getAliveCharacter(player) then
		return
	end
	local status = getStatus(player)
	if now() < status.stunUntil then
		rejectClient(player, "Stunned", { Ability = "Block" })
		return
	end
	if not status.blocking then
		status.blocking = true
		broadcastFeedback("BlockStart", { Player = player })
		recalcSpeed(player)
	end
end

local function handleBlockEnd(player)
	local status = getStatus(player)
	if status.blocking then
		status.blocking = false
		broadcastFeedback("BlockEnd", { Player = player })
		recalcSpeed(player)
	end
end

---------------------------------------------------------------------------
-- Thrown-egg impacts (injected into EggService by Main)
---------------------------------------------------------------------------

function CombatService.HandleEggImpact(player, eggVelocity)
	local direction = Vector3.new(eggVelocity.X, 0, eggVelocity.Z)
	if direction.Magnitude < 0.001 then
		direction = Vector3.new(0, 0, 1)
	end
	local result = CombatService.ApplyKnockback(
		player, direction,
		Config.EggThrowImpactKnockback, Config.EggThrowImpactUpward,
		Config.EggThrowImpactStun
	)
	if Config.DebugVerboseLogging then
		print("[CombatService] Thrown egg hit " .. player.Name .. " (" .. result .. ")")
	end
end

---------------------------------------------------------------------------
-- Player lifecycle
---------------------------------------------------------------------------

local function bindPlayer(player)
	statuses[player] = newStatus()

	player.CharacterAdded:Connect(function()
		-- Fresh life: clear transient states, refill stamina, re-apply speed.
		local status = getStatus(player)
		status.blocking = false
		status.dashUntil = 0
		status.dashCollisionDone = false
		status.iFramesUntil = 0
		status.stunUntil = 0
		status.stamina = Config.StaminaMax
		status.lastSpendTime = -math.huge
		recalcSpeed(player)
	end)

	-- Possession flips (pickup / fumble / throw) change base speed instantly.
	player:GetAttributeChangedSignal("HasEgg"):Connect(function()
		recalcSpeed(player)
	end)

	if player.Character then
		recalcSpeed(player)
	end
end

---------------------------------------------------------------------------
-- Ticker (20 Hz): stamina, dash windows, collisions, speed, attribute publish
---------------------------------------------------------------------------

local function tickOnce()
	local nowv = now()
	local dt = nowv - lastTickTime
	lastTickTime = nowv
	if dt > COMBAT_TICK * 3 then
		dt = COMBAT_TICK * 3 -- clamp: server hitches must not drain/regen in bulk
	end

	for _, player in ipairs(Players:GetPlayers()) do
		local status = getStatus(player)

		-- Stamina: block drains; otherwise regen after a short delay.
		if status.blocking then
			status.stamina = status.stamina - Config.BlockStaminaDrain * dt
			status.lastSpendTime = nowv
			if status.stamina <= 0 then
				status.stamina = 0
				status.blocking = false
				broadcastFeedback("BlockBroken", { Player = player })
				if Config.DebugVerboseLogging then
					print("[CombatService] " .. player.Name .. "'s block broke (out of stamina)")
				end
			end
		elseif nowv - status.lastSpendTime >= Config.StaminaRegenDelay then
			status.stamina = math.min(Config.StaminaMax,
				status.stamina + Config.StaminaRegenPerSecond * dt)
		end

		-- Publish rounded stamina as a replicated attribute for the future HUD
		-- (only writes when the rounded value actually changes).
		local rounded = math.floor(status.stamina + 0.5)
		if rounded ~= status.publishedStamina then
			status.publishedStamina = rounded
			player:SetAttribute("Stamina", rounded)
		end

		-- Carrier dash collision -> fumble (spec: EggDropOnDashCollision).
		if not status.dashCollisionDone
			and nowv < status.dashUntil
			and Config.EggDropOnDashCollision
			and EggService.GetCarrier() == player
		then
			checkDashCollision(player, status)
		end

		-- Single speed authority (handles dash/stun expiry, block, carry).
		recalcSpeed(player)
	end
end

local function startTicker()
	task.spawn(function()
		lastTickTime = now()
		while initialized do
			tickOnce()
			task.wait(COMBAT_TICK)
		end
	end)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function CombatService.Init()
	if initialized then
		return
	end
	initialized = true

	-- Remote handlers: ignore ALL client-sent arguments (server computes
	-- targets/directions itself; nothing from the client is trusted).
	RequestAttack.OnServerEvent:Connect(function(player)
		handleAttack(player)
	end)
	RequestThrow.OnServerEvent:Connect(function(player)
		handleThrow(player)
	end)
	RequestDash.OnServerEvent:Connect(function(player)
		handleDash(player)
	end)
	RequestBlockStart.OnServerEvent:Connect(function(player)
		handleBlockStart(player)
	end)
	RequestBlockEnd.OnServerEvent:Connect(function(player)
		handleBlockEnd(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		bindPlayer(player)
	end
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		statuses[player] = nil
	end)

	startTicker()
	print("[CombatService] Initialized: attack/throw/block/dash + stamina live")
end

-- Read-only snapshots for other systems / the future GUI.
function CombatService.GetStamina(player)
	return getStatus(player).stamina
end

function CombatService.IsBlocking(player)
	return getStatus(player).blocking
end

function CombatService.IsDashing(player)
	return now() < getStatus(player).dashUntil
end

function CombatService.HasIFrames(player)
	return now() < getStatus(player).iFramesUntil
end

function CombatService.IsStunned(player)
	return now() < getStatus(player).stunUntil
end

-- One-line snapshot for the DebugCommand "state".
function CombatService.DebugState()
	local parts = {}
	for player, status in pairs(statuses) do
		if player.Parent then
			local flags = {}
			if status.blocking then table.insert(flags, "blocking") end
			if now() < status.dashUntil then table.insert(flags, "dashing") end
			if now() < status.iFramesUntil then table.insert(flags, "iframes") end
			if now() < status.stunUntil then table.insert(flags, "stunned") end
			table.insert(parts, ("%s[sta=%d %s]"):format(
				player.Name, math.floor(status.stamina + 0.5), table.concat(flags, "+")))
		end
	end
	table.sort(parts)
	return #parts > 0 and table.concat(parts, ", ") or "(no players)"
end

return CombatService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX34">
<Properties>
	<string name="Name">DataService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	DataService (ServerScriptService.DataService)
	=============================================
	STATUS: reserved for later -- intentionally empty.

	Future responsibilities
	-----------------------
	* ProfileStore/SessionLock persistence (wins, losses, MVPs, cosmetics).
	* Load on PlayerAdded, save on PlayerRemoving / BindToClose.

	No DataStore calls are made yet (the game is structure-only at this stage
	and DataStores need a published game + API access enabled).
]]

local DataService = {}

function DataService.Init()
	-- TODO(data): persistence, wired up in a later pass.
	print("[DataService] stub initialized (persistence comes later)")
end

return DataService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX35">
<Properties>
	<string name="Name">EggService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	EggService (ServerScriptService.EggService)
	===========================================
	Server-authoritative egg system: spawn, auto-pickup, carry, hold time,
	fumble, and out-of-arena respawn. Visuals are intentionally simple (a
	glowing sphere); every cosmetic moment fires FeedbackEvent so polish can
	hook in later without touching this module.

	Behaviour summary
	-----------------
	Spawn     : A ball Part is created once at Init() and respawned at
	            Workspace.Arena.EggSpawnPoint on StartRound() / after being
	            lost. (Later, MatchService calls StartRound()/EndRound().)
	Pickup    : Loose egg + character touch (or proximity scan backup) ->
	            that player becomes the carrier. No button. The egg is welded
	            in front of the torso, CanCollide/CanTouch turn off and the
	            Player gets attribute HasEgg = true. NOTE: the carry speed
	            penalty (Config.CarrySpeed) is applied by CombatService, which
	            owns all WalkSpeed math (carry/block/dash/stun modifiers).
	Hold time : The current carrier accrues seconds on the service ticker.
	            HoldTimeUpdated broadcasts every Config.HoldTimeSyncInterval
	            (only while carried, plus one final push after changes).
	Fumble    : EggService.Fumble(target, reason [, popVelocity]) detaches
	            the egg, drops it loose at the carrier's position, clears
	            HasEgg. Also fires automatically on death, respawn and
	            leaving the game.
	Throw     : EggService.ReleaseThrow(player, direction) launches the egg
	            (CombatService validates the request first). For a short
	            window the thrown egg is "hot": it knocks players back and
	            bounces loose instead of being caught; once it slows down it
	            is a normal loose egg again (loose-pickup only for now).
	Loose egg : Unclaimed for Config.EggRespawnDelay while away from the
	            center pad, OR out of bounds (below Config.EggOutOfBoundsY /
	            past Config.EggOutOfBoundsHorizontal) -> respawns at center.
	            Hold time is paused whenever the egg is loose (nobody carries).

	Remote payloads (server -> all clients)
	---------------------------------------
	EggPossessionChanged(newCarrier: Player?, previousCarrier: Player?)
	HoldTimeUpdated(entries)  -- array of {Player = Player, HoldTime = number},
	                          -- sorted by HoldTime descending (leaderboard order)
	FeedbackEvent(kind, data) -- kinds fired here: "EggPickup", "EggFumble",
	                          -- "EggOutOfBounds", "EggRespawn", "EggThrown",
	                          -- "EggImpact"

	Debugging from the Studio command bar while playing (the command bar runs
	in CLIENT context, so use the DebugCommand remote in ReplicatedStorage):
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble")
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble", "PlayerName")
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("respawn_egg")
	  game.ReplicatedStorage.Remotes.DebugCommand:FireServer("state")
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local EggPossessionChanged = Remotes:WaitForChild("EggPossessionChanged")
local HoldTimeUpdated = Remotes:WaitForChild("HoldTimeUpdated")
local FeedbackEvent = Remotes:WaitForChild("FeedbackEvent")

local EggService = {}

---------------------------------------------------------------------------
-- Runtime state (server only)
---------------------------------------------------------------------------

-- Egg state machine.
local STATE_MISSING = "Missing"         -- egg part not created yet
local STATE_LOOSE = "Loose"             -- free in the world, pickable
local STATE_CARRIED = "Carried"         -- welded to the carrier
local STATE_RESPAWNING = "Respawning"   -- lost/out of bounds, hidden, counting down

local TICK_INTERVAL = math.max(0.05, Config.HoldTimeSyncInterval)

local egg = nil                  -- BasePart
local state = STATE_MISSING
local carrier = nil              -- Player?
local carryWeld = nil            -- WeldConstraint?

local holdTimes = {}             -- { [Player] = seconds }
local pickupLockout = {}         -- { [Player] = os.clock() earliest re-grab }
local looseSince = nil           -- os.clock() when the egg became loose
local respawnAt = nil            -- os.clock() when STATE_RESPAWNING completes
local thrower = nil              -- Player? who last threw the egg (self-pickup lockout)
local thrownHotUntil = 0         -- os.clock() deadline for the thrown egg's impact window
local impactHandler = nil        -- function(player, eggVelocity) injected by Main (CombatService)
local broadcastNeeded = false    -- push one more HoldTimeUpdated after a change
local lastTickTime = 0
local initialized = false

---------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------

local function now()
	return os.clock()
end

local function getSpawnPointPosition()
	local arena = Workspace:FindFirstChild("Arena")
	local point = arena and arena:FindFirstChild("EggSpawnPoint")
	if point and point:IsA("BasePart") then
		return point.Position
	end
	warn("[EggService] Workspace.Arena.EggSpawnPoint missing; falling back to world origin")
	return Vector3.new(0, Config.ArenaEggSpawnHeight, 0)
end

local function getTorso(character)
	if not character then
		return nil
	end
	return character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("HumanoidRootPart")
end

local function getAliveHumanoid(character)
	if not character then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		return humanoid
	end
	return nil
end

local function broadcastFeedback(kind, data)
	FeedbackEvent:FireAllClients(kind, data or {})
end

local function broadcastPossession(newCarrier, previousCarrier)
	broadcastNeeded = true
	EggPossessionChanged:FireAllClients(newCarrier, previousCarrier)
end

-- A thrown egg stays "hot" for a short window (and while still fast): it
-- knocks players back instead of being picked up.
local function isEggHot()
	return state == STATE_LOOSE
		and egg ~= nil
		and thrownHotUntil > now()
		and egg.AssemblyLinearVelocity.Magnitude >= Config.EggThrowImpactMinSpeed
end

local function createEgg()
	local part = Instance.new("Part")
	part.Name = "Egg"
	part.Shape = Enum.PartType.Ball
	-- Slightly egg-shaped sphere (taller than wide), sized from Config.
	local diameter = Config.EggRadius * 2
	part.Size = Vector3.new(diameter * 0.9, diameter * 1.15, diameter * 0.9)
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 214, 90)
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	-- Light, slippery and a little bouncy: rolls around the arena nicely.
	part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.3, 0.5)
	part.Anchored = true -- released by applyLooseVisual()/spawnAtCenter()
	part.CanCollide = false
	part.CanTouch = false

	-- "Slightly glowing": a soft point light so the egg reads from anywhere.
	local light = Instance.new("PointLight")
	light.Brightness = 0.8
	light.Range = 10
	light.Color = part.Color
	light.Parent = part

	part.Parent = Workspace
	return part
end

local function applyLooseVisual()
	egg.Transparency = 0
	egg.Anchored = false
	egg.CanCollide = true
	egg.CanTouch = true
end

local function applyHiddenVisual()
	egg.Transparency = 1
	egg.Anchored = true
	egg.CanCollide = false
	egg.CanTouch = false
end

local function applyCarriedVisual()
	egg.Transparency = 0
	egg.CanCollide = false -- never fight the weld or snag on walls
	egg.CanTouch = false   -- only LOOSE eggs are pickable
end

---------------------------------------------------------------------------
-- State transitions
---------------------------------------------------------------------------

-- Forward declaration so spawnAtCenter/scheduleRespawn can reference it.
local scheduleRespawn

local function spawnAtCenter()
	if not egg then
		return
	end
	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end

	local spawnPosition = getSpawnPointPosition()
	applyLooseVisual()
	egg.CFrame = CFrame.new(spawnPosition)
	egg.AssemblyLinearVelocity = Vector3.zero
	egg.AssemblyAngularVelocity = Vector3.zero

	state = STATE_LOOSE
	looseSince = now()
	respawnAt = nil
	thrower = nil
	thrownHotUntil = 0
	pickupLockout = {} -- fresh center drop: everyone may contest it
	broadcastNeeded = true

	broadcastFeedback("EggRespawn", { Position = spawnPosition })
	if Config.DebugVerboseLogging then
		print("[EggService] Egg respawned at center")
	end
end

-- Egg is lost (out of bounds): hide it and respawn at center after
-- Config.EggRespawnDelay seconds.
scheduleRespawn = function()
	if not egg or state == STATE_RESPAWNING then
		return
	end
	state = STATE_RESPAWNING
	respawnAt = now() + Config.EggRespawnDelay
	applyHiddenVisual()
	looseSince = nil
	broadcastNeeded = true

	broadcastFeedback("EggOutOfBounds", { Position = egg.Position })
	if Config.DebugVerboseLogging then
		print("[EggService] Egg out of bounds; respawning in " .. Config.EggRespawnDelay .. "s")
	end
end

---------------------------------------------------------------------------
-- Pickup
---------------------------------------------------------------------------

local function tryPickup(player)
	-- All guards first: no yields inside this function, so two touches in the
	-- same frame can never produce two carriers.
	if state ~= STATE_LOOSE or not egg then
		return false
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end

	local lockUntil = pickupLockout[player]
	if lockUntil and now() < lockUntil then
		return false -- just fumbled/threw it or just got beaned: cannot instantly re-grab
	end

	-- A hot thrown egg is not catchable (yet) -- it impacts instead.
	if isEggHot() and player ~= thrower then
		return false
	end

	local character = player.Character
	local humanoid = getAliveHumanoid(character)
	local torso = getTorso(character)
	if not humanoid or not torso then
		return false
	end

	-- Become the carrier.
	carrier = player
	state = STATE_CARRIED
	looseSince = nil

	applyCarriedVisual()
	egg.AssemblyLinearVelocity = Vector3.zero
	egg.AssemblyAngularVelocity = Vector3.zero
	-- Held out in front of the chest, clearly visible to everyone.
	egg.CFrame = torso.CFrame * CFrame.new(0, Config.EggCarryOffsetUp, -Config.EggCarryOffsetForward)

	carryWeld = Instance.new("WeldConstraint")
	carryWeld.Part0 = torso
	carryWeld.Part1 = egg
	carryWeld.Parent = egg

	-- Carry penalty (Config.CarrySpeed) is applied by CombatService, which
	-- watches the HasEgg attribute and owns all WalkSpeed math.
	player:SetAttribute("HasEgg", true)
	if holdTimes[player] == nil then
		holdTimes[player] = 0
	end

	broadcastPossession(player, nil)
	broadcastFeedback("EggPickup", { Player = player, Position = egg.Position })

	if Config.DebugVerboseLogging then
		print("[EggService] " .. player.Name .. " picked up the egg")
	end
	return true
end

local function onEggTouched(hit)
	if state ~= STATE_LOOSE or not egg then
		return
	end
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player then
		return
	end

	-- Hot thrown egg: knock the struck player back (via the injected
	-- CombatService handler), defuse the egg and bounce it loose.
	if isEggHot() and player ~= thrower then
		local impactVelocity = egg.AssemblyLinearVelocity
		thrownHotUntil = 0 -- defuse: it is a normal loose egg again
		pickupLockout[player] = now() + Config.EggImpactPickupDelay
		egg.AssemblyLinearVelocity = impactVelocity * -0.2 + Vector3.new(0, 5, 0)
		broadcastFeedback("EggImpact", { Player = player, Position = egg.Position })
		if impactHandler then
			impactHandler(player, impactVelocity)
		end
		return
	end

	tryPickup(player)
end

---------------------------------------------------------------------------
-- Fumble / drop
---------------------------------------------------------------------------

local function doFumble(player, reason, popVelocity)
	if carrier ~= player or not egg then
		return false -- idempotent: Died + CharacterRemoving can both fire
	end
	local previousCarrier = carrier
	carrier = nil

	previousCarrier:SetAttribute("HasEgg", false)
	-- WalkSpeed restoration happens in CombatService (HasEgg attribute watch).

	-- Detach from the torso.
	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end
	thrower = nil
	thrownHotUntil = 0

	-- Place the egg loose at the carrier's position (slightly forward+up so
	-- it does not spawn inside the character), clamped inside the arena so a
	-- fumble against a wall cannot push it out of bounds.
	local root = previousCarrier.Character
		and previousCarrier.Character:FindFirstChild("HumanoidRootPart")
	local dropPosition
	if root then
		dropPosition = root.CFrame:PointToWorldSpace(Vector3.new(0, 1, -2))
	else
		dropPosition = egg.Position + Vector3.new(0, 1, 0)
	end
	local halfBounds = Config.ArenaPlaySize / 2 - Config.EggRadius - 0.5
	dropPosition = Vector3.new(
		math.clamp(dropPosition.X, -halfBounds, halfBounds),
		dropPosition.Y,
		math.clamp(dropPosition.Z, -halfBounds, halfBounds)
	)

	applyLooseVisual()
	egg.CFrame = CFrame.new(dropPosition)
	egg.AssemblyLinearVelocity = popVelocity or Vector3.new(0, Config.EggFumblePop, 0)
	egg.AssemblyAngularVelocity = Vector3.zero

	state = STATE_LOOSE
	looseSince = now()

	-- The dropper cannot instantly re-grab their own fumble.
	pickupLockout[previousCarrier] = now() + Config.ThrowSelfPickupDelay

	broadcastPossession(nil, previousCarrier)
	broadcastFeedback("EggFumble", {
		Player = previousCarrier,
		Reason = reason or "Unknown",
		Position = egg.Position,
	})

	if Config.DebugVerboseLogging then
		print("[EggService] " .. previousCarrier.Name .. " fumbled the egg (" .. tostring(reason) .. ")")
	end
	return true
end

---------------------------------------------------------------------------
-- Player lifecycle (death / respawn / leaving drops the egg)
---------------------------------------------------------------------------

local function bindCharacter(player, character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	if humanoid then
		-- Base WalkSpeed on (re)spawn is applied by CombatService, which owns
		-- all speed modifiers (carry / block / dash / stun).
		humanoid.Died:Connect(function()
			doFumble(player, "Died")
		end)
	end
end

local function bindPlayer(player)
	player:SetAttribute("HasEgg", false)

	player.CharacterAdded:Connect(function(character)
		bindCharacter(player, character)
	end)

	-- Covers deaths, manual respawns and teleports.
	player.CharacterRemoving:Connect(function()
		doFumble(player, "CharacterRemoved")
	end)
end

local function onPlayerRemoving(player)
	doFumble(player, "Left")
	holdTimes[player] = nil
	pickupLockout[player] = nil
end

---------------------------------------------------------------------------
-- Ticker: hold time, world checks, proximity pickup, broadcasts (10 Hz)
---------------------------------------------------------------------------

local function tickOnce()
	local currentTime = now()
	local dt = currentTime - lastTickTime
	lastTickTime = currentTime
	-- Clamp so a server hitch cannot award a burst of hold time.
	if dt > TICK_INTERVAL * 3 then
		dt = TICK_INTERVAL * 3
	end

	-- 1) Hold time accrues for the carrier only (pauses automatically while
	--    the egg is loose/respawning -- there is no carrier then).
	if carrier and state == STATE_CARRIED then
		holdTimes[carrier] = (holdTimes[carrier] or 0) + dt
	end

	if egg then
		if state == STATE_LOOSE then
			local position = egg.Position

			-- 2a) Fell out of the arena?
			if position.Y < Config.EggOutOfBoundsY
				or math.abs(position.X) > Config.EggOutOfBoundsHorizontal
				or math.abs(position.Z) > Config.EggOutOfBoundsHorizontal
			then
				scheduleRespawn()
			elseif looseSince and (currentTime - looseSince) >= Config.EggRespawnDelay then
				-- 2b) Unclaimed timeout: reset to center, unless it is already
				-- resting on the center pad (no annoying idle pop-loop there).
				local centerOffset = Vector3.new(position.X, 0, position.Z).Magnitude
				if centerOffset > Config.EggLooseResetRadius then
					spawnAtCenter()
				else
					looseSince = currentTime -- parked at center: restart the clock
				end
			end
		elseif state == STATE_RESPAWNING then
			-- 2c) Respawn countdown finished?
			if respawnAt and currentTime >= respawnAt then
				spawnAtCenter()
			end
		end

		-- 3) Proximity pickup scan: cheap backup to Touched so grabs also
		--    register reliably at low framerates / on mobile.
		--    TODO(polish): add line-of-sight check so it cannot grab through walls.
		if state == STATE_LOOSE then
			for _, player in ipairs(Players:GetPlayers()) do
				local humanoid = getAliveHumanoid(player.Character)
				if humanoid then
					local root = player.Character:FindFirstChild("HumanoidRootPart")
					if root
						and (root.Position - egg.Position).Magnitude <= Config.EggProximityPickupRadius
					then
						if tryPickup(player) then
							break -- one pickup per tick maximum
						end
					end
				end
			end
		end
	end

	-- 4) Broadcast hold times: continuously while carried (live leaderboard),
	--    plus one final push after any possession change.
	if state == STATE_CARRIED or broadcastNeeded then
		local entries = {}
		for player, time in pairs(holdTimes) do
			if player.Parent then
				table.insert(entries, { Player = player, HoldTime = time })
			else
				holdTimes[player] = nil -- scrub players who slipped out
			end
		end
		table.sort(entries, function(a, b)
			return a.HoldTime > b.HoldTime
		end)
		HoldTimeUpdated:FireAllClients(entries)
		broadcastNeeded = false
	end
end

local function startTicker()
	task.spawn(function()
		lastTickTime = now()
		while initialized do
			tickOnce()
			task.wait(TICK_INTERVAL)
		end
	end)
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function EggService.Init()
	if initialized then
		return
	end
	initialized = true

	egg = createEgg()
	egg.Touched:Connect(onEggTouched)

	for _, player in ipairs(Players:GetPlayers()) do
		bindPlayer(player)
		if player.Character then
			bindCharacter(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	-- No MatchService yet: spawn the egg immediately so the arena is live.
	-- Once MatchService exists it will call StartRound()/EndRound() instead.
	spawnAtCenter()
	startTicker()

	print("[EggService] Initialized: egg spawned at center (auto-pickup live)")
end

-- Called by MatchService (later) at the start of every round.
function EggService.StartRound()
	if carrier then
		doFumble(carrier, "RoundStart")
	end
	spawnAtCenter()
end

-- Called by MatchService (later) at the end of every round.
function EggService.EndRound()
	if carrier then
		doFumble(carrier, "RoundEnd")
	end
end

-- Current carrier (Player?) -- the hook ScoringService/GUI read.
function EggService.GetCarrier()
	return carrier
end

-- The egg Part itself (may be hidden while respawning).
function EggService.GetEgg()
	return egg
end

-- Internal state string: "Loose" | "Carried" | "Respawning" | "Missing".
function EggService.GetState()
	return state
end

-- Accumulated hold seconds for one player this match.
function EggService.GetHoldTime(player)
	return holdTimes[player] or 0
end

-- Shallow copy of { [Player] = seconds } for ScoringService snapshots.
function EggService.GetHoldTimes()
	local copy = {}
	for player, time in pairs(holdTimes) do
		if player.Parent then
			copy[player] = time
		end
	end
	return copy
end

-- Full-match reset (new match, not new round -- per-round bookkeeping is
-- ScoringService's job).
function EggService.ResetHoldTimes()
	holdTimes = {}
	broadcastNeeded = true
end

--[[
	Drop the egg.

	EggService.Fumble(target?, reason?, popVelocity?)
	  target       : Player | player name | nil (nil = whoever carries it now)
	  reason       : string for logs/feedback ("Attacked", "DashCollision", ...)
	  popVelocity  : optional Vector3 launch velocity (CombatService will pass
	                 the knock-loose pop when attacks land)

	Also callable as EggService:Fumble(target, reason) -- an accidental `self`
	first argument is detected and shifted out.
]]
function EggService.Fumble(target, reason, popVelocity)
	if target == EggService then -- colon-call: shift the implicit self away
		target, reason, popVelocity = reason, popVelocity, nil
	end

	if target == nil then
		target = carrier
	end
	if typeof(target) == "string" then
		target = Players:FindFirstChild(target)
	end
	if typeof(target) ~= "Instance" or not target:IsA("Player") then
		warn("[EggService] Fumble: could not resolve target player (" .. tostring(target) .. ")")
		return false
	end
	if not carrier then
		warn("[EggService] Fumble: nobody is carrying the egg")
		return false
	end
	if target ~= carrier then
		warn("[EggService] Fumble: " .. target.Name .. " is not the carrier ("
			.. carrier.Name .. " is)")
		return false
	end
	if popVelocity ~= nil and typeof(popVelocity) ~= "Vector3" then
		warn("[EggService] Fumble: popVelocity must be a Vector3; ignoring it")
		popVelocity = nil
	end

	return doFumble(carrier, reason or "Manual", popVelocity)
end

-- Force the egg back to center immediately (debug / round flow).
function EggService.RespawnEggNow()
	if not egg then
		return
	end
	if carrier then
		doFumble(carrier, "ForcedRespawn")
	end
	spawnAtCenter()
end

--[[
	Throw the egg. Called by CombatService AFTER it has validated the request
	(caller must be the carrier, alive, not stunned).

	EggService.ReleaseThrow(player, direction)
	  player    : the current carrier
	  direction : Vector3 launch direction (unit-ized internally); the lob comes
	              from Config.ThrowUpwardBias added on top of Config.ThrowSpeed

	Possession ends immediately (hold time stops). The egg is "hot" for
	Config.EggThrowDangerTime / until it slows below Config.EggThrowImpactMinSpeed:
	hitting a player knocks them back and bounces the egg loose instead of being
	caught. The thrower is locked out of re-grabbing (ThrowSelfPickupDelay).
]]
function EggService.ReleaseThrow(player, direction)
	if carrier ~= player or not egg then
		return false
	end
	if typeof(direction) ~= "Vector3" or direction.Magnitude < 0.001 then
		direction = Vector3.new(0, 0, -1)
	end
	direction = direction.Unit

	local previousCarrier = carrier
	carrier = nil
	previousCarrier:SetAttribute("HasEgg", false)

	if carryWeld then
		carryWeld:Destroy()
		carryWeld = nil
	end

	-- The egg is already welded in front of the chest; launch from there.
	applyLooseVisual()
	egg.AssemblyAngularVelocity = Vector3.zero
	egg.AssemblyLinearVelocity = direction * Config.ThrowSpeed
		+ Vector3.new(0, Config.ThrowUpwardBias, 0)

	state = STATE_LOOSE
	looseSince = now()
	thrower = previousCarrier
	thrownHotUntil = now() + Config.EggThrowDangerTime
	pickupLockout[previousCarrier] = now() + Config.ThrowSelfPickupDelay
	broadcastNeeded = true

	broadcastPossession(nil, previousCarrier)
	broadcastFeedback("EggThrown", {
		Player = previousCarrier,
		Direction = direction,
		Position = egg.Position,
	})

	if Config.DebugVerboseLogging then
		print("[EggService] " .. previousCarrier.Name .. " threw the egg")
	end
	return true
end

-- True while a thrown egg would knock players back instead of being caught.
function EggService.IsEggHot()
	return isEggHot()
end

-- Who last threw the egg (Player?) -- used for throw-impact exemptions.
function EggService.GetThrower()
	return thrower
end

-- Main injects CombatService.HandleEggImpact here. Dependency injection keeps
-- the require graph one-directional (CombatService -> EggService only).
function EggService.SetImpactHandler(handler)
	impactHandler = (typeof(handler) == "function") and handler or nil
end

-- One-line snapshot for the console / DebugCommands "state".
function EggService.DebugState()
	local parts = {}
	for player, time in pairs(holdTimes) do
		if player.Parent then
			table.insert(parts, player.Name .. "=" .. string.format("%.1f", time) .. "s")
		end
	end
	table.sort(parts)
	local carrierName = carrier and carrier.Name or "nobody"
	local timesText = #parts > 0 and table.concat(parts, ", ") or "(none)"
	return "state=" .. state .. " | carrier=" .. carrierName .. " | holdTimes: " .. timesText
end

return EggService
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX36">
<Properties>
	<bool name="Disabled">false</bool>
	<string name="Name">Main</string>
	<ProtectedString name="Source"><![CDATA[--[[
	Main (ServerScriptService.Main)
	===============================
	Server bootstrap. Runs once when the server starts.

	  1. Verifies the static Remotes tree exists (ReplicatedStorage.Remotes).
	  2. Initializes the service modules. As of Task 3, EggService AND
	     CombatService are LIVE (pickup/carry/hold time/fumble/respawn +
	     attack/throw/block/dash/stamina). Match, Scoring and Data remain
	     documented stubs.
	  3. Wires CombatService into EggService as the thrown-egg impact handler
	     (dependency injection -- keeps the require graph one-directional).
	  4. Creates the debug bridges (STUDIO ONLY, gated by
	     Config.DebugAllowCommandBar):

	     a) ReplicatedStorage.Remotes.DebugCommand (RemoteEvent) -- use this
	        from the Studio command bar while PLAYING. The command bar runs in
	        CLIENT context, which cannot see ServerScriptService children:

	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble")
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("fumble", "PlayerName")
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("respawn_egg")
	          game.ReplicatedStorage.Remotes.DebugCommand:FireServer("state")

	     b) ServerScriptService.DebugCommands (BindableEvent) -- same commands
	        from server-side code / "Run" mode:

	          game.ServerScriptService.DebugCommands:Fire("fumble")
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

-- 1) Verify remotes (static instances declared in default.project.json)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local EXPECTED_REMOTES = {
	-- client -> server (input requests; server validates everything)
	"RequestAttack",
	"RequestThrow",
	"RequestDash",
	"RequestBlockStart",
	"RequestBlockEnd",
	-- server -> client (replicated state + polish hooks)
	"EggPossessionChanged",
	"HoldTimeUpdated",
	"MatchStateChanged",
	"RoundEnded",
	"MatchEnded",
	"FeedbackEvent",
	-- studio-only debug bridge (see below)
	"DebugCommand",
}

for _, name in EXPECTED_REMOTES do
	if not Remotes:WaitForChild(name, 10) then
		warn("[Main] Missing remote: " .. name)
	end
end

-- 2) Require + initialize services
local MatchService = require(ServerScriptService:WaitForChild("MatchService"))
local EggService = require(ServerScriptService:WaitForChild("EggService"))
local CombatService = require(ServerScriptService:WaitForChild("CombatService"))
local ScoringService = require(ServerScriptService:WaitForChild("ScoringService"))
local DataService = require(ServerScriptService:WaitForChild("DataService"))

for _, service in ipairs({ MatchService, EggService, CombatService, ScoringService, DataService }) do
	if type(service.Init) == "function" then
		service.Init()
	end
end

-- 3) Cross-service wiring: EggService reports thrown-egg impacts,
--    CombatService applies the knockback. Injected here so neither module
--    has to require the other in both directions.
EggService.SetImpactHandler(function(player, eggVelocity)
	CombatService.HandleEggImpact(player, eggVelocity)
end)

-- 4) Debug bridges (Studio only)
local function runDebugCommand(command, argument)
	if typeof(command) ~= "string" then
		warn('[Debug] usage: "fumble" | "respawn_egg" | "state" [, playerName]')
		return
	end
	command = command:lower()
	if command == "fumble" then
		EggService.Fumble(argument, "DebugCommand")
	elseif command == "respawn_egg" then
		EggService.RespawnEggNow()
	elseif command == "state" then
		print("[Debug] egg   : " .. EggService.DebugState())
		print("[Debug] combat: " .. CombatService.DebugState())
	else
		warn('[Debug] unknown command "' .. command .. '" (try: fumble, respawn_egg, state)')
	end
end

-- a) RemoteEvent path -- reachable from the command bar during Play because
--    ReplicatedStorage replicates to the client. Hard-gated to Studio.
local debugRemote = Remotes:FindFirstChild("DebugCommand")
if debugRemote and debugRemote:IsA("RemoteEvent") then
	debugRemote.OnServerEvent:Connect(function(player, command, argument)
		if not (RunService:IsStudio() and Config.DebugAllowCommandBar) then
			return -- never trust debug commands outside Studio
		end
		runDebugCommand(command, argument)
	end)
else
	warn("[Main] Remotes.DebugCommand missing -- command-bar debugging unavailable")
end

-- b) BindableEvent path -- for server-side automation and "Run" mode.
local debugCommands = Instance.new("BindableEvent")
debugCommands.Name = "DebugCommands"
debugCommands.Parent = ServerScriptService

debugCommands.Event:Connect(function(command, argument)
	runDebugCommand(command, argument)
end)

print("[Clutch the Egg] Server bootstrap complete -- egg + combat live (Task 3); match/scoring are stubs")
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX37">
<Properties>
	<string name="Name">MatchService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	MatchService (ServerScriptService.MatchService)
	===============================================
	STATUS: stub -- gameplay not implemented yet.

	Future responsibilities
	-----------------------
	* Own the match state machine:
	    Lobby -> Countdown -> Round (Config.RoundLength seconds)
	          -> RoundEnd -> (next round | MatchEnd) -> Lobby
	* Best of Config.RoundsPerMatch rounds; first to Config.RoundsToWinMatch
	  round wins takes the match.
	* Broadcast MatchStateChanged / RoundEnded / MatchEnded to all clients.
	* Coordinate the other services: call EggService.StartRound() /
	  EggService.EndRound() (and EggService.ResetHoldTimes() on a new match),
	  freeze combat at round end, ask ScoringService for the round winner
	  (most total hold time) and the match MVP (most hold time across rounds).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local MatchService = {}

function MatchService.Init()
	-- TODO(match): build the state machine described above.
	if Config.DebugVerboseLogging then
		print("[MatchService] stub initialized")
	end
end

return MatchService
]]></ProtectedString>
</Properties>
</Item>

<Item class="ServerScriptService" referent="RBX31">
<Properties>
	<string name="Name">ServerScriptService</string>
</Properties>
<Item class="ModuleScript" referent="RBX32">
<Properties>
	<string name="Name">CombatService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	CombatService (ServerScriptService.CombatService)
	=================================================
	STATUS: stub -- gameplay not implemented yet.

	Future responsibilities
	-----------------------
	* Validate RequestAttack on the server: attacker must NOT be holding the
	  egg ("HANDS FULL" feedback otherwise), plus cooldown / range
	  (Config.AttackRange) / stamina checks. Apply knockback
	  (Config.AttackKnockback), reduced by the victim's block
	  (Config.BlockKnockbackReduction) and negated by dash i-frames.
	  Hitting the carrier knocks the egg loose (hand off to EggService).
	* Validate RequestThrow: only while holding the egg; lob it with
	  Config.ThrowSpeed + Config.ThrowUpwardBias (hand off to EggService).
	* Validate RequestDash: cooldown / stamina; carrying players get the
	  shorter no-i-frame dash, and dashing into a player drops the egg.
	* Track block state (RequestBlockStart / RequestBlockEnd): speed
	  multiplier, stamina drain, knockback reduction. Blocking while carrying
	  still accrues hold time (that rule lives in EggService/ScoringService).
	* Manage the stamina pool (spend + regen) for every player.
	* Fire FeedbackEvent for every hit / dash / block / "HANDS FULL" deny so
	  VFX, SFX and GUI polish can hook in later.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local CombatService = {}

function CombatService.Init()
	-- TODO(combat): remote handlers, validation, knockback, stamina.
	if Config.DebugVerboseLogging then
		print("[CombatService] stub initialized")
	end
end

return CombatService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX33">
<Properties>
	<string name="Name">DataService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	DataService (ServerScriptService.DataService)
	=============================================
	STATUS: reserved for later -- intentionally empty.

	Future responsibilities
	-----------------------
	* ProfileStore/SessionLock persistence (wins, losses, MVPs, cosmetics).
	* Load on PlayerAdded, save on PlayerRemoving / BindToClose.

	No DataStore calls are made yet (the game is structure-only at this stage
	and DataStores need a published game + API access enabled).
]]

local DataService = {}

function DataService.Init()
	-- TODO(data): persistence, wired up in a later pass.
	print("[DataService] stub initialized (persistence comes later)")
end

return DataService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX34">
<Properties>
	<string name="Name">EggService</string>
	<ProtectedString name="Source"><![CDATA[--[[
	EggService (ServerScriptService.EggService)
	===========================================
	STATUS: stub -- gameplay not implemented yet.

	Future responsibilities
	-----------------------
	* Create and own the egg Part on the server (simple Part for now; visuals
	  are swapped in later via FeedbackEvent hooks).
	* Auto-pickup on touch (no button): Touched -> server validates -> egg
	  becomes carried by that player.
	* Track possession and accrue HOLD TIME (seconds) for the carrier.
	* Handle throws (lob at Config.ThrowSpeed), knock-loose pops when the
	  carrier is attacked, and the dash-collision drop rule
	  (Config.EggDropOnDashCollision).
	* Egg leaves the arena -> hold time pauses (Config.HoldTimePausesWhenLoose)
	  and the egg respawns at Workspace.Arena.EggSpawnPoint after
	  Config.EggRespawnDelay seconds.
	* Fire EggPossessionChanged / HoldTimeUpdated / FeedbackEvent.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Config"))

local EggService = {}

function EggService.Init()
	-- TODO(egg): spawn logic, possession state, hold-time accrual.
	if Config.DebugVerboseLogging then
		print("[EggService] stub initialized")
	end
end

return EggService
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX35">
<Properties>
	<bool name="Disabled">false</bool>
	<string name="Name">Main</string>
	<ProtectedString name="Source"><![CDATA[--[[
	Main (ServerScriptService.Main)
	===============================
	Server bootstrap. Runs once when the server starts.

	Right now it only:
	  1. Verifies the static Remotes tree exists (ReplicatedStorage.Remotes).
	  2. Initializes the service stubs, which validates every require-path at
	     boot instead of at first gameplay use.

	Gameplay is NOT implemented yet -- this prompt delivers structure, arena
	and config only.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

-- 1) Verify remotes (static instances declared in default.project.json)
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local EXPECTED_REMOTES = {
	-- client -> server (input requests; server validates everything)
	"RequestAttack",
	"RequestThrow",
	"RequestDash",
	"RequestBlockStart",
	"RequestBlockEnd",
	-- server -> client (replicated state + polish hooks)
	"EggPossessionChanged",
	"HoldTimeUpdated",
	"MatchStateChanged",
	"RoundEnded",
	"MatchEnded",
	"FeedbackEvent",
}

for _, name in EXPECTED_REMOTES do
	if not Remotes:WaitForChild(name, 10) then
		warn("[Main] Missing remote: " .. name)
	end
end

-- 2) Initialize service modules (stubs for now)
local SERVICES = {
	"MatchService",
	"EggService",
	"CombatService",
	"ScoringService",
	"DataService",
}

for _, name in SERVICES do
	local service = require(ServerScriptService:WaitForChild(name))
	if type(service.Init) == "function" then
		service.Init()
	end
end

print("[Clutch the Egg] Server bootstrap complete -- structure + arena only, gameplay not built yet")
]]></ProtectedString>
</Properties>
